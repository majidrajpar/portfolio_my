---
import '../styles/global.css';
import { ViewTransitions } from 'astro:transitions';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = 'Free practitioner workbench and knowledge library for internal audit, continuous controls monitoring (CCM), and forensic telemetry by Majid Mumtaz.',
} = Astro.props;

const base = import.meta.env.BASE_URL;
const currentPath = Astro.url.pathname;
const isAbout = currentPath.includes('/dashboard/about');
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="author" content="Majid Mumtaz" />
  <meta name="description" content={description} />
  <title>{title}</title>
  <ViewTransitions />
</head>
<body class="min-h-screen !bg-[#f8fafc] !bg-none !text-slate-900 antialiased selection:bg-slate-900 selection:text-white">
  <header class="sticky top-0 z-40 border-b border-slate-200 bg-white/95 backdrop-blur-sm">
    <div class="mx-auto flex max-w-7xl items-center justify-between px-4 py-3.5 sm:px-6 lg:px-8">
      <div class="flex items-center gap-3">
        <a href={`${base}dashboard/`} class="flex items-center gap-2.5 text-sm font-semibold tracking-tight text-slate-900 hover:text-slate-600 transition-colors">
          <span class="inline-flex h-2 w-2 rounded-full bg-slate-900"></span>
          <span>Practitioner Library</span>
        </a>
        <span class="hidden text-xs text-slate-300 sm:inline">/</span>
        <span class="hidden text-xs text-slate-500 sm:inline">Open Audit &amp; Telemetry Workbench</span>
      </div>

      <nav class="flex items-center gap-6 text-sm">
        <a
          href={`${base}dashboard/`}
          class={`transition-colors ${!isAbout ? 'text-slate-900 font-semibold' : 'text-slate-500 hover:text-slate-900'}`}
        >
          Library
        </a>
        <a
          href={`${base}dashboard/about/`}
          class={`transition-colors ${isAbout ? 'text-slate-900 font-semibold' : 'text-slate-500 hover:text-slate-900'}`}
        >
          About
        </a>
        <a
          href="https://theauditsignal.com"
          target="_blank"
          rel="noopener noreferrer"
          class="rounded-md border border-slate-200 bg-slate-50 px-3 py-1.5 text-xs font-medium text-slate-700 hover:border-slate-300 hover:bg-slate-100 hover:text-slate-900 transition-colors"
        >
          theauditsignal.com ↗
        </a>
      </nav>
    </div>
  </header>

  <main class="mx-auto max-w-7xl px-4 py-10 sm:px-6 lg:px-8">
    <slot />
  </main>

  <footer class="mt-20 border-t border-slate-200 bg-white py-6 text-center text-xs text-slate-500">
    <div class="mx-auto max-w-7xl px-4 flex flex-col sm:flex-row items-center justify-between gap-2">
      <span>Majid Mumtaz · Open Practitioner Library</span>
      <a href="https://theauditsignal.com" target="_blank" rel="noopener noreferrer" class="text-slate-600 hover:text-slate-900 transition-colors">
        theauditsignal.com
      </a>
    </div>
  </footer>
</body>
</html>
