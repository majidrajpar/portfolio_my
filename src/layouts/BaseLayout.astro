---
import '../styles/global.css';
import Navbar from '../components/Navbar';
import { ViewTransitions } from 'astro:transitions';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  robots?: string;
}

const {
  title,
  description = 'Strategic Audit Advisory with 20+ years finding the operational and governance gaps businesses have not priced yet. Fraud detection, board-grade assurance, and audit functions that actually protect capital.',
  ogImage,
  robots,
} = Astro.props;

const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const baseUrl = import.meta.env.BASE_URL;
const siteOrigin = Astro.site ? Astro.site.origin : 'https://majidrajpar.github.io';
const siteRootUrl = new URL(baseUrl, siteOrigin).toString();
const resolvedOgImage = ogImage
  ? (ogImage.startsWith('http') ? ogImage : new URL(ogImage, siteOrigin).toString())
  : new URL(`${baseUrl}images/majid-profile.jpg`, siteOrigin).toString();
const schemaImage = new URL(`${baseUrl}images/projects/finance-dashboard/executive-summary.png`, siteOrigin).toString();
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="author" content="Majid Mumtaz" />
  <meta name="referrer" content="strict-origin-when-cross-origin" />
  <meta http-equiv="Content-Security-Policy" content="default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self' https://formspree.io https://www.google-analytics.com https://*.google-analytics.com https://*.analytics.google.com https://www.googletagmanager.com https://cdn.jsdelivr.net; object-src 'none'; base-uri 'self'; form-action 'self' https://formspree.io;" />
  <meta name="description" content={description} />
  {robots && <meta name="robots" content={robots} />}

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=Inter:wght@400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet" />
  <link rel="canonical" href={canonicalUrl.toString()} />

  <!-- Open Graph -->
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={resolvedOgImage} />
  <meta property="og:site_name" content="Majid Mumtaz | Strategic Audit Advisory" />

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={resolvedOgImage} />

  <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />
  <title>{title}</title>

  <!-- Structured data: Person and ProfessionalService schema -->
  <script type="application/ld+json" is:inline set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "Person",
        "@id": `${siteRootUrl}#person`,
        "name": "Majid Mumtaz",
        "givenName": "Majid",
        "familyName": "Mumtaz",
        "jobTitle": "Chief Audit Executive (CAE) & Director of Internal Audit & GRC",
        "url": siteRootUrl,
        "image": schemaImage,
        "email": "mailto:majidrajpar@gmail.com",
        "description": "Chief Audit Executive and Director of Internal Audit & GRC with 21 years across Big 4 and GCC industry leadership. CIA, ACA, FCCA. Published in ACCA Accounting & Business, IIA, GRC Report, Consultancy ME, and Corporate Compliance Insights.",
        "knowsAbout": [
          "Internal Audit",
          "Fraud Detection",
          "Forensic Analytics",
          "IPO Readiness",
          "Board Governance",
          "COSO ERM",
          "ICOFR",
          "Risk Management",
          "Continuous Controls Monitoring (CCM)",
          "Tadawul Nomu Corporate Governance",
          "UAE SCA Regulatory Compliance",
          "Global Internal Audit Standards (GIAS 2024)"
        ],
        "hasCredential": ["CIA", "ACA", "FCCA", "GRCP", "GRCA", "COSO ERM Certified"],
        "address": {
          "@type": "PostalAddress",
          "addressLocality": "Dubai",
          "addressCountry": "AE"
        },
        "sameAs": [
          "https://www.linkedin.com/in/majid-m-4b097118/",
          "https://www.youtube.com/@AuditBitz",
          "https://www.linkedin.com/newsletters/the-audit-signal-7339153291630510080/",
          "https://app.gocatalant.com/c/_/profile/kd6vrg/verify/"
        ]
      },
      {
        "@type": "ProfessionalService",
        "@id": `${siteRootUrl}#service`,
        "name": "Majid Mumtaz Strategic Audit & GRC Advisory",
        "url": siteRootUrl,
        "image": schemaImage,
        "description": "Board-grade internal audit advisory, fractional Chief Audit Executive (CAE) services, continuous controls monitoring (CCM), and pre-IPO ICFR assurance across the UAE and GCC.",
        "address": {
          "@type": "PostalAddress",
          "addressLocality": "Dubai",
          "addressCountry": "AE"
        },
        "areaServed": [
          { "@type": "Country", "name": "United Arab Emirates" },
          { "@type": "Country", "name": "Saudi Arabia" },
          { "@type": "AdministrativeArea", "name": "Gulf Cooperation Council (GCC)" }
        ],
        "founder": { "@id": `${siteRootUrl}#person` },
        "priceRange": "$$$$"
      }
    ]
  })} />

  <ViewTransitions />

  <!-- Google Analytics GA4 (disabled on localhost) -->
  <script is:inline>
    (function() {
      var h = window.location.hostname;
      if (h === 'localhost' || h === '127.0.0.1' || h === '::1') return;
      var s = document.createElement('script');
      s.async = true;
      s.src = 'https://www.googletagmanager.com/gtag/js?id=G-9GCK25N9C5';
      document.head.appendChild(s);
      window.dataLayer = window.dataLayer || [];
      window.gtag = function(){dataLayer.push(arguments);};
      gtag('js', new Date());
      gtag('config', 'G-9GCK25N9C5');
    })();
  </script>
</head>
<body class="min-h-screen bg-[var(--paper)] text-stone-900 antialiased">

  <!-- Skip to main content (keyboard/screen-reader users) -->
  <a href="#main-content" class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[200] focus:px-4 focus:py-2 focus:bg-white focus:text-slate-900 focus:font-semibold focus:text-xs focus:border focus:border-slate-900 focus:outline-none">
    Skip to main content
  </a>

  <!-- Navbar: React island for scroll-aware behaviour -->
  <Navbar client:load initialPath={Astro.url.pathname} />

  <!-- Main Content -->
  <main id="main-content">
    <slot />
  </main>

  <!-- Footer -->
  <footer class="border-t border-slate-200 bg-white py-12">
    <div class="mx-auto max-w-6xl px-8">
      <div class="grid grid-cols-1 gap-10 md:grid-cols-3">
        <div>
          <p class="text-xs font-medium uppercase tracking-widest text-slate-500">Majid Mumtaz</p>
          <p class="mt-3 max-w-sm text-sm leading-6 text-slate-600">Continuous controls monitoring, internal audit, and board assurance.</p>
          <ul class="mt-4 space-y-2 text-sm font-semibold text-slate-900">
            <li><a href="mailto:majidrajpar@gmail.com" class="underline underline-offset-4">majidrajpar@gmail.com</a></li>
            <li>Dubai</li>
            <li><a href={`${baseUrl}cv/Majid_Mumtaz_Internal_Audit_Director.pdf`} download class="underline underline-offset-4">CV</a></li>
          </ul>
        </div>
        <div>
          <p class="text-xs font-medium uppercase tracking-widest text-slate-500">Overview</p>
          <ul class="mt-3 space-y-2">
            {[
              { label: 'Case Studies', href: `${baseUrl}projects/` },
              { label: 'Tools', href: `${baseUrl}tools/` },
              { label: 'Contact', href: `${baseUrl}contact/` },
            ].map(link => (
              <li><a href={link.href} class="text-sm font-semibold text-slate-900 underline underline-offset-4">{link.label}</a></li>
            ))}
          </ul>
        </div>
        <div>
          <p class="text-xs font-medium uppercase tracking-widest text-slate-500">Library</p>
          <ul class="mt-3 space-y-2">
            {[
              { label: 'Field notes', href: `${baseUrl}trench-series/` },
              { label: 'Resource library', href: `${baseUrl}resources/` },
              { label: 'Builds', href: `${baseUrl}software/` },
            ].map(link => (
              <li><a href={link.href} class="text-sm font-semibold text-slate-900 underline underline-offset-4">{link.label}</a></li>
            ))}
          </ul>
        </div>
      </div>
      <div class="mt-10 flex flex-col gap-3 border-t border-slate-200 pt-6 sm:flex-row sm:items-center sm:justify-between">
        <p class="text-xs text-slate-500">
          &copy; {new Date().getFullYear()} Majid Mumtaz CIA, ACA, FCCA.
        </p>
        <a href={`${baseUrl}terms/`} class="text-xs font-semibold text-slate-900 underline underline-offset-4">
          Terms
        </a>
      </div>
    </div>
  </footer>

  <!-- IntersectionObserver for data-reveal animations -->
  <!-- astro:page-load fires on initial load AND after every View Transitions navigation -->
  <script is:inline data-base={import.meta.env.BASE_URL}>
    window.__recallBase = (document.currentScript && document.currentScript.getAttribute('data-base')) || '/';
    if (!window.__recallViewsBound) {
      window.__recallViewsBound = true;
      document.addEventListener('astro:page-load', function() {
        var base = window.__recallBase || '/';
        var path = window.location.pathname || '';
        if (base !== '/') {
          if (base.charAt(0) !== '/') base = '/' + base;
          if (base.charAt(base.length - 1) !== '/') base += '/';
          if (path.indexOf(base) === 0) path = path.slice(base.length);
        }
        if (path.charAt(0) === '/') path = path.slice(1);
        var name = '';
        var slug = '';
        var caseMatch = /^projects\/([^/]+)\/$/.exec(path);
        if (caseMatch && caseMatch[1] && caseMatch[1] !== 'category') {
          name = 'case_view';
          slug = caseMatch[1];
        } else {
          var toolMatch = /^tools\/([^/]+)\/$/.exec(path);
          if (toolMatch && toolMatch[1]) {
            name = 'tool_view';
            slug = toolMatch[1];
          }
        }
        if (!name || typeof gtag !== 'function') return;
        gtag('event', name, { slug: slug });
      });
    }
    if (!window.__revealObserverBound) {
      window.__revealObserverBound = true;
      document.addEventListener('astro:page-load', function() {
        const io = new IntersectionObserver(
          function(entries) {
            entries.forEach(function(entry) {
              if (entry.isIntersecting) {
                entry.target.classList.add('in-view');
                io.unobserve(entry.target);
              }
            });
          },
          { rootMargin: '-60px' }
        );
        document.querySelectorAll('[data-reveal]').forEach(function(el) {
          io.observe(el);
        });
      });
    }
  </script>

  <!-- Lead & Regional Visit Telemetry (Campaign Tagging & Downloads) -->
  <script is:inline>
    (function() {
      if (typeof window === 'undefined' || window.__leadTelemetryBound) return;
      window.__leadTelemetryBound = true;

      function getLeadContext() {
        try {
          var params = new URLSearchParams(window.location.search);
          var ref = params.get('ref') || params.get('utm_source') || params.get('c') || params.get('v');
          if (ref) {
            localStorage.setItem('__audit_lead_ref', ref);
          }
        } catch (e) {}

        var leadRef = null;
        try {
          leadRef = localStorage.getItem('__audit_lead_ref');
        } catch (e) {}

        var tz = '';
        try {
          tz = Intl.DateTimeFormat().resolvedOptions().timeZone || '';
        } catch (e) {}

        return { leadRef: leadRef, isDubai: tz === 'Asia/Dubai' };
      }

      document.addEventListener('astro:page-load', function() {
        var ctx = getLeadContext();
        var sessionKey = '__notified_' + window.location.pathname;
        if (!sessionStorage.getItem(sessionKey)) {
          sessionStorage.setItem(sessionKey, '1');
          if (typeof gtag === 'function') {
            gtag('event', 'lead_executive_view', {
              lead_tag: ctx.leadRef || (ctx.isDubai ? 'dubai_direct' : 'direct'),
              page_path: window.location.pathname
            });
          }
        }
      });

      document.addEventListener('click', function(e) {
        var target = e.target;
        var el = target instanceof Element ? target : target && target.parentElement;
        var link = el && el.closest('a');
        if (!link) return;
        var href = link.getAttribute('href') || '';
        if (/\.(pdf|xlsx|docx|zip)$/i.test(href)) {
          var ctx = getLeadContext();
          var fileName = href.split('/').pop().split('?')[0];
          var dlIdentity = ctx.leadRef || (ctx.isDubai ? 'Dubai Contact' : 'Direct Visitor');
          if (typeof gtag === 'function') {
            gtag('event', 'lead_file_download', { file: fileName, lead: dlIdentity });
          }
        }
      });
    })();
  </script>

</body>
</html>
