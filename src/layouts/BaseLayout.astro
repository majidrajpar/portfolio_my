---
import '../styles/global.css';
import Navbar from '../components/Navbar';
import { ViewTransitions } from 'astro:transitions';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  robots?: string;
}

const {
  title,
  description = 'Strategic Audit Advisory with 20+ years finding the operational and governance gaps businesses have not priced yet. Fraud detection, board-grade assurance, and audit functions that actually protect capital.',
  ogImage = '/portfolio_my/images/majid-profile.jpg',
  robots,
} = Astro.props;

const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const baseUrl = import.meta.env.BASE_URL;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="author" content="Majid Mumtaz" />
  <meta name="description" content={description} />
  {robots && <meta name="robots" content={robots} />}

  <!-- Canonical -->
  <link rel="canonical" href={canonicalUrl} />

  <!-- Open Graph -->
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={`https://majidrajpar.github.io${ogImage}`} />
  <meta property="og:site_name" content="Majid Mumtaz | Strategic Audit Advisory" />

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={`https://majidrajpar.github.io${ogImage}`} />

  <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />
  <title>{title}</title>

  <!-- Structured data: Person schema -->
  <script type="application/ld+json" is:inline set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Person",
    "name": "Majid Mumtaz",
    "givenName": "Majid",
    "familyName": "Mumtaz",
    "jobTitle": "Director of Internal Audit & Risk Advisory",
    "url": "https://majidrajpar.github.io/portfolio_my/",
    "image": "https://majidrajpar.github.io/portfolio_my/images/projects/finance-dashboard/executive-summary.png",
    "email": "mailto:majidrajpar@gmail.com",
    "description": "Strategic Audit Advisor with 20+ years in Big 4 and GCC leadership. CIA, ACA, FCCA. Published in IIA, GRC Report, Consultancy ME, and Corporate Compliance Insights.",
    "knowsAbout": [
      "Internal Audit",
      "Fraud Detection",
      "Forensic Analytics",
      "IPO Readiness",
      "Board Governance",
      "COSO ERM",
      "ICOFR",
      "Risk Management"
    ],
    "hasCredential": ["CIA", "ACA", "FCCA", "GRCP", "GRCA", "COSO ERM Certified"],
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "Dubai",
      "addressCountry": "AE"
    },
    "sameAs": [
      "https://www.linkedin.com/in/majid-m-4b097118/",
      "https://www.youtube.com/@AuditBitz",
      "https://www.linkedin.com/newsletters/the-audit-signal-7339153291630510080/",
      "https://app.gocatalant.com/c/_/profile/kd6vrg/verify/"
    ]
  })} />

  <ViewTransitions />

  <!-- Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=DM+Serif+Display:ital@0;1&display=swap" rel="stylesheet" />

  <!-- Google Analytics GA4 -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-9GCK25N9C5"></script>
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-9GCK25N9C5');
  </script>
</head>
<body class="min-h-screen">

  <!-- Skip to main content (keyboard/screen-reader users) -->
  <a href="#main-content" class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[200] focus:px-4 focus:py-2 focus:bg-white focus:text-[#181511] focus:font-black focus:text-xs focus:uppercase focus:tracking-widest focus:border focus:border-[#181511] focus:outline-none">
    Skip to main content
  </a>

  <!-- Navbar: React island for scroll-aware behaviour -->
  <Navbar client:load initialPath={Astro.url.pathname} />

  <!-- Main Content -->
  <main id="main-content">
    <slot />
  </main>

  <!-- Footer -->
  <footer class="footer-shell py-16 border-t border-white/10">
    <div class="max-w-7xl mx-auto px-8">
      <div class="grid grid-cols-1 gap-12 md:grid-cols-4 mb-14">
        <div>
          <div class="text-white font-black text-xs uppercase tracking-[0.34em] mb-4">Majid Mumtaz</div>
          <p class="text-white/70 text-sm leading-7 max-w-sm">Continuous controls monitoring, internal audit automation, and board assurance.</p>
        </div>
        <div>
          <div class="text-white/45 text-[10px] font-black uppercase tracking-[0.28em] mb-5">Overview</div>
          <ul class="space-y-3">
            {[
              { label: 'Case Studies', href: `${baseUrl}projects/` },
              { label: 'Tools', href: `${baseUrl}tools/` },
              { label: 'About', href: `${baseUrl}about/` },
              { label: 'Advisory', href: `${baseUrl}advisory/` },
              { label: 'Contact', href: `${baseUrl}contact/` },
            ].map(link => (
              <li><a href={link.href} class="text-white/72 hover:text-white text-sm font-semibold transition-colors">{link.label}</a></li>
            ))}
          </ul>
        </div>
        <div>
          <div class="text-white/45 text-[10px] font-black uppercase tracking-[0.28em] mb-5">Shelf</div>
          <ul class="space-y-3">
            {[
              { label: 'Builds', href: `${baseUrl}software/` },
              { label: 'Resource library', href: `${baseUrl}resources/` },
              { label: 'ERM & CCM Suite', href: `${baseUrl}erm-ccm-suite/` },
              { label: 'RoleForge', href: `${baseUrl}roleforge/` },
              { label: 'Books', href: `${baseUrl}about/#books` },
            ].map(link => (
              <li><a href={link.href} class="text-white/72 hover:text-white text-sm font-semibold transition-colors">{link.label}</a></li>
            ))}
            <li>
              <a href="https://www.linkedin.com/newsletters/the-audit-signal-7339153291630510080/" target="_blank" rel="noopener noreferrer" class="text-white/72 hover:text-white text-sm font-semibold transition-colors">The Audit Signal</a>
            </li>
          </ul>
        </div>
        <div>
          <div class="text-white/45 text-[10px] font-black uppercase tracking-[0.28em] mb-5">Reach &amp; Storefronts</div>
          <ul class="space-y-3">
            <li><a href="mailto:majidrajpar@gmail.com" class="text-white/72 hover:text-white text-sm font-semibold transition-colors">majidrajpar@gmail.com</a></li>
            <li><span class="text-white/72 text-sm font-semibold">Dubai</span></li>
            <li><a href={`${baseUrl}cv/Majid_Mumtaz_Internal_Audit_GRC.pdf`} download class="text-white/72 hover:text-white text-sm font-semibold transition-colors">CV</a></li>
          </ul>
          <div class="mt-5 pt-4 border-t border-white/10">
            <div class="text-white/40 text-[9px] font-black uppercase tracking-[0.2em] mb-2.5">Author Storefronts</div>
            <ul class="space-y-2">
              <li>
                <a href="https://majidmumtaz.gumroad.com" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 text-xs font-semibold text-[#f4c98b]/90 hover:text-[#f4c98b] transition-colors">
                  <span>Gumroad Storefront</span>
                  <svg class="h-3 w-3 opacity-70" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                  </svg>
                </a>
              </li>
              <li>
                <a href="https://www.eloquens.com/channel/majid-mumtaz" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 text-xs font-semibold text-white/75 hover:text-white transition-colors">
                  <span>Eloquens Channel</span>
                  <svg class="h-3 w-3 opacity-70" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                  </svg>
                </a>
              </li>
              <li>
                <a href="https://flevy.com" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 text-xs font-semibold text-white/75 hover:text-white transition-colors">
                  <span>Flevy Author Hub</span>
                  <svg class="h-3 w-3 opacity-70" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                  </svg>
                </a>
              </li>
              <li>
                <a href="https://www.efinancialmodels.com/vendor/majidmumtaz/" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 text-xs font-semibold text-white/75 hover:text-white transition-colors">
                  <span>eFinancialModels Store</span>
                  <svg class="h-3 w-3 opacity-70" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                  </svg>
                </a>
              </li>
            </ul>
          </div>
        </div>
      </div>
      <div class="border-t border-white/10 pt-7 flex flex-col sm:flex-row items-center justify-between gap-4 text-center sm:text-left">
        <div class="text-white/45 text-[9px] uppercase tracking-[0.42em] font-black">
          &copy; {new Date().getFullYear()} Majid Mumtaz CIA, ACA, FCCA. All Rights Reserved.
        </div>
        <div>
          <a href={`${baseUrl}terms/`} class="text-white/45 hover:text-white text-[10px] uppercase tracking-[0.24em] font-bold transition-colors underline underline-offset-4 decoration-white/20 hover:decoration-white">
            Terms &amp; Intellectual Property
          </a>
        </div>
      </div>
    </div>
  </footer>

  <!-- IntersectionObserver for data-reveal animations -->
  <!-- astro:page-load fires on initial load AND after every View Transitions navigation -->
  <script is:inline data-base={import.meta.env.BASE_URL}>
    window.__recallBase = (document.currentScript && document.currentScript.getAttribute('data-base')) || '/';
    if (!window.__recallViewsBound) {
      window.__recallViewsBound = true;
      document.addEventListener('astro:page-load', function() {
        var base = window.__recallBase || '/';
        var path = window.location.pathname || '';
        if (base !== '/') {
          if (base.charAt(0) !== '/') base = '/' + base;
          if (base.charAt(base.length - 1) !== '/') base += '/';
          if (path.indexOf(base) === 0) path = path.slice(base.length);
        }
        if (path.charAt(0) === '/') path = path.slice(1);
        var name = '';
        var slug = '';
        var caseMatch = /^projects\/([^/]+)\/$/.exec(path);
        if (caseMatch && caseMatch[1] && caseMatch[1] !== 'category') {
          name = 'case_view';
          slug = caseMatch[1];
        } else {
          var toolMatch = /^tools\/([^/]+)\/$/.exec(path);
          if (toolMatch && toolMatch[1]) {
            name = 'tool_view';
            slug = toolMatch[1];
          }
        }
        if (!name || typeof gtag !== 'function') return;
        gtag('event', name, { slug: slug });
      });
    }
    document.addEventListener('astro:page-load', function() {
      const io = new IntersectionObserver(
        function(entries) {
          entries.forEach(function(entry) {
            if (entry.isIntersecting) {
              entry.target.classList.add('in-view');
              io.unobserve(entry.target);
            }
          });
        },
        { rootMargin: '-60px' }
      );
      document.querySelectorAll('[data-reveal]').forEach(function(el) {
        io.observe(el);
      });
    });
  </script>

  <!-- VIP & Executive Visit Telemetry (Instant Discord Alert & Persistent Lead Tagging) -->
  <script is:inline>
    (function() {
      if (typeof window === 'undefined') return;

      // 1. Capture contact tag if present (?ref=np, ?ref=alghurair, ?c=...)
      try {
        var params = new URLSearchParams(window.location.search);
        var ref = params.get('ref') || params.get('utm_source') || params.get('c') || params.get('v');
        if (ref) {
          localStorage.setItem('__audit_lead_ref', ref);
        }
      } catch (e) {}

      var leadRef = null;
      try {
        leadRef = localStorage.getItem('__audit_lead_ref');
      } catch (e) {}

      // 2. Client ID match (Nasser Paracha's exact Microsoft Edge cookie ID from 30 Oct)
      var isNasser = false;
      if (document.cookie.indexOf('517757122') !== -1 || (leadRef && /nasser|alghurair|np/i.test(leadRef))) {
        isNasser = true;
      }

      // 3. Timezone detection (Asia/Dubai for UAE / Dubai contacts)
      var tz = '';
      try {
        tz = Intl.DateTimeFormat().resolvedOptions().timeZone || '';
      } catch (e) {}
      var isDubai = (tz === 'Asia/Dubai');

      // Only alert on VIPs, tagged outreach contacts, or Dubai/UAE visitors
      if (!isNasser && !leadRef && !isDubai) return;

      var b64Webhook = 'aHR0cHM6Ly9kaXNjb3JkLmNvbS9hcGkvd2ViaG9va3MvMTU2NTY3NzIxMDk2NTM3NzAzNi94MTMwVHptUG1mcENDTnQ0ZHFiMm90Vlh6SXNTRDFFdlh3ZEUtS0dvcnhpQ0dCQm9aLVRrY0kzekxRZ1hYNlI3OElqdQ==';
      var notifyWebhook = function(text) {
        try {
          fetch(atob(b64Webhook), {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ content: text })
          }).catch(function() {});
        } catch (e) {}
      };

      // 4. Rate-limit pageview alerts per tab session to prevent notification flood
      var sessionKey = '__notified_' + window.location.pathname;
      if (!sessionStorage.getItem(sessionKey)) {
        sessionStorage.setItem(sessionKey, '1');

        var identity = isNasser
          ? '🚨 **VIP RETURN: Nasser Paracha (Al-Ghurair)**'
          : (leadRef ? ('🎯 **Contact Visit (' + leadRef + ')**') : '📍 **Dubai / UAE Contact Visit**');

        var timeString = new Date().toLocaleTimeString('en-GB', { timeZone: 'Asia/Dubai', hour: '2-digit', minute: '2-digit' }) + ' GST';
        var deviceType = window.innerWidth < 768 ? 'Mobile' : 'Desktop';
        var referrer = document.referrer ? ('`' + document.referrer + '`') : 'Direct (Email / Bookmark)';

        var message = identity + '\n' +
          '• **Page:** `' + window.location.pathname + '`\n' +
          '• **Time:** ' + timeString + '\n' +
          '• **Source:** ' + referrer + '\n' +
          '• **Client:** ' + deviceType + '\n' +
          '• **Timezone:** ' + (tz || 'Unknown');

        notifyWebhook(message);

        // Also push custom event to GA4
        if (typeof gtag === 'function') {
          gtag('event', 'vip_executive_view', {
            lead_tag: leadRef || (isNasser ? 'nasser_alghurair' : 'dubai_direct'),
            page_path: window.location.pathname
          });
        }
      }

      // 5. Global listener for file downloads (PDF, XLSX, DOCX)
      if (!window.__downloadAlertBound) {
        window.__downloadAlertBound = true;
        document.addEventListener('click', function(e) {
          var link = e.target.closest('a');
          if (!link) return;
          var href = link.getAttribute('href') || '';
          if (/\.(pdf|xlsx|docx|zip)$/i.test(href)) {
            var fileName = href.split('/').pop().split('?')[0];
            var dlIdentity = isNasser ? 'Nasser Paracha' : (leadRef || 'Dubai Contact');
            var dlMessage = '📥 🔥 **FILE DOWNLOAD TRIGGERED!**\n' +
              '• **File:** `' + fileName + '`\n' +
              '• **User:** **' + dlIdentity + '**\n' +
              '• **From Page:** `' + window.location.pathname + '`\n' +
              '• **Time:** ' + new Date().toLocaleTimeString('en-GB', { timeZone: 'Asia/Dubai', hour: '2-digit', minute: '2-digit' }) + ' GST';
            notifyWebhook(dlMessage);
            if (typeof gtag === 'function') {
              gtag('event', 'vip_file_download', { file: fileName, lead: dlIdentity });
            }
          }
        });
      }
    })();
  </script>

</body>
</html>
