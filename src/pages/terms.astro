---
import BaseLayout from '../layouts/BaseLayout.astro';
import NetworkCanvas from '../components/NetworkCanvas';

const base = import.meta.env.BASE_URL;
---

<BaseLayout
  title="Methodology, Licensing & Advisory Terms | Majid Mumtaz"
  description="Intellectual property guidelines, permitted enterprise evaluation use, open-source boundaries, and professional assurance disclaimers."
>
  <!-- Hero Section -->
  <section class="relative overflow-hidden px-4 pt-24 md:px-8 md:pt-28">
    <div class="editorial-panel relative mx-auto max-w-7xl overflow-hidden px-6 py-10 md:px-10 md:py-14">
      <NetworkCanvas client:load nodeCount={35} />
      <div class="relative z-10 max-w-4xl" data-reveal>
        <a href={`${base}tools/`} class="mb-7 inline-flex text-[11px] font-black uppercase tracking-[0.28em] text-white/58 transition-colors hover:text-white">
          &larr; Back to Tools
        </a>
        <span class="hero-chip mb-6 md:mb-7">Governance &amp; Intellectual Property</span>
        <h1 class="headline-display max-w-4xl text-[clamp(2.6rem,5.5vw,4.8rem)] font-black text-white">
          Methodology, Licensing
          <span class="block text-[#f4c98b]">&amp; Advisory Terms.</span>
        </h1>
        <p class="mt-6 max-w-3xl text-[15px] leading-7 text-white/75 md:mt-8 md:text-[1.08rem] md:leading-9">
          Clear boundaries between proprietary in-browser diagnostic calculators, open-source engineering builds, and formal internal audit advisory engagements.
        </p>
      </div>
    </div>
  </section>

  <!-- Section 1: Intellectual Property & Enterprise Evaluation Scope -->
  <section class="px-4 py-8 md:px-8">
    <div class="mx-auto max-w-7xl">
      <div class="soft-shell p-8 md:p-12 border-l-4 border-[#c7964c]" data-reveal>
        <span class="eyebrow-label text-[#a66c1c]">01 // Ownership</span>
        <h2 class="mt-4 text-[clamp(1.8rem,3.8vw,2.8rem)] leading-[1.08] text-[#181511]">
          Intellectual Property &amp; Permitted Evaluation Scope
        </h2>
        <p class="mt-4 max-w-3xl text-sm leading-7 text-[color:var(--text-secondary)] md:text-base md:leading-8">
          The analytical frameworks, scoring models, mathematical formalisms, and user workflows published on this platform represent proprietary work developed across internal audit, risk advisory, and forensic practice.
        </p>

        <div class="mt-8 grid gap-6 lg:grid-cols-2">
          <div class="rounded-3xl border border-[color:var(--line-soft)] bg-white/70 p-6 shadow-sm dark:bg-white/5">
            <span class="meta-label text-[#107c41]">Permitted Scope</span>
            <ul class="mt-4 space-y-3 text-xs leading-6 text-[#181511] dark:text-white/80">
              <li class="flex items-start gap-2.5">
                <span class="mt-1 h-1.5 w-1.5 flex-shrink-0 rounded-full bg-[#107c41]"></span>
                <span><strong>Internal Enterprise Evaluation:</strong> Internal audit teams, CFOs, and Audit Committees are welcome to test and evaluate these tools against their operational scenarios.</span>
              </li>
              <li class="flex items-start gap-2.5">
                <span class="mt-1 h-1.5 w-1.5 flex-shrink-0 rounded-full bg-[#107c41]"></span>
                <span><strong>CCM Telemetry &amp; SQL Query Benchmarking:</strong> Audit and analytics teams may evaluate and benchmark generated continuous exception queries and threshold specifications across internal data warehouses (Snowflake, BigQuery, Postgres, Oracle) for internal enterprise controls testing.</span>
              </li>
              <li class="flex items-start gap-2.5">
                <span class="mt-1 h-1.5 w-1.5 flex-shrink-0 rounded-full bg-[#107c41]"></span>
                <span><strong>Methodological Review:</strong> Independent practitioners may review calculations, formulas (such as AICPA attribute sampling, BOM costing, and finite population correction), and report templates.</span>
              </li>
              <li class="flex items-start gap-2.5">
                <span class="mt-1 h-1.5 w-1.5 flex-shrink-0 rounded-full bg-[#107c41]"></span>
                <span><strong>Academic &amp; Professional Citation:</strong> Discussion or citation in professional forums is permitted with direct attribution to Majid Mumtaz.</span>
              </li>
            </ul>
          </div>

          <div class="rounded-3xl border border-[color:var(--line-soft)] bg-white/70 p-6 shadow-sm dark:bg-white/5">
            <span class="meta-label text-[#d9381e]">Restrictions</span>
            <ul class="mt-4 space-y-3 text-xs leading-6 text-[#181511] dark:text-white/80">
              <li class="flex items-start gap-2.5">
                <span class="mt-1 h-1.5 w-1.5 flex-shrink-0 rounded-full bg-[#d9381e]"></span>
                <span><strong>No Commercial Resale or White-Labeling:</strong> Incorporating these calculators, scoring engines, or telemetry specifications into third-party commercial consulting packages or charging fees for their access is prohibited.</span>
              </li>
              <li class="flex items-start gap-2.5">
                <span class="mt-1 h-1.5 w-1.5 flex-shrink-0 rounded-full bg-[#d9381e]"></span>
                <span><strong>No Commercial Software Packaging:</strong> Bundling generated continuous controls monitoring query suites or algorithms into commercial SaaS platforms, managed services, or proprietary software products without express written agreement is prohibited.</span>
              </li>
              <li class="flex items-start gap-2.5">
                <span class="mt-1 h-1.5 w-1.5 flex-shrink-0 rounded-full bg-[#d9381e]"></span>
                <span><strong>Preservation of Attribution:</strong> Removing author copyright tags, attribution notices, or disclaimer metadata from generated exports is not permitted.</span>
              </li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Section 2: Dual Architecture (In-Browser Tools vs Open-Source Codebases) -->
  <section class="px-4 py-8 md:px-8">
    <div class="mx-auto max-w-7xl">
      <div class="soft-shell p-8 md:p-12 border-l-4 border-[#1d3557]" data-reveal>
        <span class="eyebrow-label text-[#1d3557]">02 // Architecture</span>
        <h2 class="mt-4 text-[clamp(1.8rem,3.8vw,2.8rem)] leading-[1.08] text-[#181511]">
          In-Browser Tools vs. Open-Source Repositories
        </h2>
        <p class="mt-4 max-w-3xl text-sm leading-7 text-[color:var(--text-secondary)] md:text-base md:leading-8">
          This site maintains a clean distinction between interactive web demonstration tools and standalone open-source engineering projects.
        </p>

        <div class="mt-8 grid gap-6 lg:grid-cols-3">
          <div class="rounded-3xl border border-[color:var(--line-soft)] bg-white/70 p-6 shadow-sm dark:bg-white/5">
            <span class="meta-label text-[#8d6035]">Web Tools (/tools/*)</span>
            <h3 class="mt-2 text-xl font-bold text-[#181511] dark:text-white">In-Browser Advisory Instruments</h3>
            <p class="mt-3 text-xs leading-relaxed text-[color:var(--text-secondary)]">
              The calculators, telemetry query architects, and simulation engines hosted on this domain (such as the 100% Continuous Controls Monitoring Telemetry Architect, Cafe Inventory &amp; Recipe Costing Engine, Forensic Pattern Validator, Control Deficiency Exposure Calculator, and Fraud Risk Calculator) are proprietary advisory instruments.
            </p>
            <p class="mt-3 text-xs leading-relaxed text-[color:var(--text-secondary)]">
              They are delivered as client-side web applications for interactive demonstration and enterprise evaluation. They do not carry standalone redistribution rights.
            </p>
            <div class="mt-6">
              <a href={`${base}tools/`} class="text-xs font-bold text-[#181511] underline underline-offset-4 hover:text-[#8d6035] dark:text-white">
                View Tools Directory &rarr;
              </a>
            </div>
          </div>

          <div class="rounded-3xl border border-[color:var(--line-soft)] bg-white/70 p-6 shadow-sm dark:bg-white/5">
            <span class="meta-label text-[#181511] dark:text-white/70">Builds (/software/*)</span>
            <h3 class="mt-2 text-xl font-bold text-[#181511] dark:text-white">Standalone Codebases &amp; Repositories</h3>
            <p class="mt-3 text-xs leading-relaxed text-[color:var(--text-secondary)]">
              Standalone programs listed under <a href={`${base}software/`} class="underline underline-offset-4">Builds</a> (such as <em>Invoice Audit Engine</em>, <em>AuditDesk</em>, <em>ThirdEye</em>, and <em>RoleForge</em>) are sovereign systems distributed via GitHub.
            </p>
            <p class="mt-3 text-xs leading-relaxed text-[color:var(--text-secondary)]">
              Each repository carries its own independent open-source or source-available license (such as MIT or Elastic License 2.0). Organizations may clone, audit, and deploy these codebases on-premise in accordance with their respective repository license files.
            </p>
            <div class="mt-6">
              <a href={`${base}software/`} class="text-xs font-bold text-[#181511] underline underline-offset-4 hover:text-[#8d6035] dark:text-white">
                View Open-Source Builds &rarr;
              </a>
            </div>
          </div>

          <div class="rounded-3xl border border-[color:var(--line-soft)] bg-white/70 p-6 shadow-sm dark:bg-white/5">
            <span class="meta-label text-[#a66c1c]">Commercial Suites (/resources/#commercial-suites)</span>
            <h3 class="mt-2 text-xl font-bold text-[#181511] dark:text-white">Licensed Governance &amp; CCM Toolkits</h3>
            <p class="mt-3 text-xs leading-relaxed text-[color:var(--text-secondary)]">
              Downloadable white-label governance programmes and working bundles (including the <em>Cloud Kitchen &amp; Multi-Brand F&amp;B ERM + CCM Suite</em>, <em>CAE &amp; GIAS 2024 OS</em>, <em>GCC Pre-IPO &amp; ICFR Kit</em>, <em>Forensic &amp; AP Triage Arsenal</em>, and <em>Multi-Channel Ops &amp; Vendor Pack</em>) are commercially licensed via Gumroad for internal deployment or client advisory engagements.
            </p>
            <p class="mt-3 text-xs leading-relaxed text-[color:var(--text-secondary)]">
              Commercial licenses do not permit reselling, sublicensing, or redistributing the raw unlocked <code class="font-mono text-[11px]">.xlsx</code> and <code class="font-mono text-[11px]">.docx</code> templates as a competing digital product or bundling them into commercial SaaS platforms.
            </p>
            <div class="mt-6 flex flex-wrap gap-4">
              <a href={`${base}erm-ccm-suite/`} class="text-xs font-bold text-[#181511] underline underline-offset-4 hover:text-[#8d6035] dark:text-white">
                View Flagship ERM + CCM Suite &rarr;
              </a>
              <a href={`${base}resources/#commercial-suites`} class="text-xs font-bold text-[#a33a21] underline underline-offset-4 hover:text-[#181511] dark:text-[#f4c98b]">
                All 5 Commercial Suites &rarr;
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Section 3: Statutory Assurance & Professional Boundary -->
  <section class="px-4 py-8 md:px-8">
    <div class="mx-auto max-w-7xl">
      <div class="soft-shell p-8 md:p-12 border-l-4 border-[#a33a21]" data-reveal>
        <span class="eyebrow-label text-[#a33a21]">03 // Practice Boundary</span>
        <h2 class="mt-4 text-[clamp(1.8rem,3.8vw,2.8rem)] leading-[1.08] text-[#181511]">
          Statutory Assurance &amp; Professional Boundaries
        </h2>
        <p class="mt-4 max-w-3xl text-sm leading-7 text-[color:var(--text-secondary)] md:text-base md:leading-8">
          The models and calculators on this website provide analytical benchmarks and scenario simulations. They are not substitutes for formal, regulated assurance engagements.
        </p>

        <div class="mt-8 grid gap-6 md:grid-cols-3">
          <div class="rounded-2xl border border-[color:var(--line-soft)] bg-white/60 p-5 dark:bg-white/5">
            <span class="meta-label text-[#181511] dark:text-white/80">No Statutory Opinion</span>
            <p class="mt-2 text-xs leading-6 text-[color:var(--text-secondary)]">
              Outputs do not constitute a formal statutory audit opinion under International Standards on Auditing (ISA) or an assurance conclusion under ISAE 3000 / ISAE 3402.
            </p>
          </div>

          <div class="rounded-2xl border border-[color:var(--line-soft)] bg-white/60 p-5 dark:bg-white/5">
            <span class="meta-label text-[#181511] dark:text-white/80">No Legal or Tax Advice</span>
            <p class="mt-2 text-xs leading-6 text-[color:var(--text-secondary)]">
              Calculators do not provide formal legal counsel or statutory tax advice. Regulated filings must be validated with qualified enterprise legal counsel and statutory tax practitioners.
            </p>
          </div>

          <div class="rounded-2xl border border-[color:var(--line-soft)] bg-white/60 p-5 dark:bg-white/5">
            <span class="meta-label text-[#181511] dark:text-white/80">Contracted Mandates</span>
            <p class="mt-2 text-xs leading-6 text-[color:var(--text-secondary)]">
              Formal audit findings, board representations, and continuous controls monitoring implementations require a direct, contracted engagement governed by specific engagement terms.
            </p>
          </div>
        </div>

        <div class="mt-6 rounded-2xl bg-slate-50 p-4 text-xs leading-6 text-[color:var(--text-secondary)] dark:bg-white/5">
          <strong>Reliance Note:</strong> Calculated projections (such as sample sizes, fraud risk indices, deficiency exposure estimates, and theoretical inventory variances) depend on the hypotheses and data input by the user. No liability is assumed for decisions taken solely on unverified automated outputs.
        </div>
      </div>
    </div>
  </section>

  <!-- Section 4: Data Privacy & On-Device Execution -->
  <section class="px-4 py-8 md:px-8">
    <div class="mx-auto max-w-7xl">
      <div class="soft-shell p-8 md:p-12 border-l-4 border-[#107c41]" data-reveal>
        <span class="eyebrow-label text-[#107c41]">04 // Privacy Standard</span>
        <h2 class="mt-4 text-[clamp(1.8rem,3.8vw,2.8rem)] leading-[1.08] text-[#181511]">
          On-Device Execution &amp; Client Confidentiality
        </h2>
        <p class="mt-4 max-w-3xl text-sm leading-7 text-[color:var(--text-secondary)] md:text-base md:leading-8">
          Audit and operational datasets contain sensitive information. The architecture of this site is intentionally built to keep all data within your browser perimeter.
        </p>

        <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
          <div class="stat-plinth p-5">
            <div class="text-base font-black text-[#107c41]">100% On-Device</div>
            <p class="mt-2 text-xs leading-relaxed text-[color:var(--text-secondary)]">
              All calculations run in client-side memory within your browser sandbox.
            </p>
          </div>

          <div class="stat-plinth p-5">
            <div class="text-base font-black text-[#107c41]">Zero Transmission</div>
            <p class="mt-2 text-xs leading-relaxed text-[color:var(--text-secondary)]">
              No invoice numbers, stock levels, or risk ratings are sent to external servers.
            </p>
          </div>

          <div class="stat-plinth p-5">
            <div class="text-base font-black text-[#107c41]">Offline Capable</div>
            <p class="mt-2 text-xs leading-relaxed text-[color:var(--text-secondary)]">
              Tools function without active internet connectivity once the page is loaded.
            </p>
          </div>

          <div class="stat-plinth p-5">
            <div class="text-base font-black text-[#107c41]">Verifiable</div>
            <p class="mt-2 text-xs leading-relaxed text-[color:var(--text-secondary)]">
              Network activity can be verified via browser developer tools (<kbd class="font-mono text-[11px]">F12 &rarr; Network</kbd>).
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Navigation Links -->
  <section class="px-4 py-8 pb-16 md:px-8">
    <div class="mx-auto max-w-7xl flex flex-wrap items-center justify-between gap-6 border-t border-[color:var(--line-soft)] pt-8">
      <div class="flex flex-wrap gap-6 text-sm font-semibold">
        <a href={`${base}tools/`} class="text-[#181511] underline underline-offset-4 hover:text-[#8d6035] dark:text-white">
          Tools Directory
        </a>
        <a href={`${base}software/`} class="text-[#181511] underline underline-offset-4 hover:text-[#8d6035] dark:text-white">
          Open-Source Builds
        </a>
        <a href={`${base}advisory/`} class="text-[#181511] underline underline-offset-4 hover:text-[#8d6035] dark:text-white">
          Advisory Services
        </a>
        <a href={`${base}contact/`} class="text-[#181511] underline underline-offset-4 hover:text-[#8d6035] dark:text-white">
          Contact
        </a>
      </div>
      <div class="text-xs text-[color:var(--text-secondary)]">
        &copy; {new Date().getFullYear()} Majid Mumtaz CIA, ACA, FCCA
      </div>
    </div>
  </section>
</BaseLayout>
