---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCaseStudies } from '../../lib/db.js';

const cases = getCaseStudies();
const base = import.meta.env.BASE_URL;
const written = cases.filter((item) => item.situation);
const short = cases.filter((item) => !item.situation);
---

<BaseLayout
  title="Case studies | Majid Mumtaz"
  description="Four written cases. Six shorter records follow. Each title links to its page."
>
  <section class="px-4 pt-24 md:px-8 md:pt-28">
    <div class="mx-auto max-w-7xl" data-reveal>
      <h1 class="text-[clamp(2.6rem,6vw,4.8rem)] font-black leading-[1.02] text-[#181511]">Case studies.</h1>
      <p class="mt-5 max-w-3xl text-base leading-8 text-[color:var(--text-secondary)] md:text-[1.15rem] md:leading-9">Four written cases. Six shorter records follow. Each title links to its page.</p>
    </div>
  </section>

  <section class="px-4 py-5 md:px-8">
    <div class="soft-shell mx-auto flex max-w-7xl items-start gap-3 px-5 py-5 md:px-7" data-reveal>
      <svg class="mt-0.5 h-4 w-4 flex-shrink-0 text-[#c7964c]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
      </svg>
      <p class="text-sm leading-7 text-[color:var(--text-secondary)]">
        <span class="meta-label text-[#181511]">Disclosure</span>
        Employer names are on the career record. This page uses the industry field and the stored figures.
      </p>
    </div>
  </section>

  <section class="px-4 py-4 pb-12 md:px-8">
    <div class="mx-auto max-w-7xl">
      <div class="space-y-5">
        {written.map((study) => (
          <a href={`${base}projects/${study.slug}/`} class="glass-card block rounded-[30px] p-7 md:p-8">
            <span class="inline-flex rounded-full bg-[#181512] px-3 py-1 text-[10px] font-black uppercase tracking-[0.2em] text-[#f4c98b]">{study.industry}</span>
            <h2 class="mt-4 text-[clamp(1.6rem,3vw,2.4rem)] leading-tight text-[#181511]">{study.title}</h2>
            <p class="mt-4 text-sm leading-7 text-[color:var(--text-secondary)] md:text-base md:leading-8">{study.impact}</p>
          </a>
        ))}
      </div>
      <div class="soft-shell mt-8 px-6 py-8 md:px-8">
        <h2 class="text-2xl leading-tight text-[#181511]">Shorter records</h2>
        <p class="mt-3 text-sm leading-7 text-[color:var(--text-secondary)]">The number below is stored. Situation, mandate, action, result, and reflection are not.</p>
        <div class="mt-6 space-y-4">
          {short.map((study) => (
            <a href={`${base}projects/${study.slug}/`} class="block border-t border-[color:var(--line-soft)] pt-4">
              <h3 class="text-lg leading-7 text-[#181511]">{study.title}</h3>
              <p class="mt-2 text-sm leading-7 text-[color:var(--text-secondary)]">{study.impact}</p>
            </a>
          ))}
        </div>
      </div>
      <div class="mt-10 flex flex-wrap gap-6">
        <a href={`${base}contact/`} class="text-sm font-semibold text-[#181511] underline decoration-[#c7964c] underline-offset-4 transition-colors hover:text-[#8d6035]">Contact</a>
        <a href={`${base}tools/`} class="text-sm font-semibold text-[#181511] underline decoration-[#c7964c] underline-offset-4 transition-colors hover:text-[#8d6035]">Tools</a>
      </div>
    </div>
  </section>
</BaseLayout>
