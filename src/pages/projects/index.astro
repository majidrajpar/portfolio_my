---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCaseStudies } from '../../lib/db.js';

const cases = getCaseStudies();
const base = import.meta.env.BASE_URL;
const written = cases.filter((item) => item.situation);
const short = cases.filter((item) => !item.situation);
---

<BaseLayout
  title="Case Studies: Internal Audit & Capital Defense Outcomes | Majid Mumtaz"
  description="Explore audited enterprise outcomes: AED 7.7M unicorn recovery, SAR 15M M&A capital defense, Tadawul Nomu IPO governance, and continuous controls monitoring."
>
  <section class="border-b border-slate-200 bg-white px-4 pt-28 pb-10 md:px-8">
    <div class="mx-auto max-w-6xl">
      <p class="text-xs font-medium uppercase tracking-widest text-slate-500">Case studies</p>
      <h1 class="mt-4 max-w-3xl text-4xl font-semibold tracking-tight text-slate-900 sm:text-5xl leading-[1.06]">Written cases.</h1>
      <p class="mt-5 max-w-2xl text-base leading-relaxed text-slate-600">Eleven records include the situation, the work, and the result. Employer names are on the career record.</p>
    </div>
  </section>

  <section class="border-b border-slate-200 bg-white px-4 py-12 md:px-8">
    <div class="mx-auto max-w-6xl">
      <div class="divide-y divide-slate-200 border-y border-slate-200">
        {written.map((study) => (
          <a href={`${base}projects/${study.slug}/`} class="block py-6 hover:bg-slate-50">
            <p class="text-xs font-medium uppercase tracking-widest text-slate-500">{study.industry}</p>
            <h2 class="mt-2 text-xl font-semibold tracking-tight text-slate-900">{study.title}</h2>
            <p class="mt-2 max-w-3xl text-sm leading-6 text-slate-600">{study.impact}</p>
          </a>
        ))}
      </div>

      {short.length > 0 && (
        <div class="mt-14">
          <h2 class="text-2xl font-semibold tracking-tight text-slate-900">Outcome records</h2>
          <p class="mt-2 max-w-2xl text-sm leading-6 text-slate-600">These lines are the stored outcome and description. A full write-up is not part of the record.</p>
          <div class="mt-6 grid grid-cols-1 gap-5 md:grid-cols-2">
            {short.map((study) => (
              <a
                href={`${base}projects/${study.slug}/`}
                class="flex h-full flex-col rounded-lg border border-slate-200 bg-white p-6 hover:border-slate-400"
              >
                <p class="text-xs font-medium uppercase tracking-widest text-slate-500">{study.industry}</p>
                <h3 class="mt-2 text-base font-semibold text-slate-900">{study.title}</h3>
                <p class="mt-3 text-sm leading-6 text-slate-700">{study.impact}</p>
                {study.subtitle && (
                  <p class="mt-2 text-sm leading-6 text-slate-600">{study.subtitle}</p>
                )}
              </a>
            ))}
          </div>
        </div>
      )}
      <div class="mt-10 flex flex-wrap gap-6">
        <a href={`${base}contact/`} class="text-sm font-semibold text-[#181511] underline decoration-[#c7964c] underline-offset-4 transition-colors hover:text-[#8d6035]">Contact</a>
        <a href={`${base}tools/`} class="text-sm font-semibold text-[#181511] underline decoration-[#c7964c] underline-offset-4 transition-colors hover:text-[#8d6035]">Tools</a>
      </div>
    </div>
  </section>
</BaseLayout>
