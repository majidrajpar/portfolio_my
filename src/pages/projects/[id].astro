---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { software } from '../../data/software.js';
import { getCaseStudies, categorySlug } from '../../lib/db.js';
const base = import.meta.env.BASE_URL;

const relatedLabels = {
  'whistleblowing-framework-qsr-leader': {
    build: 'ZK Whistleblower repository.',
  },
  'ipo-governance-readiness': {
    tool: 'Nomu governance readiness diagnostic.',
    case: 'Ethics and compliance programme.',
  },
  'data-analytics-audit-training': {
    tool: 'Audit sample size calculator.',
    build: 'POS Cashier & Till Fraud Detection Model.',
  },
  'tadawul-nomu-listing-readiness': {
    tool: 'Nomu governance readiness diagnostic.',
  },
  'enterprise-risk-management-8-countries': {
    tool: 'Risk assessment matrix.',
  },
  'ethics-compliance-programme-multi-country': {
    case: 'IPO readiness and governance architecture.',
  },
  'post-merger-integration-fnb-group': {
    tool: 'Cafe inventory, recipe costing, and POS depletion.',
    case: 'M&A capital protection & due diligence.',
  },
  'executive-financial-dashboards': {
    build: 'BoardLite local dashboard repository.',
  },
  'kitchen-equipment-supplier-fraud': {
    build: 'ThirdEye: Vendor Risk Scanner repository.',
  },
};

export function getStaticPaths() {
  const caseStudies = getCaseStudies().map(s => ({
    id: s.slug,
    title: s.title,
    description: s.subtitle,
    impact: s.impact,
    industry: s.industry,
    categories: s.categories,
    techStack: s.techStack,
    starr: s.starr,
    relatedTool: s.relatedTool,
    relatedBuild: s.relatedBuild,
    relatedCase: s.relatedCase,
    snippetIds: s.snippetIds,
  }));

  return caseStudies.map((p) => ({
    params: { id: p.id },
    props: { project: p },
  }));
}

const { project } = Astro.props as { project: any };
const catSlug = project.categories?.[0] ? categorySlug(project.categories[0]) : 'corporate-governance';
const hasStarr = project.starr && project.starr.situation;
const buildRecord = software.find((item) => item.id === project.relatedBuild);
const relatedLines = [
  project.relatedTool
    ? { href: `${base}tools/${project.relatedTool}/`, label: relatedLabels[project.id]?.tool }
    : null,
  project.relatedBuild && buildRecord
    ? { href: buildRecord.gumroadUrl || buildRecord.githubUrl || `${base}software/`, label: relatedLabels[project.id]?.build, external: true }
    : null,
  project.relatedCase
    ? { href: `${base}projects/${project.relatedCase}/`, label: relatedLabels[project.id]?.case }
    : null,
].filter((line) => line && line.href && line.label);

const pageTitle = `${project.title} | Internal Audit Case Study | Majid Mumtaz`;
const pageDescription = project.impact
  ? `${project.impact}. ${project.description ?? ''}`.trim()
  : (project.description ?? 'Audited outcomes, capital defense records, and governance architecture.');

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'TechArticle',
      'headline': project.title,
      'description': pageDescription,
      'author': {
        '@type': 'Person',
        'name': 'Majid Mumtaz',
        'url': 'https://majidrajpar.github.io/portfolio_my/#person',
        'jobTitle': 'Director of Internal Audit & Risk Advisory',
      },
      'publisher': {
        '@type': 'Organization',
        'name': 'Majid Mumtaz Strategic Audit Advisory',
        'url': 'https://majidrajpar.github.io/portfolio_my/',
      },
      'about': project.categories,
      'keywords': [...(project.categories || []), ...(project.techStack || []), project.industry].filter(Boolean).join(', '),
      'articleSection': project.categories?.[0] || 'Internal Audit',
      'inLanguage': 'en',
    },
    {
      '@type': 'BreadcrumbList',
      'itemListElement': [
        {
          '@type': 'ListItem',
          'position': 1,
          'name': 'Home',
          'item': `https://majidrajpar.github.io${base}`,
        },
        {
          '@type': 'ListItem',
          'position': 2,
          'name': 'Case Studies',
          'item': `https://majidrajpar.github.io${base}projects/`,
        },
        {
          '@type': 'ListItem',
          'position': 3,
          'name': project.title,
          'item': `https://majidrajpar.github.io${base}projects/${project.id}/`,
        },
      ],
    },
  ],
};
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />

  <section class="border-b border-slate-200 bg-white px-4 pt-28 pb-12 md:px-8">
    <div class="mx-auto grid max-w-6xl gap-8 lg:grid-cols-[1.2fr_0.8fr] lg:items-end">
      <div>
        <a href={`${base}projects/`} class="text-sm font-semibold text-slate-900 underline underline-offset-4">
          All case studies
        </a>
        {project.industry && (
          <p class="mt-6 text-xs font-medium uppercase tracking-widest text-slate-500">{project.industry}</p>
        )}
        <h1 class="mt-4 max-w-3xl text-4xl font-semibold tracking-tight text-slate-900 sm:text-5xl leading-[1.06]">
          {project.title}
        </h1>
        {project.description && (
          <p class="mt-5 max-w-2xl text-base leading-relaxed text-slate-600">{project.description}</p>
        )}
      </div>
      <div class="rounded-lg border border-slate-200 bg-white p-6">
        <p class="text-xs font-medium uppercase tracking-widest text-slate-500">Key results</p>
        {project.impact ? (
          <p class="mt-4 text-base leading-7 text-slate-800">{project.impact}</p>
        ) : null}
        {project.categories?.length > 0 && (
          <p class="mt-5 text-sm text-slate-600">
            <a href={`${base}projects/category/${catSlug}/`} class="font-semibold text-slate-900 underline underline-offset-4">
              {project.categories[0]}
            </a>
          </p>
        )}
      </div>
    </div>
  </section>

  <section class="px-4 py-5 md:px-8">
    <div class="rounded-lg border border-slate-200 bg-white mx-auto flex max-w-7xl items-start gap-3 px-5 py-5 md:px-7" data-reveal>
      <svg class="mt-0.5 h-4 w-4 flex-shrink-0 text-[#c7964c]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
      </svg>
      <p class="text-sm leading-7 text-[color:var(--text-secondary)]">
        <span class="meta-label text-[#181511]">Disclosure</span>
        Employer names are on the career record. This page uses the industry field and the stored figures.
        {project.id === 'audit-4-transformation' && (
          <> The AED 7.7M is the dirham result for this food-tech population. The post-acquisition page records acquired-outlet leakage separately. The two figures are not added.</>
        )}
        {project.id === 'post-merger-integration-fnb-group' && (
          <> The AED 22M is acquired-outlet leakage on this page. It is not added to the AED 7.7M result on <a href={`${base}projects/audit-4-transformation/`} class="font-medium text-[#181511] underline underline-offset-4">Audit 4.0</a>.</>
        )}
      </p>
    </div>
  </section>

  <section class="px-4 py-4 pb-12 md:px-8">
    <div class="mx-auto grid max-w-7xl gap-6 lg:grid-cols-[minmax(0,1.35fr)_380px] lg:gap-8">
      <div class="space-y-8">
        {hasStarr ? (
          <div class="rounded-lg border border-slate-200 bg-white px-6 py-8 md:px-10 md:py-12">
            <div class="mb-10" data-reveal>
              <span class="eyebrow-label">Case Details</span>
              <h2 class="mt-4 text-2xl font-semibold tracking-tight text-slate-900">Audit scope and outcomes</h2>
            </div>
            <div class="space-y-10">
              {[
                { label: 'Background', content: project.starr.situation },
                { label: 'Audit Scope', content: project.starr.task },
                { label: 'Testing & Fieldwork', content: project.starr.action },
                { label: 'Findings & Impact', content: project.starr.result },
                { label: 'Operational Insight', content: project.starr.reflection },
              ].filter((section) => section.content).map((section) => (
                <div class="relative border-l border-[color:var(--line-soft)] pl-6 md:pl-9" data-reveal>
                  <div class="absolute left-[-7px] top-1 h-3.5 w-3.5 rounded-full border border-[#c7964c] bg-[var(--surface)] shadow-[0_0_0_5px_rgba(255,250,244,0.9)] md:left-[-8px] md:h-4 md:w-4 md:shadow-[0_0_0_6px_rgba(255,250,244,0.9)]"></div>
                  <span class="eyebrow-label text-[#a66c1c]">{section.label}</span>
                  <p class="mt-3 text-[15px] leading-7 text-[color:var(--text-secondary)] md:mt-4 md:text-base md:leading-8">{section.content}</p>
                </div>
              ))}
            </div>
          </div>
        ) : (
          <div class="rounded-lg border border-slate-200 bg-white px-6 py-8 md:px-10 md:py-12" data-reveal>
            {project.impact && (
              <p class="text-[15px] leading-7 text-[color:var(--text-secondary)] md:text-base md:leading-8">{project.impact}</p>
            )}
            {project.description && (
              <p class="mt-5 text-[15px] leading-7 text-[color:var(--text-secondary)] md:text-base md:leading-8">{project.description}</p>
            )}
          </div>
        )}

        {project.id === 'audit-4-transformation' && (
          <div class="rounded-lg border border-slate-200 bg-white p-6 md:p-8" data-reveal>
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6">
              <span class="eyebrow-label">Executive Dashboard Mockup</span>
              <a href={`${base}downloads/Continuous_Audit_Monitoring_Dashboard.pdf`} download class="btn-primary py-2 px-4 text-[10px] inline-flex gap-2 items-center w-fit">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path></svg>
                Download PDF
              </a>
            </div>
            <img src={`${base}images/projects/Anomaly_Dashboard_Mockup.jpg`} alt="Continuous Audit Dashboard" class="w-full rounded-xl border border-[color:var(--line-soft)] shadow-xl" />
            <p class="mt-5 text-xs text-[color:var(--text-secondary)] leading-relaxed border-l-2 border-[#c7964c] pl-3">Sanitized executive view of real-time anomaly flagging, derived from live point-of-sale data passed through the Isolation Forest engine.</p>
          </div>
        )}

        {project.id === 'data-analytics-audit-training' && (
          <div class="rounded-lg border border-slate-200 bg-white px-6 py-8 md:px-10 md:py-12" data-reveal>
            <span class="eyebrow-label">Record type</span>
            <p class="mt-4 text-[15px] leading-7 text-[color:var(--text-secondary)] md:text-base md:leading-8">Capability. The stored figure is the 60% fieldwork-cycle cut.</p>
          </div>
        )}

        {relatedLines.length > 0 && (
          <div class="rounded-lg border border-slate-200 bg-white px-6 py-8 md:px-10 md:py-12" data-reveal>
            <div class="space-y-4">
              {relatedLines.map((line) => (
                <p class="text-[15px] leading-7 md:text-base md:leading-8">
                  <a
                    href={line.href}
                    class="font-semibold text-[#181511] underline decoration-[#c7964c] underline-offset-4 transition-colors hover:text-[#8d6035]"
                    target={line.external ? '_blank' : undefined}
                    rel={line.external ? 'noopener noreferrer' : undefined}
                  >
                    {line.label}
                  </a>
                </p>
              ))}
            </div>
          </div>
        )}
      </div>
      <aside class="space-y-5 md:space-y-6" data-reveal data-reveal-delay="1">
        <div class="rounded-lg border border-slate-200 bg-white rounded-[30px] p-6 md:p-7">
          <span class="eyebrow-label">At A Glance</span>
          <div class="mt-6 grid gap-4">
          {project.techStack && project.techStack.length > 0 && (
            <div>
              <span class="meta-label">Frameworks</span>
              <div class="mt-3 flex flex-wrap gap-2">
                {project.techStack.map((tech: string) => (
                  <span class="rounded-full border border-[color:var(--line-soft)] bg-white/75 px-3 py-1.5 text-[10px] font-bold uppercase tracking-[0.18em] text-slate-600">
                    {tech}
                  </span>
                ))}
              </div>
            </div>
          )}
          {project.categories?.[0] && (
            <div>
              <span class="meta-label">Practice Area</span>
              <a href={`${base}projects/category/${catSlug}/`} class="mt-3 inline-flex rounded-full bg-[#181512] px-3 py-1.5 text-[10px] font-black uppercase tracking-[0.2em] text-[#f4c98b] transition-colors hover:bg-[#2b241d]">
                {project.categories[0]}
              </a>
            </div>
          )}
          {project.id === 'data-analytics-audit-training' && (
            <div class="mt-4">
              <span class="meta-label">Resources</span>
              <div class="mt-3">
                <a href={`${base}downloads/Data_Analytics_Training_Slide.pdf`} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 rounded-lg border border-[color:var(--line-soft)] bg-white/50 px-4 py-2 text-xs font-bold text-slate-700 transition-all hover:bg-white/80 hover:shadow-sm">
                  <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg>
                  Download Training Deck
                </a>
              </div>
            </div>
          )}
          </div>
        </div>

        <div class="rounded-lg border border-slate-200 bg-white px-5 py-4 md:px-6 md:py-5">
          <a href={`${base}projects/`} class="inline-flex text-[11px] font-black uppercase tracking-[0.24em] text-[#181511] transition-colors hover:text-[#8d6035]">
            ← Back to All Case Studies
          </a>
        </div>
      </aside>
    </div>
  </section>
</BaseLayout>
