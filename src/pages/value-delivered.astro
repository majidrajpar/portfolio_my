---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
return Astro.redirect(`${base}/projects/`, 301);
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <title>Redirecting to Case Studies...</title>
  <link rel="canonical" href={`https://majidrajpar.github.io${base}/projects/`}>
  <meta http-equiv="refresh" content={`0; url=${base}/projects/`}>
</head>
<body>
  <p>This page has been consolidated into our strategic case studies. If you are not redirected automatically, <a href={`${base}/projects/`}>click here to view Case Studies &amp; Audited Outcomes</a>.</p>
</body>
</html>
