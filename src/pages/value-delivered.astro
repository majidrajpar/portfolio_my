---
import BaseLayout from '../layouts/BaseLayout.astro';

const base = import.meta.env.BASE_URL;

const headlineMetrics = [
  { value: 'AED 7.7M', label: 'Financial Impact Captured', sublabel: 'Kitopi — 100% population testing during 340% volume surge' },
  { value: 'SAR 15M', label: 'Hidden Exposure Neutralized', sublabel: '$127M M&A due diligence — undisclosed legal & contract liabilities' },
  { value: 'SAR 12M', label: 'Procurement Fraud Terminated', sublabel: "McDonald's KSA — whistleblower intake & tender collusion triage" },
  { value: '100%', label: 'Population Testing Standard', sublabel: 'Continuous controls monitoring replacing 20-invoice sample blindspots' },
];

const pillars = [
  {
    number: '01',
    title: 'Direct Capital Recovery & Fraud Interception',
    tagline: 'Stopping balance-sheet leakage where standard sampling is structurally blind.',
    cases: [
      {
        entity: 'Kitopi (Hyper-Growth Tech Unicorn)',
        role: 'Director of Internal Audit & GRC',
        metric: 'AED 7.7M Recouped & Protected',
        metricType: 'hard-cash',
        headline: 'Shifted audit from 5–15% sample tests to 100% population monitoring during a 340% transaction surge across 8 countries.',
        details: [
          'Engineered a proprietary Python/Pandas forensic data pipeline reconciling high-volume point-of-sale events against third-party delivery aggregator remittance schemas.',
          'Recovered AED 3.2M in unauthorized aggregator deductions, billing mismatches, and duplicate vendor settlements.',
          'Protected AED 4.5M in projected recurring leakage through automated exception gates in procurement and payroll.',
          'Delivered a clean first-time external audit opinion with zero material weaknesses, securing Board approval for enterprise automation.',
        ],
        projectSlug: 'audit-4-transformation',
        tags: ['Continuous Monitoring', 'Aggregator Remittance', 'Python Forensics', 'SOX 404'],
      },
      {
        entity: 'Al-Faisaliah Group ($127M M&A Mandate)',
        role: 'Group Director, IA & Risk',
        metric: 'SAR 15M Contingent Liability Disclosed',
        metricType: 'risk-exposure',
        headline: 'Forensic contract modeling uncovering undisclosed litigation before acquisition close.',
        details: [
          'Mandated by the Board to conduct independent operational and forensic due diligence on a major regional hospitality acquisition.',
          'Bypassed selective seller disclosure packets by ingesting and analyzing 100% of historical litigation filings, contract amendments, and vendor disputes.',
          'Uncovered SAR 15M in unaccrued legal liabilities and regulatory non-compliance exposure.',
          'Provided the C-suite and Investment Committee with the forensic leverage required to renegotiate deal terms and protect committed acquisition capital.',
        ],
        projectSlug: 'ma-capital-protection',
        tags: ['M&A Due Diligence', 'Contract Risk Modeling', 'Board Advisory', 'Capital Defense'],
      },
      {
        entity: "McDonald's KSA (QSR Leader)",
        role: 'Manager, Internal Audit',
        metric: 'SAR 12M Collusion Scheme Intercepted',
        metricType: 'fraud-triage',
        headline: 'Built secure whistleblower triage and procurement audit protocols from the ground up.',
        details: [
          'Designed and launched the organization’s first confidential reporting protocols and forensic investigation workflows.',
          'Intercepted and investigated a multi-vendor procurement bid-rigging scheme within months of rollout.',
          'Rebuilt vendor vetting and tender award controls, establishing automated price-benchmarking telemetry across food and packaging categories.',
          'Presented actionable forensic dossiers directly to executive leadership, ensuring full asset recovery and legal remediation.',
        ],
        tags: ['Whistleblower Triage', 'Procurement Fraud', 'Tender Telemetry', 'Forensic Investigation'],
      },
      {
        entity: 'KSA Commercial & Residential Portfolio',
        role: 'Forensic Audit Lead',
        metric: 'SAR 3.2M Annual Recurring Recovery',
        metricType: 'hard-cash',
        headline: 'Automated Capex/Opex expenditure audit across SAR 500M+ real estate portfolio.',
        details: [
          'Deployed continuous monitoring scripts tracking contractor milestone invoicing, material variance, and bill-of-quantities discrepancies.',
          'Eliminated recurring over-billing patterns in MEP contracts and facility management tenders.',
          'Established automated continuous verification against physical delivery milestones and contract milestones.',
        ],
        tags: ['Capex Telemetry', 'Contract Compliance', 'Real Estate Audit', 'Variance Analytics'],
      },
    ],
  },
  {
    number: '02',
    title: 'Continuous Controls Monitoring (CCM) Engineering',
    tagline: 'Replacing the 90-day retrospective sample audit with real-time exception pipelines.',
    cases: [
      {
        entity: 'Continuous Auditing Transformation',
        role: 'Architect & Lead',
        metric: '100% Data Ingestion vs 20-Sample Blindspots',
        metricType: 'engineering',
        headline: 'Eliminating the illusion of "comfort" derived from testing 20 invoices once a quarter.',
        details: [
          'Traditional audit samples 20–25 items out of millions, creating a 98%+ blindspot where systemic fraud and margin leakage comfortably hide.',
          'Engineered automated ETL pipelines connecting ERP databases, POS logs, and bank statements into automated rule engines.',
          'Implemented algorithmic false-positive filters to ensure operational managers receive only actionable, high-conviction risk signals.',
          'Reduced audit testing cycle duration by 80% while expanding assurance coverage to the entire population.',
        ],
        tools: [
          { name: 'Deficiency Exposure Calculator', path: 'tools/deficiency-exposure-calculator/' },
          { name: 'Forensic Validator', path: 'tools/forensic-validator/' },
          { name: 'Sample Size Calculator (The Math of Risk)', path: 'tools/audit-sample-size-calculator/' },
        ],
        tags: ['ETL Automation', 'Anomaly Detection', 'Continuous Assurance', 'False-Flag Filtering'],
      },
    ],
  },
  {
    number: '03',
    title: 'Listing Readiness & Statutory Governance Architecture',
    tagline: 'Building scrutiny-resistant internal controls that pass external Big-4 inspection without material weaknesses.',
    cases: [
      {
        entity: 'Multi-Jurisdiction Tech Platform (Pre-IPO)',
        role: 'Strategic Governance Advisor',
        metric: '175+ Control ICOFR Architecture Delivered',
        metricType: 'statutory',
        headline: 'Clean first-time external audit opinion across 7 regional operating entities.',
        details: [
          'Directed the end-to-end Internal Controls Over Financial Reporting (ICOFR) design across UAE, KSA, and regional markets.',
          'Drafted and operationalized Audit Committee charters, delegation of authority (DOA) matrices, and risk appetite statements aligned with listing rules.',
          'Built internal testing telemetry enabling the Board to certify control effectiveness ahead of filing prospectus.',
          'Achieved zero material weaknesses and zero significant deficiencies in external Big-4 readiness assessments.',
        ],
        projectSlug: 'ipo-governance-readiness',
        tools: [
          { name: 'Nomu Governance Readiness Diagnostic', path: 'tools/nomu-governance-readiness/' },
          { name: 'IIA Standards Diagnostic', path: 'tools/iia-standards-readiness/' },
        ],
        tags: ['IPO Readiness', 'ICOFR', 'Audit Committee Charters', 'DOA Matrices'],
      },
      {
        entity: 'Tadawul Nomu & DFM Regulatory Structuring',
        role: 'Advisory Lead',
        metric: '2 Capital Market Readiness Programs',
        metricType: 'statutory',
        headline: 'Establishing institutional compliance structures for high-growth enterprise candidates.',
        details: [
          'Aligned financial reporting controls and governance bodies with Saudi CMA / Tadawul Nomu and UAE DFM requirements.',
          'Integrated Enterprise Risk Management (COSO ERM 2017) tracking 50+ core operational risks and 28 live KRIs.',
          'Trained internal finance and audit teams to maintain continuous regulatory compliance independently.',
        ],
        tags: ['Tadawul Nomu', 'DFM', 'COSO ERM 2017', 'Regulatory Defense'],
      },
    ],
  },
  {
    number: '04',
    title: 'Board Decision Instruments & Empirical Research',
    tagline: 'Converting audit from retrospective paperwork into live executive risk intelligence.',
    cases: [
      {
        entity: 'Original Research & SEC Filing Benchmarks',
        role: 'Principal Researcher & Author',
        metric: '0 / 16 False Clean Opinions | Forced Verdict Gates',
        metricType: 'research',
        headline: 'Benchmarking AI Multi-Agent Audit Judgement against historic corporate collapses.',
        details: [
          'Conducted original empirical research testing plain Python, CrewAI, Swarm, and LangGraph against SEC filings from Enron, Wirecard, SVB, and Tesco.',
          'Proved that unbounded multi-agent systems suffer from systemic verdict evasion (9/16 returned "Unable to Conclude") until structured Forced Verdict Gates are enforced.',
          'Published peer-reviewed research providing Audit Committees with the governance architecture needed to supervise autonomous AI pipelines.',
        ],
        tools: [
          { name: 'Agentic Audit Simulator', path: 'tools/agentic-audit-simulator/' },
          { name: 'Game Theory Audit Simulator', path: 'tools/game-theory-audit-simulator/' },
        ],
        tags: ['Empirical Research', 'Multi-Agent AI', 'Audit Governance', 'AI Accountability'],
      },
      {
        entity: 'Audit Committee & C-Suite Intelligence Reporting',
        role: 'Board-Facing Advisor',
        metric: '85% Efficiency Gain in Executive Reporting',
        metricType: 'governance',
        headline: 'Replacing unread 60-page PDF audit binders with high-signal executive telemetry.',
        details: [
          'Redesigned audit reporting packages for Audit Committee Chairs: 1-page executive risk balance sheets backed by 100% forensic evidence links.',
          'Shifted committee discussions from debating retrospective minor infractions to mitigating structural EBITDA erosion.',
          'Delivered governance playbooks that clarify executive accountability across multi-brand holding structures.',
        ],
        tags: ['Audit Committee Reporting', 'Executive Telemetry', 'EBITDA Defense', 'Corporate Governance'],
      },
    ],
  },
];
---

<BaseLayout
  title="Value Delivered | Audited Executive Ledger — Majid Mumtaz"
  description="Audited ledger of capital protected, balance-sheet leakage recouped, and governance frameworks delivered across 20+ years of high-stakes corporate leadership."
>
  <!-- Hero Section -->
  <section class="relative overflow-hidden px-4 pt-24 md:px-8 md:pt-28">
    <div class="editorial-panel relative mx-auto max-w-7xl overflow-hidden px-6 py-10 md:px-12 md:py-14">
      <div class="relative z-10 max-w-4xl" data-reveal>
        <span class="hero-chip mb-6">Audited Operational Ledger &middot; 2004–Present</span>
        <h1 class="headline-display text-[clamp(2.8rem,6.5vw,5.5rem)] font-black text-white">
          Capital protected.<br />
          <span class="text-[#f4c98b]">Leakage recouped.</span><br />
          Zero compliance theater.
        </h1>
        <p class="mt-6 max-w-3xl text-base leading-8 text-white/76 md:text-lg md:leading-9">
          Internal audit is not a checklist exercise; it is an EBITDA defense instrument. Below is the balance-sheet record of capital recovered, contingent exposures neutralized, and governance infrastructures built across 20+ years in high-friction environments.
        </p>
        <div class="mt-8 flex flex-wrap gap-4 items-center">
          <a href="#pillar-01" class="btn-primary">Examine Capital Recoveries &darr;</a>
          <a href={`${base}contact/`} class="btn-secondary-light">Book Advisory Mandate</a>
          <a href={`${base}tools/`} class="text-[10px] font-black uppercase tracking-[0.24em] text-[#f4c98b] hover:text-white transition-colors ml-2">
            Explore 15+ Interactive Tools &rarr;
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Headline Impact Ledger Strip -->
  <section class="px-4 py-6 md:px-8">
    <div class="mx-auto max-w-7xl">
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {headlineMetrics.map((item, i) => (
          <div class="soft-shell p-6" data-reveal data-reveal-delay={String(i + 1)}>
            <div class="text-3xl md:text-4xl font-black tracking-tight text-[#a33a21]">{item.value}</div>
            <div class="mt-2 text-xs font-black uppercase tracking-[0.16em] text-[#181511]">{item.label}</div>
            <p class="mt-2 text-xs leading-5 text-[color:var(--text-secondary)]">{item.sublabel}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Ledger Pillars -->
  <section class="px-4 py-8 md:px-8 space-y-16">
    <div class="mx-auto max-w-7xl space-y-16">
      {pillars.map((pillar) => (
        <div id={`pillar-${pillar.number}`} class="scroll-mt-28" data-reveal>
          <!-- Pillar Header -->
          <div class="border-b-2 border-[#181511]/10 pb-6 mb-8 flex flex-col md:flex-row md:items-end justify-between gap-4">
            <div>
              <span class="text-xs font-black uppercase tracking-[0.3em] text-[#a33a21]">Pillar {pillar.number}</span>
              <h2 class="mt-2 text-2xl md:text-4xl font-black text-[#181511]">{pillar.title}</h2>
              <p class="mt-2 text-sm text-[color:var(--text-secondary)] max-w-2xl">{pillar.tagline}</p>
            </div>
            <div class="text-[10px] font-black uppercase tracking-[0.22em] text-slate-400">
              Verified Operational Outcomes
            </div>
          </div>

          <!-- Pillar Cases Grid -->
          <div class="grid gap-6 lg:grid-cols-2">
            {pillar.cases.map((entry) => (
              <div class="glass-card flex flex-col rounded-[28px] p-7 border border-black/8 hover:border-[#a33a21]/30 transition-colors">
                <div class="flex items-center justify-between gap-3 border-b border-black/6 pb-4">
                  <div>
                    <div class="text-xs font-black uppercase tracking-[0.18em] text-[#1d3557]">{entry.entity}</div>
                    <div class="text-[10px] uppercase tracking-wider text-slate-500 mt-0.5">{entry.role}</div>
                  </div>
                  <span class="rounded-full bg-[#a33a21]/10 px-3 py-1 text-[10px] font-black uppercase tracking-[0.18em] text-[#a33a21] shrink-0">
                    Verified
                  </span>
                </div>

                <div class="mt-5">
                  <div class="text-xl md:text-2xl font-black text-[#181511] leading-tight">
                    {entry.metric}
                  </div>
                  <p class="mt-2 text-sm font-semibold text-[#181511]/80 leading-snug">
                    {entry.headline}
                  </p>
                </div>

                <div class="mt-5 space-y-2.5 flex-1">
                  {entry.details.map((point) => (
                    <div class="flex items-start gap-2.5 text-xs leading-6 text-[color:var(--text-secondary)]">
                      <span class="text-[#a33a21] font-black mt-0.5">&bull;</span>
                      <span>{point}</span>
                    </div>
                  ))}
                </div>

                {entry.tools && (
                  <div class="mt-6 pt-4 border-t border-black/6">
                    <div class="text-[9px] font-black uppercase tracking-[0.24em] text-[#a33a21] mb-2">Live Verification Tools</div>
                    <div class="flex flex-wrap gap-2">
                      {entry.tools.map((t) => (
                        <a
                          href={`${base}${t.path}`}
                          class="inline-flex items-center text-[10px] font-bold text-[#1d3557] bg-white/70 border border-[#1d3557]/15 rounded-lg px-2.5 py-1 hover:border-[#a33a21] hover:text-[#a33a21] transition-colors"
                        >
                          {t.name} &rarr;
                        </a>
                      ))}
                    </div>
                  </div>
                )}

                <div class="mt-6 pt-4 border-t border-black/6 flex flex-wrap items-center justify-between gap-3">
                  <div class="flex flex-wrap gap-1.5">
                    {entry.tags.map((tag) => (
                      <span class="rounded-md bg-black/4 px-2 py-0.5 text-[9px] font-semibold text-slate-600">
                        {tag}
                      </span>
                    ))}
                  </div>

                  {entry.projectSlug && (
                    <a
                      href={`${base}projects/${entry.projectSlug}/`}
                      class="text-[10px] font-black uppercase tracking-[0.22em] text-[#a33a21] hover:underline shrink-0"
                    >
                      Read Case Study &rarr;
                    </a>
                  )}
                </div>
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- CTA Strip -->
  <section class="px-4 py-8 pb-16 md:px-8">
    <div class="editorial-panel mx-auto max-w-7xl overflow-hidden px-8 py-10 md:px-12 md:py-12">
      <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-8" data-reveal>
        <div class="max-w-2xl">
          <span class="meta-label text-[#f4c98b]">Engagement Mandates</span>
          <h2 class="mt-3 text-2xl md:text-3xl font-black text-white leading-tight">
            Need an independent audit advisor who protects capital rather than filing binders?
          </h2>
          <p class="mt-3 text-sm leading-7 text-white/70">
            Available for Board &amp; Audit Committee advisory mandates, Continuous Controls Monitoring (CCM) architecture, and pre-listing governance readiness across the GCC and internationally.
          </p>
        </div>
        <div class="flex flex-col sm:flex-row gap-4 shrink-0">
          <a href={`${base}contact/`} class="btn-primary">Book Advisory Consultation</a>
          <a href={`${base}cv/Majid_Mumtaz_Internal_Audit_GRC.pdf`} download class="btn-secondary-light">Download Executive CV</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
