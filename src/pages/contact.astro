---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactForm from '../components/ContactForm';
const base = import.meta.env.BASE_URL;

const title = "Contact Majid Mumtaz | Director of Internal Audit & Risk | Dubai";
const description = "Direct contact for Majid Mumtaz, Director of Internal Audit & Risk in Dubai, UAE. For commercial advisory, visit theauditsignal.com.";

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "ContactPage",
      "name": "Contact Majid Mumtaz | Strategic Audit Advisory",
      "url": "https://majidrajpar.github.io/portfolio_my/contact/",
      "mainEntity": {
        "@type": "Person",
        "name": "Majid Mumtaz",
        "email": "mailto:majidrajpar@gmail.com",
        "jobTitle": "Chief Audit Executive (CAE) & Director of Internal Audit & GRC",
        "address": {
          "@type": "PostalAddress",
          "addressLocality": "Dubai",
          "addressCountry": "AE"
        }
      }
    }
  ]
};
---

<BaseLayout
  title={title}
  description={description}
>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />

  <section class="border-b border-slate-200 bg-white px-4 pt-28 pb-12 md:px-8">
    <div class="mx-auto max-w-6xl">
      <p class="text-xs font-medium uppercase tracking-widest text-slate-500">
        Contact · Dubai, UAE
      </p>
      <h1 class="mt-4 max-w-3xl text-4xl font-semibold tracking-tight text-slate-900 sm:text-5xl leading-[1.06]">
        Direct Executive Contact
      </h1>
      <p class="mt-5 max-w-2xl text-base leading-relaxed text-slate-600">
        For executive leadership, board committee, or peer inquiries. For commercial advisory engagements, visit <a href="https://theauditsignal.com" target="_blank" rel="noopener noreferrer" class="font-medium text-slate-900 underline underline-offset-4">theauditsignal.com</a>.
      </p>
    </div>
  </section>

  <section class="px-4 py-4 pb-10 md:px-8">
    <div class="mx-auto max-w-7xl">
      <div class="grid gap-6 lg:grid-cols-[0.86fr_1.14fr]">
        <div class="rounded-lg border border-slate-200 bg-white px-7 py-8 md:px-10 md:py-9" data-reveal>
          <p class="text-xs font-medium uppercase tracking-widest text-slate-500">Direct contact</p>
          <h2 class="mt-4 text-2xl font-semibold tracking-tight text-slate-900">Direct contact details.</h2>
          <div class="border-t border-slate-200 mt-7 max-w-sm"></div>

          <div class="mt-8 space-y-6">
            <div class="rounded-lg border border-slate-200 bg-white p-6">
              <div class="meta-label text-[#a33a21]">Email</div>
              <a href="mailto:majidrajpar@gmail.com" class="mt-3 block text-lg font-semibold text-[#1d3557]">majidrajpar@gmail.com</a>
            </div>
            <div class="rounded-lg border border-slate-200 bg-white p-6">
              <div class="meta-label text-[#a33a21]">Location</div>
              <div class="mt-3 text-lg font-semibold text-[#181511]">Dubai, United Arab Emirates</div>
            </div>
            <div class="rounded-lg border border-slate-200 bg-white p-6">
              <div class="meta-label text-[#a33a21]">Links</div>
              <div class="mt-3 space-y-3 text-sm font-semibold">
                <a href="https://www.linkedin.com/in/majid-m-4b097118/" target="_blank" rel="noopener noreferrer" class="block text-[#1d3557]">LinkedIn ↗</a>
                <a href="https://app.gocatalant.com/c/_/profile/kd6vrg/verify/" target="_blank" rel="noopener noreferrer" class="block text-[#1d3557]">Catalant ↗</a>
                <a href="https://wa.me/971507471708" target="_blank" rel="noopener noreferrer" class="block text-[#1d3557]">WhatsApp ↗</a>
              </div>
            </div>
          </div>

          <div class="quote-panel mt-8 p-7">
            <div class="meta-label text-[#1d3557]">Availability</div>
            <p class="mt-4 text-lg leading-8 text-[#1b1a17]">
              Available for independent consulting, fractional CAE mandates, and board advisory globally.
            </p>
            <div class="mt-6">
              <a href={`${base}cv/Majid_Mumtaz_Internal_Audit_Director.pdf`} class="btn-secondary" download>Download CV</a>
            </div>
          </div>
        </div>

        <div class="editorial-panel px-7 py-8 md:px-10 md:py-9" data-reveal data-reveal-delay="1">
          <p class="text-xs font-medium uppercase tracking-widest text-slate-500">Send a message</p>
          <h2 class="mt-4 text-2xl font-semibold tracking-tight text-slate-900">Send a message.</h2>
          <p class="mt-5 max-w-2xl text-base leading-7 text-slate-600">
            Board, leadership, and peer notes come through this form. Commercial advisory stays on theauditsignal.com.
          </p>
          <div class="mt-8 mb-8 max-w-sm border-t border-slate-200"></div>
          <ContactForm client:load />
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
