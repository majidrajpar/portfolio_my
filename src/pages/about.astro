---
import BaseLayout from '../layouts/BaseLayout.astro';
import CareerList from '../components/CareerList.astro';
import { getCareerMilestones } from '../lib/db.js';
import { testimonials } from '../data/testimonials.js';

const careerData = getCareerMilestones();
const base = import.meta.env.BASE_URL;

const books = [
  { title: 'The Auditor’s Risk Compass', desc: 'Targeted industry frameworks for specialized audit and governance programs.', url: 'https://www.amazon.com/dp/B0H4S6JNHF', cover: `${base}images/books/auditors-risk-compass.jpg` },
  { title: 'The Blueprint of Operations', desc: 'Mastering 15 core business processes in the age of Agentic AI.', url: 'https://www.amazon.com/dp/B0GX33CDRF', cover: `${base}images/books/blueprint-of-operations.jpg` },
  { title: 'The Power Professional', desc: 'A tactical manual for dominance, strategy, and corporate authority.', url: 'https://www.amazon.com/dp/B0G51LS6D6', cover: `${base}images/books/power-professional.jpg` },
  { title: 'Handbook of Risk Red Flags in Restaurants', desc: "A practitioner's guide to preventing failure through early detection of risk indicators.", url: 'https://www.amazon.com/dp/B0GDTBRZPM', cover: `${base}images/books/risk-red-flags.jpg` },
  { title: 'The Un-Financial Risk Manager', desc: 'Protecting value in the real world — ESG, cyber, and emerging strategic risks.', url: 'https://www.amazon.com/dp/B0GDMW53GG', cover: `${base}images/books/unfinancial-risk-manager.jpg` },
  { title: '10 Forensic Accounting Skills', desc: 'Practical handbook on fraud detection, forensic investigation, and evidence management.', url: 'https://www.amazon.com/dp/B0G7T4X3RT', cover: `${base}images/books/forensic-accounting-skills.jpg` },
  { title: 'ITGC Program Guide', desc: 'A strategic approach to IT General Controls — security, compliance, and enterprise value protection.', url: 'https://www.amazon.com/dp/B0FCG96QS8', cover: `${base}images/books/itgc-program-guide.jpg` },
  { title: 'Internal Audit Guide for Dine-In Locations in the Middle East', desc: 'Comprehensive audit guide for restaurant operations in the GCC region.', url: 'https://www.amazon.com/dp/B0DY2NRPQ9', cover: `${base}images/books/internal-audit-dinein.jpg` },
];

const alumniOf = [
  { '@type': 'Organization', name: 'Kitopi' },
  { '@type': 'Organization', name: 'Al-Faisaliah Group' },
  { '@type': 'Organization', name: "McDonald's" },
  { '@type': 'Organization', name: 'BMA Asset Management' },
  { '@type': 'Organization', name: 'Ernst & Young' },
  { '@type': 'Organization', name: 'KPMG' },
];

const employers = [
  { name: 'Veritux Consulting Network', alt: 'Veritux', src: `${base}images/logos/veritux.svg`, height: 'h-6 sm:h-7' },
  { name: 'Kitopi', alt: 'Kitopi', src: `${base}images/logos/kitopi.png`, height: 'h-6 sm:h-7' },
  { name: 'Al-Faisaliah Group', alt: 'Al-Faisaliah Group', src: `${base}images/logos/al-faisaliah.png`, height: 'h-7 sm:h-8' },
  { name: "McDonald's KSA", alt: "McDonald's", src: `${base}images/logos/mcdonalds.svg`, height: 'h-6 sm:h-7', label: "McDonald's" },
  { name: 'BMA Asset Management', alt: 'BMA Asset Management', src: `${base}images/logos/bma.png`, height: 'h-7 sm:h-8' },
  { name: 'Ernst & Young', alt: 'Ernst & Young', src: `${base}images/logos/ey.svg`, height: 'h-7 sm:h-8' },
  { name: 'KPMG', alt: 'KPMG', src: `${base}images/logos/kpmg.svg`, height: 'h-6 sm:h-7' },
];
---

<BaseLayout
  title="About Majid Mumtaz | Chief Audit Executive & Published GRC Author"
  description="21+ years across Big 4 (EY, KPMG) and GCC industry leadership (Kitopi, Al-Faisaliah). Author of 8 governance books, CIA, ACA, FCCA, certified in COSO ERM."
>
  <script type="application/ld+json" is:inline set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'Person',
    name: 'Majid Mumtaz',
    alumniOf,
  })} />

  <section class="border-b border-slate-200 bg-white px-4 pt-28 pb-14 md:px-8">
    <div class="mx-auto grid max-w-6xl gap-10 lg:grid-cols-[1.5fr_0.75fr] lg:items-center">
      <div>
        <p class="text-xs font-medium uppercase tracking-widest text-slate-500">
          About
        </p>
        <h1 class="mt-4 max-w-3xl text-4xl font-semibold tracking-tight text-slate-900 sm:text-5xl leading-[1.06]">
          Career record.
        </h1>
        <p class="mt-6 max-w-2xl text-base leading-relaxed text-slate-600">
          Employment history, board endorsements, credentials, and published books. Engagement outcomes sit on the case studies page.
        </p>
        <div class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-3">
          <a href={`${base}projects/`} class="rounded-md bg-slate-900 px-4 py-2.5 text-xs font-medium text-white hover:bg-slate-800 transition-colors">
            Case studies
          </a>
          <a href={`${base}cv/Majid_Mumtaz_Internal_Audit_GRC.pdf`} download class="text-sm font-semibold text-slate-900 underline underline-offset-4">
            CV (PDF)
          </a>
        </div>
      </div>

      <div class="overflow-hidden rounded-lg border border-slate-200 bg-[#3c4450]">
        <img
          src={`${base}images/majid-profile.jpg`}
          alt="Majid Mumtaz"
          class="aspect-[4/5] w-full object-cover object-top"
          loading="eager"
        />
      </div>
    </div>
  </section>

  <section class="border-b border-slate-200 bg-white px-4 py-8 md:px-8">
    <div class="mx-auto flex max-w-6xl flex-col justify-between gap-6 lg:flex-row lg:items-center">
      <p class="shrink-0 text-xs font-medium uppercase tracking-widest text-slate-500">
        Employers &amp; firms
      </p>
      <div class="flex flex-wrap items-center justify-between gap-7 sm:justify-start sm:gap-10">
        {employers.map((employer) => (
          <div class="flex items-center gap-2.5" title={employer.name}>
            <img
              src={employer.src}
              alt={employer.alt}
              class={`${employer.height} w-auto object-contain`}
              loading="lazy"
            />
            {employer.label && (
              <span class="hidden text-xs font-semibold tracking-wider text-slate-900 sm:inline">{employer.label}</span>
            )}
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="border-b border-slate-200 bg-white px-4 py-14 md:px-8">
    <div class="mx-auto max-w-6xl">
      <div class="grid gap-10 lg:grid-cols-[1.4fr_0.8fr]">
        <div>
          <h2 class="text-2xl font-semibold tracking-tight text-slate-900">Practice</h2>
          <div class="mt-4 space-y-4 text-base leading-relaxed text-slate-600">
            <p>
              21+ years across Big 4 (EY, KPMG) and GCC industry leadership (Kitopi, Al-Faisaliah Group, McDonald's KSA), building internal audit functions, automated control frameworks, and board-level assurance.
            </p>
            <p>
              Core work covers three areas: IA function building, forensic analytics and fraud detection, and board assurance and IPO readiness.
            </p>
            <p>
              Currently operating as Fractional CAE and Director of Internal Audit through Veritux Consulting Network (Dubai), advising CFOs and Audit Committees across KSA and the UAE.
            </p>
          </div>
        </div>
        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-1">
          <div>
            <h3 class="text-xs font-medium uppercase tracking-widest text-slate-500">Credentials</h3>
            <ul class="mt-3 space-y-1.5 text-sm font-medium text-slate-900">
              <li>CIA (IIA)</li>
              <li>ACA (ICAEW UK)</li>
              <li>FCCA (ACCA UK)</li>
              <li>GRCP &amp; GRCA (OCEG)</li>
              <li>COSO ERM Certified</li>
            </ul>
          </div>
          <div>
            <h3 class="text-xs font-medium uppercase tracking-widest text-slate-500">Sectors</h3>
            <ul class="mt-3 space-y-1.5 text-sm text-slate-700">
              <li>Conglomerates &amp; Family Offices</li>
              <li>Cloud Kitchens, QSR &amp; F&amp;B</li>
              <li>Real Estate &amp; Capital Projects</li>
              <li>FMCG, Pharma &amp; Retail</li>
              <li>Financial Services &amp; Asset Mgmt</li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="border-b border-slate-200 bg-white px-4 py-14 md:px-8">
    <div class="mx-auto max-w-6xl">
      <h2 class="text-2xl font-semibold tracking-tight text-slate-900">Career trajectory</h2>
      <div class="mt-6">
        <CareerList careerData={careerData} />
      </div>
    </div>
  </section>

  <section class="border-b border-slate-200 bg-white px-4 py-14 md:px-8" id="endorsements">
    <div class="mx-auto max-w-6xl space-y-6">
      <h2 class="text-2xl font-semibold tracking-tight text-slate-900">
        Recommendations
      </h2>
      <div class="grid gap-6 md:grid-cols-2">
        {testimonials.map((t) => (
          <div class="flex h-full flex-col justify-between rounded-lg border border-slate-200 bg-white p-6">
            <p class="text-sm leading-relaxed text-slate-700">"{t.quote}"</p>
            <div class="mt-4 border-t border-slate-200 pt-3">
              <p class="text-sm font-semibold text-slate-900">{t.name}</p>
              <p class="text-xs text-slate-600">{t.role}</p>
              <p class="mt-0.5 text-[11px] text-slate-500">{t.context}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="border-b border-slate-200 bg-white px-4 py-14 md:px-8" id="books">
    <div class="mx-auto max-w-6xl space-y-6">
      <div class="flex items-end justify-between gap-4">
        <h2 class="text-2xl font-semibold tracking-tight text-slate-900">Books</h2>
        <a href="https://www.amazon.com/s?k=Majid+Mumtaz" target="_blank" rel="noopener noreferrer" class="text-xs font-medium text-slate-700 underline underline-offset-4 hover:text-slate-900">
          All on Amazon →
        </a>
      </div>
      <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {books.map((book) => (
          <a href={book.url} target="_blank" rel="noopener noreferrer" class="flex gap-4 rounded-lg border border-slate-200 bg-white p-5 hover:border-slate-400 transition-colors">
            <div class="w-20 flex-shrink-0 overflow-hidden rounded border border-slate-200 bg-slate-100 aspect-[2/3]">
              <img src={book.cover} alt={book.title} class="h-full w-full object-cover" loading="lazy" />
            </div>
            <div class="flex min-w-0 flex-1 flex-col">
              <h3 class="text-sm font-semibold leading-snug text-slate-900">{book.title}</h3>
              <p class="mt-2 text-xs leading-relaxed text-slate-600">{book.desc}</p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
