---
import BaseLayout from '../layouts/BaseLayout.astro';
import CareerTimeline from '../components/CareerTimeline.jsx';
import NetworkCanvas from '../components/NetworkCanvas';
import { getCareerMilestones } from '../lib/db.js';
import { testimonials } from '../data/testimonials.js';

const careerData = getCareerMilestones();
const base = import.meta.env.BASE_URL;

const books = [
  { title: 'The Auditor’s Risk Compass', desc: 'Targeted industry frameworks for specialized audit and governance programs.', url: 'https://www.amazon.com/dp/B0H4S6JNHF', cover: `${base}images/books/auditors-risk-compass.jpg` },
  { title: 'The Blueprint of Operations', desc: 'Mastering 15 core business processes in the age of Agentic AI.', url: 'https://www.amazon.com/dp/B0GX33CDRF', cover: `${base}images/books/blueprint-of-operations.jpg` },
  { title: 'The Power Professional', desc: 'A tactical manual for dominance, strategy, and corporate authority.', url: 'https://www.amazon.com/dp/B0G51LS6D6', cover: `${base}images/books/power-professional.jpg` },
  { title: 'Handbook of Risk Red Flags in Restaurants', desc: "A practitioner's guide to preventing failure through early detection of risk indicators.", url: 'https://www.amazon.com/dp/B0GDTBRZPM', cover: `${base}images/books/risk-red-flags.jpg` },
  { title: 'The Un-Financial Risk Manager', desc: 'Protecting value in the real world — ESG, cyber, and emerging strategic risks.', url: 'https://www.amazon.com/dp/B0GDMW53GG', cover: `${base}images/books/unfinancial-risk-manager.jpg` },
  { title: '10 Forensic Accounting Skills', desc: 'Practical handbook on fraud detection, forensic investigation, and evidence management.', url: 'https://www.amazon.com/dp/B0G7T4X3RT', cover: `${base}images/books/forensic-accounting-skills.jpg` },
  { title: 'ITGC Program Guide', desc: 'A strategic approach to IT General Controls — security, compliance, and enterprise value protection.', url: 'https://www.amazon.com/dp/B0FCG96QS8', cover: `${base}images/books/itgc-program-guide.jpg` },
  { title: 'Internal Audit Guide for Dine-In Locations in the Middle East', desc: 'Comprehensive audit guide for restaurant operations in the GCC region.', url: 'https://www.amazon.com/dp/B0DY2NRPQ9', cover: `${base}images/books/internal-audit-dinein.jpg` },
];

const featuredBooks = books;

const alumniOf = [
  { '@type': 'Organization', name: 'Kitopi' },
  { '@type': 'Organization', name: 'Al-Faisaliah Group' },
  { '@type': 'Organization', name: "McDonald's" },
  { '@type': 'Organization', name: 'BMA Asset Management' },
  { '@type': 'Organization', name: 'Ernst & Young' },
  { '@type': 'Organization', name: 'KPMG' },
];

const employers = [
  { name: 'Veritux Consulting Network', alt: 'Veritux', src: `${base}images/logos/veritux.svg`, height: 'h-6 sm:h-7' },
  { name: 'Kitopi', alt: 'Kitopi', src: `${base}images/logos/kitopi.png`, height: 'h-6 sm:h-7' },
  { name: 'Al-Faisaliah Group', alt: 'Al-Faisaliah Group', src: `${base}images/logos/al-faisaliah.png`, height: 'h-7 sm:h-8' },
  { name: "McDonald's KSA", alt: "McDonald's", src: `${base}images/logos/mcdonalds.svg`, height: 'h-6 sm:h-7', label: "McDonald's" },
  { name: 'BMA Asset Management', alt: 'BMA Asset Management', src: `${base}images/logos/bma.png`, height: 'h-7 sm:h-8' },
  { name: 'Ernst & Young', alt: 'Ernst & Young', src: `${base}images/logos/ey.svg`, height: 'h-7 sm:h-8' },
  { name: 'KPMG', alt: 'KPMG', src: `${base}images/logos/kpmg.svg`, height: 'h-6 sm:h-7' },
];
---

<BaseLayout
  title="Career record | Majid Mumtaz"
  description="Employment history is on this page. Outcomes are on the case studies page."
>
  <script type="application/ld+json" is:inline set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'Person',
    name: 'Majid Mumtaz',
    alumniOf,
  })} />

  <section class="relative overflow-hidden px-4 pt-24 md:px-8 md:pt-28">
    <div class="editorial-panel relative mx-auto max-w-7xl overflow-hidden px-6 py-8 md:px-10 md:py-9">
      <NetworkCanvas client:load nodeCount={35} />
      <div class="relative z-10 grid gap-8 lg:grid-cols-[1fr_0.52fr] lg:items-end" data-reveal>
        <div>
          <h1 class="headline-display max-w-4xl text-[clamp(3rem,7vw,6.4rem)] font-black text-white">
            Career record.
          </h1>
          <p class="mt-8 max-w-3xl text-base leading-8 text-white/74 md:text-[1.15rem] md:leading-9">
            Employment history is on this page. Outcomes are on the case studies page.
          </p>
          <div class="mt-10 flex flex-wrap items-center gap-6">
            <a href={`${base}projects/`} class="text-sm font-semibold text-[#f4c98b] underline underline-offset-4">Case studies</a>
            <a href={`${base}cv/Majid_Mumtaz_Internal_Audit_GRC.pdf`} download class="text-sm font-semibold text-white/80 underline underline-offset-4">Download CV</a>
          </div>
        </div>
        <div class="hidden lg:block">
          <div class="overflow-hidden rounded-[28px] border border-white/12">
            <img
              src={`${base}images/majid-profile.jpg`}
              alt="Majid Mumtaz"
              class="h-[360px] w-full object-cover object-top"
              loading="eager"
            />
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="px-4 py-5 md:px-8">
    <div class="mx-auto max-w-7xl">
      <div class="soft-shell flex flex-col justify-between gap-6 px-6 py-5 md:px-8 md:py-6 lg:flex-row lg:items-center" data-reveal>
        <div class="shrink-0 text-[10px] font-black uppercase tracking-[0.28em] text-[#a33a21]">
          Employers and firms.
        </div>
        <div class="flex flex-wrap items-center justify-between gap-7 sm:justify-start sm:gap-10">
          {employers.map((employer) => (
            <div class="flex items-center gap-2.5" title={employer.name}>
              <img
                src={employer.src}
                alt={employer.alt}
                class={`${employer.height} w-auto object-contain transition-transform duration-300 hover:scale-105`}
                loading="lazy"
              />
              {employer.label && (
                <span class="hidden text-xs font-black tracking-wider text-[#181511] sm:inline">{employer.label}</span>
              )}
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="px-4 py-4 md:px-8">
    <div class="mx-auto max-w-7xl">
      <div class="soft-shell px-7 py-8 md:px-10 md:py-9" data-reveal>
          <span class="eyebrow-label">Biography</span>
          <h2 class="mt-4 text-[clamp(2.1rem,4.8vw,4rem)] leading-[1.02] text-[#181511]">Built to turn assurance into an executive instrument.</h2>
          <div class="luxury-divider mt-7 max-w-md"></div>
          <div class="mt-8 space-y-6 text-[color:var(--text-secondary)]">
            <p class="body-luxe">
              Architecting audit functions that protect capital. With 20+ years of experience, I design and lead internal audit departments from inception, establishing governance structures, automated control frameworks, and technical oversight—spanning KSA Vision 2030 giga-project oversight and Saudi Family Office charters—to deliver credible board assurance.
            </p>
            <p class="body-luxe">
              Core capabilities cluster into three domains: <strong class="text-[#181511]">IA function building</strong>, <strong class="text-[#181511]">forensic analytics and fraud detection</strong>, and <strong class="text-[#181511]">board assurance and IPO readiness</strong>.
            </p>
            <p class="body-luxe">
              Big-4 trained (EY, KPMG). Translating complex audit findings into decisive board action, eliminating compliance paperwork. Operating as a Registered Independent Consultant for Catalant and Veritux Consulting Network (Dubai), advising CFOs and Boards on governance architecture, fraud forensics, and control environments across KSA and the UAE. Delivering independent advisory and fractional Chief Audit Executive services globally.
            </p>
          </div>

          <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
            <div class="stat-plinth p-6">
              <div class="meta-label text-[#a33a21]">Credentials</div>
              <div class="mt-4 space-y-2 text-sm font-semibold text-[#181511]">
                <div>CIA (IIA)</div>
                <div>ACA (ICAEW UK)</div>
                <div>FCCA (ACCA UK)</div>
                <div>GRCP &amp; GRCA (OCEG)</div>
                <div>COSO ERM Certified</div>
              </div>
            </div>
            <div class="stat-plinth p-6">
              <div class="meta-label text-[#a33a21]">Background</div>
              <div class="mt-4 space-y-2 text-sm font-semibold text-[#181511]">
                <div>Ernst & Young</div>
                <div>KPMG</div>
                <div>McDonald's KSA</div>
                <div>Al Faisaliah Group</div>
                <div>Kitopi</div>
                <div>Veritux</div>
              </div>
            </div>
            <div class="stat-plinth p-6">
              <div class="meta-label text-[#a33a21]">Sectors</div>
              <div class="mt-4 space-y-2 text-sm font-semibold text-[#181511]">
                <div>F&B / Restaurants</div>
                <div>Hospitality</div>
                <div>Real Estate</div>
                <div>Retail</div>
                <div>Tech</div>
              </div>
            </div>
            <div class="stat-plinth p-6">
              <div class="meta-label text-[#a33a21]">Leadership</div>
              <div class="mt-4 space-y-2 text-sm font-semibold text-[#181511]">
                <div>Board & AC Reporting</div>
                <div>Three Lines of Defence</div>
                <div>Risk Appetite Frameworks</div>
                <div>Multi-Jurisdiction Programmes</div>
              </div>
            </div>
          </div>
      </div>
    </div>
  </section>

  <section class="px-4 py-4 md:px-8">
    <div class="soft-shell mx-auto max-w-7xl px-7 py-8 md:px-10 md:py-9">
      <div class="mb-10" data-reveal>
        <span class="eyebrow-label">Professional Trajectory</span>
        <h2 class="mt-4 text-[clamp(2rem,4.5vw,3.8rem)] leading-[1.02] text-[#181511]">Career trajectory.</h2>
        <p class="mt-5 max-w-2xl text-base leading-8 text-[color:var(--text-secondary)]">From Big 4 roots to group-level profit protection, transformation, and board advisory.</p>
      </div>
      <div class="relative group" data-reveal data-reveal-delay="1">
        <div class="overflow-x-auto pb-6 -mx-7 px-7 md:-mx-10 md:px-10">
          <div class="min-w-[800px] lg:min-w-0 editorial-panel border border-white/10 shadow-2xl">
            <CareerTimeline client:visible careerData={careerData} />
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="px-4 py-4 md:px-8">
    <div class="mx-auto max-w-7xl">
      <div class="mb-10" data-reveal>
        <span class="eyebrow-label">Executive Endorsements</span>
        <h2 class="mt-4 text-[clamp(2rem,4.5vw,3.8rem)] leading-[1.02] text-[#181511]">Board and executive feedback.</h2>
        <p class="mt-5 max-w-2xl text-base leading-8 text-[color:var(--text-secondary)]">Direct perspective from the C-suite, Audit Committees, and Senior Partners on the impact of my advisory work.</p>
      </div>
      <div class="grid gap-5 md:grid-cols-2">
        {testimonials.slice(0, 2).map((t, i) => (
          <div class="soft-shell p-8" data-reveal data-reveal-delay={String(i + 1)}>
            <div class="flex items-center gap-4 mb-6">
              <div class="h-12 w-12 rounded-full bg-[#1b1a17] text-white flex items-center justify-center font-bold text-xl">
                {t.name.charAt(0)}
              </div>
              <div>
                <div class="font-black text-[#181511]">{t.name}</div>
                <div class="text-[11px] font-bold uppercase tracking-[0.15em] text-slate-500 mt-1">{t.role}</div>
              </div>
            </div>
            <p class="text-sm leading-8 text-[color:var(--text-secondary)] italic">"{t.quote}"</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="px-4 py-4 md:px-8" id="books">
    <div class="mx-auto max-w-7xl">
      <div class="mb-10" data-reveal>
        <h2 class="text-[clamp(2rem,4.5vw,3.8rem)] leading-[1.02] text-[#181511]">Books.</h2>
      </div>
      <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {featuredBooks.map((book, i) => (
          <a href={book.url} target="_blank" rel="noopener noreferrer" class="glass-card flex gap-5 rounded-[30px] p-6" data-reveal data-reveal-delay={String((i % 3) + 1)}>
            <div class="w-24 flex-shrink-0 overflow-hidden rounded-[18px] bg-slate-100 aspect-[2/3]">
              <img src={book.cover} alt={book.title} class="h-full w-full object-cover" loading="lazy" />
            </div>
            <div class="flex min-w-0 flex-1 flex-col">
              <div class="meta-label text-[#a33a21]">Amazon</div>
              <h3 class="mt-3 text-lg leading-tight text-[#181511]">{book.title}</h3>
              <p class="mt-3 text-sm leading-7 text-[color:var(--text-secondary)]">{book.desc}</p>
            </div>
          </a>
        ))}
      </div>
      <div class="mt-8 flex justify-center">
        <a href="https://www.amazon.com/s?k=Majid+Mumtaz" target="_blank" rel="noopener noreferrer" class="btn-secondary">View More Writing</a>
      </div>
    </div>
  </section>
</BaseLayout>
