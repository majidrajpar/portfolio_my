---
import BaseLayout from '../layouts/BaseLayout.astro';
import CareerList from '../components/CareerList.astro';
import { getCareerMilestones } from '../lib/db.js';
import { tools } from '../data/tools.js';
import { testimonials } from '../data/testimonials.js';

const base = import.meta.env.BASE_URL;
const careerData = getCareerMilestones();

const outcomes = [
  {
    slug: 'audit-4-transformation',
    value: 'AED 7.7M',
    title: 'Recovered and protected',
    line: 'Full population. 100+ locations across 8 countries.',
    href: `${base}projects/audit-4-transformation/`,
  },
  {
    slug: 'ma-capital-protection',
    value: 'SAR 15M',
    title: 'Undisclosed exposure found before close',
    line: '$127M of committed capital defended.',
    href: `${base}projects/ma-capital-protection/`,
  },
  {
    slug: 'ipo-governance-readiness',
    value: 'Zero',
    title: 'Material weaknesses on the first ICFR opinion',
    line: '175+ controls in place for the listing.',
    href: `${base}projects/ipo-governance-readiness/`,
  },
  {
    slug: 'post-merger-integration-fnb-group',
    value: 'AED 22M',
    title: 'Acquired-outlet leakage',
    line: 'Not added to the AED 7.7M result.',
    href: `${base}projects/post-merger-integration-fnb-group/`,
  },
];

const featuredQuotes = testimonials.slice(0, 3);

const featuredTools = tools
  .filter((tool) => tool.tier === 'featured')
  .sort((a, b) => a.featuredOrder - b.featuredOrder);
---

<BaseLayout
  title="Majid Mumtaz | Director of Internal Audit & Risk | Dubai & GCC"
  description="CIA, ACA, FCCA certified Director of Internal Audit & Risk in Dubai. Board assurance, continuous controls monitoring (CCM), ICFR, and IPO readiness across UAE and GCC."
>
  <section class="relative overflow-hidden border-b border-slate-200 bg-white px-4 pt-28 pb-14 md:px-8">
    <svg class="pointer-events-none absolute left-0 top-16 hidden h-28 w-[34rem] md:block" viewBox="0 0 540 110" aria-hidden="true">
      <defs>
        <filter id="brush" x="-8%" y="-40%" width="116%" height="180%">
          <feTurbulence type="fractalNoise" baseFrequency="0.04" numOctaves="2" seed="4" result="noise" />
          <feDisplacementMap in="SourceGraphic" in2="noise" scale="7" />
        </filter>
      </defs>
      <g filter="url(#brush)" fill="none" stroke-linecap="round">
        <path d="M-10 58 C 90 18, 180 92, 340 46 S 470 22, 540 40" stroke="#9a3412" stroke-width="14" opacity="0.32" />
        <path d="M0 70 C 110 40, 200 96, 360 62" stroke="#1c1917" stroke-width="2.5" opacity="0.4" />
      </g>
    </svg>
    <svg class="pointer-events-none absolute bottom-3 left-6 hidden h-28 w-28 lg:block" viewBox="0 0 120 120" aria-hidden="true">
      <g fill="none" stroke="#1c1917" stroke-width="1" opacity="0.35">
        <circle cx="60" cy="60" r="46" />
        <path d="M60 8 V112 M8 60 H112" />
      </g>
    </svg>
    <svg class="pointer-events-none absolute right-6 top-20 hidden h-24 w-24 lg:block" viewBox="0 0 96 96" aria-hidden="true">
      <g fill="none" stroke="#1c1917" stroke-width="1" opacity="0.4">
        <path d="M8 8 H88 V88" />
        <path d="M88 8 A 80 80 0 0 1 8 88" />
      </g>
    </svg>
    <div class="relative mx-auto grid max-w-6xl gap-10 lg:grid-cols-[1.5fr_0.75fr] lg:items-center">
      <div>
        <p class="text-xs font-medium uppercase tracking-widest text-slate-500">
          Dubai &amp; GCC · CIA, ACA, FCCA
        </p>
        <h1 class="mt-4 max-w-3xl text-4xl font-semibold tracking-tight text-slate-900 sm:text-5xl leading-[1.06]">
          Majid Mumtaz
        </h1>
        <p class="mt-3 text-lg text-slate-800">
          Director of Internal Audit &amp; Risk
        </p>
        <p class="mt-4 max-w-2xl text-sm leading-6 text-slate-600">
          21 years across Big 4 (KPMG, EY) and GCC industry leadership (Kitopi, Al-Faisaliah, McDonald&apos;s KSA). Open to Chief Audit Executive (CAE) and Group Director of Internal Audit &amp; Risk roles across the UAE and GCC.
        </p>
        <p class="mt-4 max-w-2xl text-base font-medium leading-relaxed text-slate-900">
          AED 7.7M from the full population: AED 3.2M recovered and AED 4.5M protected.
        </p>
        <div class="mt-8 flex flex-wrap items-center gap-x-5 gap-y-3">
          <a href={`${base}projects/`} class="rounded-md bg-slate-900 px-4 py-2.5 text-xs font-medium text-white hover:bg-slate-800 transition-colors">
            Case studies
          </a>
          <a href={`${base}cv/Majid_Mumtaz_Internal_Audit_Director.pdf`} download class="text-sm font-semibold text-slate-900 underline underline-offset-4">
            CV (PDF)
          </a>
          <a href={`${base}contact/`} class="text-sm font-semibold text-slate-900 underline underline-offset-4">
            Contact
          </a>
          <button
            type="button"
            data-copy-email="majidrajpar@gmail.com"
            data-copy-location="hero"
            aria-label="Copy email address"
            class="rounded border border-slate-300 px-2.5 py-1 text-xs font-medium text-slate-700 hover:border-slate-900 hover:text-slate-900 transition-colors cursor-pointer"
          >
            Copy email
          </button>
        </div>
      </div>

      <div class="overflow-hidden rounded-lg border border-slate-200 bg-[#3c4450]">
        <img
          src={`${base}images/majid-profile-home.jpg`}
          alt="Majid Mumtaz"
          class="aspect-[4/5] w-full object-cover object-top"
          loading="eager"
        />
      </div>
    </div>
  </section>

  <section class="relative overflow-hidden border-b border-slate-200 bg-white px-4 py-14 md:px-8">
    <svg class="pointer-events-none absolute right-0 top-0 h-40 w-56" viewBox="0 0 220 150" aria-hidden="true">
      <g fill="none" stroke="#1c1917" stroke-width="1" opacity="0.35">
        <path d="M20 130 L200 20" />
        <circle cx="200" cy="20" r="16" />
        <path d="M200 4 V36 M184 20 H216" />
      </g>
    </svg>
    <div class="relative mx-auto max-w-6xl">
      <div class="grid gap-5 md:grid-cols-2 xl:grid-cols-4">
        {outcomes.map((outcome) => (
          <a href={outcome.href} data-event="home_case_click" data-slug={outcome.slug} class="flex h-full flex-col rounded-lg border border-slate-200 bg-white p-6 hover:border-slate-400 transition-colors">
            <div class="text-3xl font-semibold tracking-tight text-slate-900">{outcome.value}</div>
            <span class="mt-4 text-base leading-snug text-slate-900">{outcome.title}</span>
            <p class="mt-3 text-sm leading-6 text-slate-600">{outcome.line}</p>
          </a>
        ))}
      </div>
      <p class="mt-5 max-w-3xl text-sm leading-6 text-slate-500">
        AED 7.7M is the continuous-monitoring result. AED 22M is acquired-outlet leakage on the same food-tech population. The two figures are not added.
      </p>
    </div>
  </section>

  <section class="border-b border-slate-200 bg-white px-4 py-14 md:px-8" id="experience">
    <div class="mx-auto max-w-6xl">
      <div class="grid gap-10 lg:grid-cols-[1.4fr_0.8fr]">
        <div>
          <h2 class="text-2xl font-semibold tracking-tight text-slate-900">Career</h2>
        </div>
        <div>
          <h2 class="text-xs font-medium uppercase tracking-widest text-slate-500">Credentials</h2>
          <ul class="mt-4 space-y-2 text-sm font-medium text-slate-900">
            <li>CIA (IIA)</li>
            <li>ACA (ICAEW UK)</li>
            <li>FCCA (ACCA UK)</li>
            <li>GRCP &amp; GRCA (OCEG)</li>
            <li>COSO ERM Certified</li>
          </ul>
          <p class="mt-8 text-xs font-medium uppercase tracking-widest text-slate-500">Latest Publication</p>
          <a
            href="https://abmagazine.accaglobal.com/global/articles/2026/nov/technical/governance-lessons-from-a-crypto-heist.html"
            target="_blank"
            rel="noopener noreferrer"
            data-event="publication_click"
            data-slug="acca-ab-governance-lessons-crypto-heist"
            class="mt-2 block text-sm font-semibold text-slate-900 underline underline-offset-4 hover:text-slate-700"
          >
            Governance lessons from a crypto heist ↗
          </a>
          <p class="mt-1 text-xs text-slate-500">
            ACCA Accounting &amp; Business · Nov 2026 CPD Feature
          </p>
          <p class="mt-6 text-sm leading-6 text-slate-600">
            Commercial advisory is on <a href="https://theauditsignal.com" target="_blank" rel="noopener noreferrer" class="font-semibold text-slate-900 underline underline-offset-4">The Audit Signal</a>.
          </p>
        </div>
      </div>
      <div class="mt-10">
        <CareerList careerData={careerData} />
      </div>
    </div>
  </section>

  <section class="border-b border-slate-200 bg-white px-4 py-14 md:px-8" id="recommendations">
    <div class="mx-auto max-w-6xl space-y-6">
      <h2 class="text-2xl font-semibold tracking-tight text-slate-900">
        Recommendations
      </h2>
      <div class="grid gap-6 md:grid-cols-3">
        {featuredQuotes.map((t) => (
          <div class="flex h-full flex-col justify-between rounded-lg border border-slate-200 bg-white p-6">
            <p class="text-sm leading-relaxed text-slate-700">"{t.quote}"</p>
            <div class="mt-4 border-t border-slate-200 pt-3">
              <p class="text-sm font-semibold text-slate-900">{t.name}</p>
              <p class="text-xs text-slate-600">{t.role}</p>
              <p class="mt-0.5 text-[11px] text-slate-500">{t.context}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="border-b border-slate-200 bg-white px-4 py-14 md:px-8">
    <div class="mx-auto max-w-6xl">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <div>
          <p class="text-xs font-medium uppercase tracking-widest text-slate-500">Live Audit Software &amp; Guides</p>
          <h2 class="mt-2 text-2xl font-semibold tracking-tight text-slate-900">Built in-house. Runs in the browser.</h2>
          <p class="mt-2 max-w-2xl text-sm leading-6 text-slate-600">
            Four featured diagnostic engines from a catalog of 20+ self-built CCM, forensic, and governance tools.
          </p>
        </div>
        <div class="flex flex-wrap items-center gap-6">
          <a href={`${base}tools/`} class="text-sm font-semibold text-slate-900 underline underline-offset-4">
            All tools
          </a>
          <a href={`${base}trench-series/`} class="text-sm font-semibold text-slate-900 underline underline-offset-4">
            Field notes
          </a>
          <a href={`${base}resources/`} class="text-sm font-semibold text-slate-900 underline underline-offset-4">
            Library
          </a>
        </div>
      </div>

      <div class="mt-8 grid gap-5 md:grid-cols-2 xl:grid-cols-4">
        {featuredTools.map((tool) => (
          <a
            href={`${base}tools/${tool.id}/`}
            data-event="home_tool_click"
            data-slug={tool.id}
            class="flex h-full flex-col justify-between rounded-lg border border-slate-200 bg-white p-5 hover:border-slate-400 transition-colors"
          >
            <div>
              <p class="text-[11px] font-medium uppercase tracking-widest text-slate-500">{tool.domain}</p>
              <h3 class="mt-2 text-base font-semibold leading-snug text-slate-900">{tool.title}</h3>
              <p class="mt-2 text-sm leading-6 text-slate-600 line-clamp-3">{tool.description}</p>
            </div>
            <span class="mt-4 text-xs font-semibold text-slate-900 underline underline-offset-4">Launch tool →</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <script>
    const page = window as Window & { gtag?: (command: string, name: string, params: { slug: string }) => void; __homeRecallBound?: boolean };
    if (!page.__homeRecallBound) {
      page.__homeRecallBound = true;
      document.addEventListener('click', (event) => {
        const target = event.target;
        const element = target instanceof Element ? target : target instanceof Node ? target.parentElement : null;
        if (!element) return;
        const link = element.closest('a[data-event][data-slug]');
        if (!link) return;
        const name = link.getAttribute('data-event');
        const slug = link.getAttribute('data-slug');
        if ((name !== 'home_case_click' && name !== 'home_tool_click' && name !== 'publication_click') || !slug) return;
        if (typeof page.gtag !== 'function') return;
        page.gtag('event', name, { slug });
      });
    }
  </script>
</BaseLayout>
