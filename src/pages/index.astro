---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactForm from '../components/ContactForm';
import NetworkCanvas from '../components/NetworkCanvas';
import SubstackFeed from '../components/SubstackFeed';
import { getCaseStudies } from '../lib/db.js';

const featuredProjects = getCaseStudies().slice(0, 2);
const base = import.meta.env.BASE_URL;

const proofMetrics = [
  { value: '20+', label: 'Years leading audit, risk, and governance programmes' },
  { value: 'AED 7.7M', label: 'Recovered or protected in a single fraud engagement' },
  { value: '78%', label: 'Reduction in fraud incidents during a 340% transaction surge' },
];

const publications = [
  {
    outlet: 'Corporate Compliance Insights',
    date: 'August 2025',
    title: 'FCPA Compliance Programs Are Missing Important Nuances',
    summary: 'How bribery and compliance mechanisms actually operate within the Persian Gulf business context.',
    href: 'https://www.corporatecomplianceinsights.com/',
  },
  {
    outlet: 'Consultancy ME',
    date: 'January 2026',
    title: 'The Risk of Algorithmic Entropy',
    summary: 'When AI models age faster than evolving fraud, and why static algorithms become systemic risks.',
    href: 'https://www.consultancy-me.com/',
  },
  {
    outlet: 'IIA Internal Auditor',
    date: 'February 2026',
    title: 'Teaching an Algorithm to Filter False Flags',
    summary: 'How false positives were reduced significantly without losing operator trust in the model.',
    href: 'https://internalauditor.theiia.org/en/voices/2026/february/teaching-an-algorithm-to-filter-false-flags/',
  },
  {
    outlet: 'GRC Report',
    date: 'March 2026',
    title: "The CFO Is the Audit Independence Risk You're Not Managing",
    summary: 'Why the CFO relationship remains a structural independence risk even when governance charts imply otherwise.',
    href: 'https://www.grcreport.com/post/the-cfo-is-the-audit-independence-risk-youre-not-managing',
  },
  {
    outlet: 'GRC Report',
    date: 'April 2026',
    title: 'AI Authorization Is Not AI Accountability',
    summary: 'Board approval of AI does not solve accountability for what models decide in production.',
    href: 'https://www.grcreport.com/post/ai-authorization-is-not-ai-accountability',
  },
  {
    outlet: 'ACCA AB Magazine',
    date: 'May 2026',
    title: 'Keeping Risk Registers Relevant',
    summary: 'Why risk registers drift from operational reality and how to rebuild them as live intelligence rather than compliance artefacts.',
    href: 'https://www.accaglobal.com/gb/en/member/member/accounting-business.html',
  },
];

const publicationOutlets = [
  'IIA Internal Auditor',
  'GRC Report',
  'ACCA AB Magazine',
  'Corporate Compliance Insights',
  'Consultancy ME',
  'Substack: The Corporate Mercenary',
];

const featuredTestimonial = {
  quote: 'Majid brings credibility, integrity, and a genuine collaborative mindset to internal audit, and any organisation would benefit greatly from his leadership and expertise.',
  name: 'Sally Swanepoel',
  role: 'VP Finance, Kitopi',
};

const featuredPublications = publications.slice(0, 2);
---

<BaseLayout
  title="Majid Mumtaz | Chief Audit Executive — CIA, ACA, FCCA"
  description="Chief Audit Executive with 20+ years finding the operational and governance gaps businesses have not priced yet — fraud detection, board-grade assurance, and controls that actually close the risk they were built for."
>
  <section class="relative overflow-hidden px-4 pt-24 md:px-8 md:pt-28">
    <div class="absolute inset-0 pointer-events-none">
      <div class="absolute left-[6%] top-[10%] h-48 w-48 rounded-full bg-[#c7964c]/20 blur-3xl"></div>
      <div class="absolute right-[8%] top-[12%] h-56 w-56 rounded-full bg-[#a33a21]/18 blur-3xl"></div>
    </div>

    <div class="editorial-panel relative mx-auto max-w-7xl overflow-hidden px-6 py-7 md:px-10 md:py-8">
      <NetworkCanvas client:load nodeCount={42} />

      <div class="relative z-10 grid gap-8 lg:grid-cols-[1.48fr_0.82fr] lg:items-start">
        <div class="pt-4" data-reveal>
          <span class="hero-chip mb-8">Chief Audit Executive | CIA · ACA · FCCA</span>
          <h1 class="headline-display max-w-4xl text-[clamp(3.1rem,8vw,7.1rem)] font-black text-white">
            Audit leadership
            <span class="block text-[#f4c98b]">for when capital</span>
            <span class="block">is actually at risk.</span>
          </h1>
          <p class="mt-8 max-w-3xl text-base leading-8 text-white/74 md:text-[1.15rem] md:leading-9">
            Boards pay for assurance. Most receive compliance theatre. Twenty years building governance, fraud analytics, and reporting that still holds under scrutiny.
          </p>

          <div class="mt-10 flex flex-col gap-4 sm:flex-row sm:flex-wrap sm:items-center">
            <a href="#case-studies" class="btn-primary">See the Work</a>
            <a href={`${base}contact/`} class="btn-secondary-light">Get in Touch</a>
            <a href="https://majidmumtaz.substack.com" target="_blank" rel="noopener noreferrer" class="text-[10px] font-black uppercase tracking-[0.24em] text-white/62 transition-colors hover:text-white">Read Substack ↗</a>
          </div>

          <div class="luxury-divider mt-9 mb-6"></div>

          <div class="flex flex-wrap gap-3 md:max-w-3xl">
            {[
              'Open to CAE and Director roles globally',
              'Advisory through Catalant',
              'Population testing over sampled comfort',
              'Board-grade reporting built for action',
            ].map((item) => (
              <span class="rounded-full border border-white/12 bg-white/6 px-4 py-2 text-[10px] font-black uppercase tracking-[0.18em] text-white/78">
                {item}
              </span>
            ))}
          </div>
        </div>

        <div class="flex flex-col gap-4" data-reveal data-reveal-delay="2">
          <div class="frame-panel overflow-hidden p-0">
            <div class="relative">
              <img
                src={`${base}images/majid-profile-home.jpg`}
                alt="Majid Mumtaz — Director of Internal Audit"
                class="h-[320px] w-full object-cover object-top"
                loading="eager"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-black/75 via-black/12 to-transparent"></div>
              <div class="absolute left-0 right-0 top-0 px-5 py-4">
                <div class="inline-flex rounded-full border border-white/14 bg-black/20 px-3 py-1 text-[9px] font-black uppercase tracking-[0.24em] text-white/72">
                  Board-facing assurance
                </div>
              </div>
              <div class="absolute bottom-0 left-0 right-0 px-5 py-5">
                <div class="text-base font-black text-white">Majid Mumtaz</div>
                <div class="mt-1 text-[9px] font-black uppercase tracking-[0.26em] text-white/60">CIA · ACA · FCCA</div>
                <p class="mt-3 max-w-xs text-sm leading-6 text-white/72">
                  Built for audit committees, founder-led groups, and high-friction operating environments.
                </p>
              </div>
            </div>
          </div>

          <div class="frame-panel p-5 md:p-6">
            <div class="flex items-center justify-between gap-4 mb-1">
              <div class="meta-label text-[#f4c98b]">Selected Outcomes</div>
              <div class="h-px flex-1 bg-gradient-to-r from-[#c7964c]/50 to-transparent"></div>
            </div>
            <div class="mb-4 text-[9px] uppercase tracking-[0.18em] text-white/35">Career signal at a glance</div>
            <div class="grid gap-3">
              {proofMetrics.map((metric) => (
                <div class="rounded-[20px] border border-white/10 bg-black/10 px-4 py-4">
                  <div class="text-2xl font-black tracking-tight text-white">{metric.value}</div>
                  <div class="mt-2 text-[10px] uppercase tracking-[0.16em] text-white/52 leading-5">{metric.label}</div>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 1. CASE STUDIES — what has he done -->
  <section id="case-studies" class="px-4 py-4 md:px-8">
    <div class="mx-auto max-w-7xl">
      <div class="flex flex-col gap-8 md:flex-row md:items-end md:justify-between">
        <div class="max-w-3xl" data-reveal>
          <span class="eyebrow-label">Transformation Archive</span>
          <h2 class="mt-4 text-[clamp(2.1rem,5vw,4.4rem)] leading-[1.02] text-[#181511]">Client outcomes with operating weight.</h2>
        </div>
        <p class="max-w-lg text-base leading-8 text-[color:var(--text-secondary)]" data-reveal data-reveal-delay="1">
          Business problem first. Controls and reporting shaped around commercial reality.
        </p>
      </div>

      <div class="luxury-divider mt-8"></div>

      <div class="mt-10 grid gap-5 lg:grid-cols-2">
        {featuredProjects.map((project, i) => (
          <a
            href={`${base}projects/${project.slug}/`}
            class="group glass-card flex h-full flex-col rounded-[32px] p-7 lg:min-h-[340px]"
            data-reveal
            data-reveal-delay={String(i + 1)}
          >
            <div class="flex items-center justify-between gap-3">
              <div class="flex flex-wrap items-center gap-2">
                <span class="rounded-full bg-[#1d3557]/8 px-3 py-1 text-[10px] font-black uppercase tracking-[0.25em] text-[#1d3557]">
                  {project.categories?.[0] ?? project.category}
                </span>
                {project.industry && (
                  <span class="rounded-full bg-[#a33a21]/8 px-3 py-1 text-[10px] font-black uppercase tracking-[0.2em] text-[#a33a21]">
                    {project.industry}
                  </span>
                )}
              </div>
              {project.duration && (
                <span class="text-[10px] font-black uppercase tracking-[0.2em] text-slate-400 shrink-0">{project.duration}</span>
              )}
            </div>
            <h3 class="mt-6 text-xl leading-tight text-[#181511] transition-colors group-hover:text-[#a33a21]">
              {project.title}
            </h3>
            {project.impact && (
              <p class="mt-5 border-l-2 border-[#a33a21]/25 pl-4 text-sm leading-7 text-[color:var(--text-secondary)]">
                {project.impact}
              </p>
            )}
            <div class="mt-auto pt-8 text-[10px] font-black uppercase tracking-[0.3em] text-[#1d3557]">
              View Details
            </div>
          </a>
        ))}
      </div>

      <div class="mt-10 flex justify-center">
        <a href={`${base}projects/`} class="btn-primary">View All Projects</a>
      </div>
    </div>
  </section>

  <!-- 2. PUBLICATIONS & THOUGHT LEADERSHIP -->
  <section class="px-4 py-4 md:px-8">
    <div class="mx-auto max-w-7xl">
      <div class="mb-10 flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between" data-reveal>
        <div class="max-w-2xl">
          <span class="eyebrow-label">Publications & Insights</span>
          <h2 class="mt-4 text-[clamp(2.1rem,5vw,4.4rem)] leading-[1.02] text-[#181511]">Governance is a live argument, not a static deck.</h2>
        </div>
        <p class="max-w-lg text-base leading-8 text-[color:var(--text-secondary)]">
          Governance, fraud detection, and AI accountability argued in public. Read the latest analytical insights from my Substack newsletter, <em class="font-semibold text-[#a33a21]">The Corporate Mercenary</em>.
        </p>
      </div>

      <SubstackFeed client:load />

      <div class="mt-10 soft-shell p-6 md:p-8 flex flex-col gap-6 md:flex-row md:items-center md:justify-between" data-reveal>
        <div>
          <div class="meta-label text-[#a33a21]">Regularly Featured In</div>
          <div class="mt-4 flex flex-wrap gap-2">
            {publicationOutlets.map((outlet) => (
              <span class="rounded-full bg-[#1d3557]/8 px-3 py-1 text-[10px] font-black uppercase tracking-[0.18em] text-[#1d3557]">
                {outlet}
              </span>
            ))}
          </div>
        </div>
        <a href="https://majidmumtaz.substack.com/" target="_blank" rel="noopener noreferrer" class="btn-primary shrink-0 self-start md:self-auto">
          Read All on Substack
        </a>
      </div>
    </div>
  </section>

  <!-- 3. ABOUT BIO — deeper background -->
  <section class="px-4 py-4 md:px-8">
    <div class="mx-auto max-w-7xl" data-reveal>
      <div class="soft-shell px-7 py-8 md:px-10 md:py-9">
        <div class="grid gap-8 lg:grid-cols-[0.68fr_0.32fr] lg:items-start">
          <div>
            <span class="eyebrow-label">About</span>
            <h2 class="mt-4 text-[clamp(2rem,5vw,3.9rem)] leading-[1.03] text-[#181511]">Built for complex operating environments.</h2>
            <div class="luxury-divider mt-7 max-w-md"></div>
            <p class="mt-6 max-w-2xl text-base leading-8 text-[color:var(--text-secondary)]">
              Board-facing assurance for multi-brand, multi-country operating environments where sampled comfort is no longer enough.
            </p>
            <div class="mt-6 flex flex-wrap gap-4">
              <a href={`${base}about/`} class="btn-secondary">View Full Profile</a>
              <a href={`${base}cv/Majid-Mumtaz-CAE-CV.pdf`} class="btn-primary" download>Download CV</a>
            </div>
          </div>
          <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-1">
            <div class="stat-plinth p-5">
              <div class="meta-label text-[#a33a21]">Scope</div>
              <p class="mt-3 text-sm leading-7 text-[color:var(--text-secondary)]">Saudi Family Offices, KSA Vision 2030 giga-projects, holding groups, and pre-IPO environments.</p>
            </div>
            <div class="stat-plinth p-5">
              <div class="meta-label text-[#a33a21]">Proof</div>
              <p class="mt-3 text-sm leading-7 text-[color:var(--text-secondary)]">AED 7.7M recovered in one engagement from the 95% that sampling would have missed.</p>
            </div>
            <div class="quote-panel p-6 sm:col-span-2 lg:col-span-1">
              <div class="meta-label text-[#1d3557]">Recommendation</div>
              <p class="mt-4 text-base leading-8 text-[#1b1a17]">
                {featuredTestimonial.quote}
              </p>
              <div class="mt-5 border-t border-[color:var(--line-soft)] pt-4">
                <div class="text-sm font-black text-[#181511]">{featuredTestimonial.name}</div>
                <div class="mt-1 text-[11px] font-bold uppercase tracking-[0.15em] text-slate-500">{featuredTestimonial.role}</div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="px-4 py-4 pb-10 md:px-8">
    <div class="editorial-panel mx-auto max-w-7xl overflow-hidden px-6 py-8 md:px-10 md:py-9">
      <div class="grid gap-12 lg:grid-cols-[0.9fr_1.1fr]">
        <div data-reveal>
          <span class="meta-label text-[#f4c98b]">Contact</span>
          <h2 class="mt-4 text-[clamp(2.2rem,5vw,4rem)] leading-[1.02] text-white">The gap between legacy sampling and real-time assurance has a price.</h2>
          <p class="mt-6 max-w-xl text-base leading-8 text-white/70">
            I build the 100% population models that close it.
          </p>
          <div class="h-px max-w-sm bg-gradient-to-r from-[#c7964c]/60 to-transparent mt-8"></div>
          <div class="mt-8 space-y-3">
            <div class="text-[10px] font-black uppercase tracking-[0.26em] text-white/45">Primary Contact</div>
            <p class="max-w-md text-sm leading-7 text-white/72">Use the form to start the conversation. Direct email is available for follow-up if needed.</p>
            <a href="mailto:majidrajpar@gmail.com" class="inline-flex text-sm font-black text-white/88 hover:text-white transition-colors">majidrajpar@gmail.com</a>
          </div>
        </div>
        <div data-reveal data-reveal-delay="2">
          <ContactForm client:load />
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
