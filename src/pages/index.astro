---
import BaseLayout from '../layouts/BaseLayout.astro';
import NetworkCanvas from '../components/NetworkCanvas';
import { tools } from '../data/tools.js';

const base = import.meta.env.BASE_URL;

const outcomes = [
  {
    slug: 'audit-4-transformation',
    value: 'AED 7.7M',
    title: 'Audit 4.0: Shifting to 100% Population Testing',
    line: '100+ locations across 8 countries.',
    href: `${base}projects/audit-4-transformation/`,
  },
  {
    slug: 'ma-capital-protection',
    value: 'SAR 15M',
    title: 'M&A Capital Protection & High-Stakes Due Diligence',
    line: '$127M capital defended.',
    href: `${base}projects/ma-capital-protection/`,
  },
  {
    slug: 'whistleblowing-framework-qsr-leader',
    value: 'SAR 12M',
    title: 'Whistleblowing Framework (QSR Leader)',
    line: 'Uncovered SAR 12M procurement tender collusion within months of launch.',
    href: `${base}projects/whistleblowing-framework-qsr-leader/`,
  },
  {
    slug: 'ksa-real-estate-forensic-audit',
    value: 'SAR 3.2M / year',
    title: 'KSA Real Estate Forensic Audit',
    line: 'Recovered SAR 3.2M annually via automated risk engine.',
    href: `${base}projects/ksa-real-estate-forensic-audit/`,
  },
];

const featuredTools = tools
  .filter((tool) => tool.tier === 'featured')
  .sort((a, b) => a.featuredOrder - b.featuredOrder);
---

<BaseLayout
  title="Case studies and tools | Majid Mumtaz"
  description="Four outcomes are linked below. Four tools are linked under them."
>
  <section class="relative overflow-hidden px-4 pt-24 md:px-8 md:pt-28">
    <div class="editorial-panel relative mx-auto max-w-7xl overflow-hidden px-6 py-7 md:px-10 md:py-8">
      <NetworkCanvas client:load nodeCount={42} />

      <div class="relative z-10 grid gap-8 lg:grid-cols-[1.48fr_0.82fr] lg:items-center">
        <div class="pt-4" data-reveal>
          <span class="hero-chip mb-8">CIA · ACA · FCCA</span>
          <h1 class="headline-display max-w-4xl text-[clamp(3.1rem,8vw,7.1rem)] font-black text-white">
            Case studies and tools.
          </h1>
          <p class="mt-8 max-w-3xl text-base leading-8 text-white/74 md:text-[1.15rem] md:leading-9">
            Four outcomes are linked below. Four tools are linked under them.
          </p>
          <a href={`${base}projects/`} class="mt-10 inline-flex text-sm font-semibold text-[#f4c98b] underline underline-offset-4">
            Case studies
          </a>
        </div>

        <div data-reveal data-reveal-delay="2">
          <div class="frame-panel overflow-hidden p-0 rounded-[28px]">
            <img
              src={`${base}images/majid-profile-home.jpg`}
              alt="Majid Mumtaz"
              class="h-[360px] w-full object-cover object-top"
              loading="eager"
            />
            <div class="border-t border-white/8 bg-black/25 px-5 py-3">
              <span class="text-xs font-black text-white">Majid Mumtaz</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="px-4 py-8 md:px-8">
    <div class="mx-auto max-w-7xl">
      <div class="grid gap-5 md:grid-cols-2 xl:grid-cols-4">
        {outcomes.map((outcome) => (
          <a href={outcome.href} data-event="home_case_click" data-slug={outcome.slug} class="glass-card flex h-full flex-col rounded-[30px] p-6 md:p-7">
            <div class="text-3xl font-black tracking-tight text-[#181511]">{outcome.value}</div>
            <span class="mt-4 text-base leading-snug text-[#181511]">{outcome.title}</span>
            <p class="mt-3 text-sm leading-7 text-[color:var(--text-secondary)]">{outcome.line}</p>
          </a>
        ))}
      </div>
      <a href={`${base}projects/`} class="mt-8 inline-flex text-sm font-semibold text-[#181511] underline underline-offset-4">
        Case studies
      </a>
    </div>
  </section>

  <section class="px-4 pb-8 md:px-8">
    <div class="soft-shell mx-auto max-w-7xl px-6 py-2 md:px-8">
      {featuredTools.map((tool) => (
        <div class="flex flex-col gap-2 border-b border-[color:var(--line-soft)] py-4 last:border-b-0 sm:flex-row sm:items-baseline sm:justify-between sm:gap-6">
          <span class="meta-label shrink-0 text-[#8d6035]">{tool.domain}</span>
          <span class="min-w-0 flex-1 text-[#181511]">{tool.title}</span>
          <a href={`${base}tools/${tool.id}/`} data-event="home_tool_click" data-slug={tool.id} class="shrink-0 text-sm font-semibold text-[#181511] underline underline-offset-4">
            Open
          </a>
        </div>
      ))}
    </div>
    <div class="mx-auto max-w-7xl">
      <a href={`${base}tools/`} class="mt-8 inline-flex text-sm font-semibold text-[#181511] underline underline-offset-4">
        Tools
      </a>
    </div>
  </section>

  <section class="px-4 pb-16 md:px-8">
    <p class="body-luxe mx-auto max-w-7xl">
      <a href={`${base}advisory/`} class="font-semibold text-[#181511] underline underline-offset-4">Advisory</a> offers are IPO &amp; M&amp;A Guardrail, Audit 4.0 Transformation, and Fractional CAE &amp; Board Advisory.
    </p>
  </section>

  <script>
    const page = window as Window & { gtag?: (command: string, name: string, params: { slug: string }) => void; __homeRecallBound?: boolean };
    if (!page.__homeRecallBound) {
      page.__homeRecallBound = true;
      document.addEventListener('click', (event) => {
        const target = event.target;
        const element = target instanceof Element ? target : target instanceof Node ? target.parentElement : null;
        if (!element) return;
        const link = element.closest('a[data-event][data-slug]');
        if (!link) return;
        const name = link.getAttribute('data-event');
        const slug = link.getAttribute('data-slug');
        if ((name !== 'home_case_click' && name !== 'home_tool_click') || !slug) return;
        if (typeof page.gtag !== 'function') return;
        page.gtag('event', name, { slug });
      });
    }
  </script>
</BaseLayout>
