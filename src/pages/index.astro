---
import BaseLayout from '../layouts/BaseLayout.astro';
import NetworkCanvas from '../components/NetworkCanvas';
import CareerTimeline from '../components/CareerTimeline.jsx';
import { getCareerMilestones } from '../lib/db.js';
import { tools } from '../data/tools.js';
import { testimonials } from '../data/testimonials.js';

const base = import.meta.env.BASE_URL;
const careerData = getCareerMilestones();

const outcomes = [
  {
    slug: 'audit-4-transformation',
    value: 'AED 7.7M',
    title: 'Audit 4.0: Shifting to 100% Population Testing',
    line: '100+ locations across 8 countries.',
    href: `${base}projects/audit-4-transformation/`,
  },
  {
    slug: 'ma-capital-protection',
    value: 'SAR 15M',
    title: 'M&A Capital Protection & High-Stakes Due Diligence',
    line: '$127M capital defended.',
    href: `${base}projects/ma-capital-protection/`,
  },
  {
    slug: 'ipo-governance-readiness',
    value: '175+ controls',
    title: 'IPO Readiness & Governance Architecture',
    line: 'Zero material weaknesses on initial ICFR audit.',
    href: `${base}projects/ipo-governance-readiness/`,
  },
  {
    slug: 'post-merger-integration-fnb-group',
    value: '100+ Outlets',
    title: 'Post-Merger Integration & Controls Audit',
    line: '$300M+ acquisition & financial controls integration.',
    href: `${base}projects/post-merger-integration-fnb-group/`,
  },
];

const featuredTools = tools
  .filter((tool) => tool.tier === 'featured')
  .sort((a, b) => a.featuredOrder - b.featuredOrder);
---

<BaseLayout
  title="Majid Mumtaz | Director of Internal Audit & Risk | Dubai & GCC"
  description="CIA, ACA, FCCA certified Director of Internal Audit & Risk in Dubai. Board assurance, continuous controls monitoring (CCM), ICFR, and IPO readiness across UAE and GCC."
>
  <section class="relative overflow-hidden px-4 pt-24 md:px-8 md:pt-28">
    <div class="editorial-panel relative mx-auto max-w-7xl overflow-hidden px-6 py-7 md:px-10 md:py-8">
      <NetworkCanvas client:load nodeCount={42} />

      <div class="relative z-10 grid gap-8 lg:grid-cols-[1.48fr_0.82fr] lg:items-center">
        <div class="pt-4" data-reveal>
          <span class="hero-chip mb-6">Director of Internal Audit &amp; Risk · Dubai &amp; GCC · CIA · ACA · FCCA</span>
          <h1 class="headline-display max-w-4xl text-[clamp(2.9rem,6.8vw,5.8rem)] font-black text-white leading-[0.98]">
            Capital defense, internal controls &amp; continuous monitoring.
          </h1>
          <p class="mt-6 max-w-3xl text-base leading-8 text-slate-200 md:text-[1.1rem] md:leading-8">
            Replacing retrospective 20-invoice sampling with 100% automated population monitoring. Connecting trench-level operations—till receipts, delivery aggregator remittances, and recipe yields—directly to board-level EBITDA defense.
          </p>
          <div class="mt-8 flex flex-wrap items-center gap-4">
            <a href={`${base}projects/`} class="btn-primary">
              View Case Studies
            </a>
            <a href={`${base}tools/`} class="btn-secondary-light">
              Explore Tools
            </a>
            <a href={`${base}cv/Majid_Mumtaz_Internal_Audit_GRC.pdf`} download class="btn-secondary-light">
              Download CV (PDF)
            </a>
          </div>
        </div>

        <div data-reveal data-reveal-delay="2">
          <div class="frame-panel overflow-hidden p-0 rounded-[28px]">
            <img
              src={`${base}images/majid-profile-home.jpg`}
              alt="Majid Mumtaz"
              class="h-[360px] w-full object-cover object-top"
              loading="eager"
            />
            <div class="border-t border-white/8 bg-black/25 px-5 py-3">
              <span class="text-xs font-black text-white">Majid Mumtaz</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="px-4 py-8 md:px-8">
    <div class="mx-auto max-w-7xl">
      <div class="grid gap-5 md:grid-cols-2 xl:grid-cols-4">
        {outcomes.map((outcome) => (
          <a href={outcome.href} data-event="home_case_click" data-slug={outcome.slug} class="glass-card flex h-full flex-col rounded-[30px] p-6 md:p-7">
            <div class="text-3xl font-black tracking-tight text-[#181511]">{outcome.value}</div>
            <span class="mt-4 text-base leading-snug text-[#181511]">{outcome.title}</span>
            <p class="mt-3 text-sm leading-7 text-[color:var(--text-secondary)]">{outcome.line}</p>
          </a>
        ))}
      </div>
      <a href={`${base}projects/`} class="mt-8 inline-flex text-sm font-semibold text-[#181511] underline underline-offset-4">
        Case studies
      </a>
    </div>
  </section>

  <section class="px-4 pb-8 md:px-8">
    <div class="soft-shell mx-auto max-w-7xl px-6 py-2 md:px-8">
      {featuredTools.map((tool) => (
        <div class="flex flex-col gap-2 border-b border-[color:var(--line-soft)] py-4 last:border-b-0 sm:flex-row sm:items-baseline sm:justify-between sm:gap-6">
          <span class="meta-label shrink-0 text-[#8d6035]">{tool.domain}</span>
          <span class="min-w-0 flex-1 text-[#181511]">{tool.title}</span>
          <a href={`${base}tools/${tool.id}/`} data-event="home_tool_click" data-slug={tool.id} class="shrink-0 text-sm font-semibold text-[#181511] underline underline-offset-4">
            Open
          </a>
        </div>
      ))}
    </div>
    <div class="mx-auto max-w-7xl">
      <a href={`${base}tools/`} class="mt-8 inline-flex text-sm font-semibold text-[#181511] underline underline-offset-4">
        Tools
      </a>
    </div>
  </section>

  <section class="px-4 pb-8 md:px-8" id="experience">
    <div class="mx-auto max-w-7xl space-y-6">
      <div class="soft-shell px-7 py-8 md:px-10 md:py-9">
        <span class="eyebrow-label">About &amp; Experience</span>
        <h2 class="mt-4 text-[clamp(2rem,4.5vw,3.5rem)] leading-[1.04] text-[#181511]">
          Built to turn assurance into an executive instrument.
        </h2>
        <div class="luxury-divider mt-6 max-w-md"></div>

        <div class="mt-7 grid gap-8 lg:grid-cols-[1.4fr_0.8fr]">
          <div class="space-y-5 text-[color:var(--text-secondary)]">
            <p class="body-luxe">
              Architecting audit functions that protect capital. With 20+ years of experience across Big 4 (EY, KPMG) and GCC industry leadership (Kitopi, Al-Faisaliah Group, McDonald's KSA), I design and lead internal audit departments from inception—establishing governance structures, automated control frameworks, and technical oversight for VC-backed boards, family office conglomerates, and regional capital projects.
            </p>
            <div class="flex flex-wrap items-center gap-6 pt-2">
              <a
                href={`${base}cv/Majid_Mumtaz_Internal_Audit_GRC.pdf`}
                download
                class="text-sm font-semibold text-[#181511] underline underline-offset-4"
              >
                Download CV (PDF)
              </a>
              <a
                href="https://theauditsignal.com"
                target="_blank"
                rel="noopener noreferrer"
                class="text-sm font-semibold text-[#181511] underline underline-offset-4"
              >
                The Audit Signal (theauditsignal.com)
              </a>
            </div>
          </div>

          <div class="stat-plinth p-6">
            <div class="meta-label text-[#a33a21]">Credentials</div>
            <div class="mt-4 space-y-2 text-sm font-semibold text-[#181511]">
              <div>CIA (IIA)</div>
              <div>ACA (ICAEW UK)</div>
              <div>FCCA (ACCA UK)</div>
              <div>GRCP &amp; GRCA (OCEG)</div>
              <div>COSO ERM Certified</div>
            </div>
          </div>
        </div>
      </div>

      <div class="soft-shell px-7 py-8 md:px-10 md:py-9">
        <div class="mb-8">
          <span class="eyebrow-label">Professional Trajectory</span>
          <h3 class="mt-3 text-[clamp(1.75rem,3.6vw,2.75rem)] leading-[1.06] text-[#181511]">Career trajectory.</h3>
          <p class="mt-3 max-w-2xl text-sm leading-7 text-[color:var(--text-secondary)]">
            From Big 4 roots to group-level profit protection, transformation, and board advisory.
          </p>
        </div>
        <div class="overflow-x-auto pb-4 -mx-7 px-7 md:-mx-10 md:px-10">
          <div class="min-w-[800px] lg:min-w-0 editorial-panel border border-white/10 shadow-2xl">
            <CareerTimeline client:visible careerData={careerData} />
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="px-4 py-14 md:px-8" id="recommendations">
    <div class="mx-auto max-w-7xl space-y-6">
      <div>
        <span class="eyebrow-label">Recommendations</span>
        <h2 class="mt-3 text-2xl font-semibold tracking-tight text-slate-900 sm:text-3xl">
          From Leaders &amp; Stakeholders
        </h2>
      </div>
      <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {testimonials.map((t) => (
          <div class="glass-card rounded-lg p-6 flex flex-col justify-between space-y-4">
            <p class="text-sm leading-relaxed text-slate-700">"{t.quote}"</p>
            <div class="border-t border-slate-200 pt-3">
              <p class="text-sm font-semibold text-slate-900">{t.name}</p>
              <p class="text-xs text-slate-600">{t.role}</p>
              <p class="text-[11px] text-slate-500 mt-0.5">{t.context}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <script>
    const page = window as Window & { gtag?: (command: string, name: string, params: { slug: string }) => void; __homeRecallBound?: boolean };
    if (!page.__homeRecallBound) {
      page.__homeRecallBound = true;
      document.addEventListener('click', (event) => {
        const target = event.target;
        const element = target instanceof Element ? target : target instanceof Node ? target.parentElement : null;
        if (!element) return;
        const link = element.closest('a[data-event][data-slug]');
        if (!link) return;
        const name = link.getAttribute('data-event');
        const slug = link.getAttribute('data-slug');
        if ((name !== 'home_case_click' && name !== 'home_tool_click') || !slug) return;
        if (typeof page.gtag !== 'function') return;
        page.gtag('event', name, { slug });
      });
    }
  </script>
</BaseLayout>
