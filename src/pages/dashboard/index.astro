---
import LibraryLayout from '../../layouts/LibraryLayout.astro';
import LibraryWorkbench from '../../components/LibraryWorkbench';
---

<LibraryLayout title="Practitioner Library | Majid Mumtaz">
  <section class="mb-8 flex flex-col gap-4 border-b border-slate-200 pb-6 sm:flex-row sm:items-end sm:justify-between">
    <div class="space-y-1.5">
      <p class="text-xs font-medium uppercase tracking-wider text-slate-500">
        Majid Mumtaz · CIA · ACA · FCCA · GRCP · GRCA · COSO ERM
      </p>
      <h1 class="text-2xl font-semibold tracking-tight text-slate-900 sm:text-3xl">
        Professional Portfolio &amp; Practitioner Workbench
      </h1>
      <p class="max-w-2xl text-sm leading-relaxed text-slate-600">
        Case studies, institutional audit models, interactive telemetry tools, RoleForge, and governance frameworks.
      </p>
    </div>
    <div class="flex shrink-0 items-center gap-3">
      <a
        href="/portfolio_my/cv/Majid_Mumtaz_Director_Internal_Audit_GRC_UAE.pdf"
        target="_blank"
        rel="noopener noreferrer"
        class="rounded-md bg-slate-900 px-3.5 py-2 text-xs font-medium text-white hover:bg-slate-800 transition-colors"
      >
        Download CV (PDF)
      </a>
    </div>
  </section>

  <LibraryWorkbench client:load />
</LibraryLayout>
