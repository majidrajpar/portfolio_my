---
import BaseLayout from '../layouts/BaseLayout.astro';
import NetworkCanvas from '../components/NetworkCanvas';
import { getAdvisoryTiers } from '../lib/db.js';

const advisoryTiers = getAdvisoryTiers();
const base = import.meta.env.BASE_URL;
---

<BaseLayout
  title="Executive Advisory | Majid Mumtaz — Strategic Internal Audit"
  description="Director-level advisory services: IPO readiness, M&A protection, Audit 4.0 transformation, and retained CAE board advisory for boards and leadership teams globally."
>
  <section class="relative overflow-hidden px-4 pt-24 md:px-8 md:pt-28">
    <div class="editorial-panel relative mx-auto max-w-7xl overflow-hidden px-6 py-8 text-center md:px-10 md:py-9">
      <NetworkCanvas client:load nodeCount={35} />
      <div class="relative z-10 mx-auto max-w-4xl" data-reveal>
        <span class="hero-chip mb-8">Strategic Advisory</span>
        <h1 class="headline-display text-[clamp(3rem,7vw,6.4rem)] font-black text-white">
          Augmenting
          <span class="block text-[#f4c98b]">governance</span>
          <span class="block">when it matters most.</span>
        </h1>
        <p class="mt-8 mx-auto max-w-3xl text-base leading-8 text-white/74 md:text-[1.1rem] md:leading-9">
          Deploying technical depth and independent, board-grade validation for organizations that cannot build capabilities fast enough in-house.
        </p>
      </div>
    </div>
  </section>

  <!-- 0. METHODOLOGY / FRAMEWORK -->
  <section class="px-4 py-8 md:px-8">
    <div class="mx-auto max-w-7xl">
      <div class="soft-shell p-8 md:p-12 border-l-4 border-[#a33a21]" data-reveal>
        <span class="eyebrow-label">The Advisory Methodology</span>
        <h2 class="mt-4 text-[clamp(2rem,4vw,3.2rem)] leading-[1.05] text-[#181511]">Driven by a 3-pillar framework.</h2>
        <div class="mt-6 grid gap-8 md:grid-cols-2 lg:grid-cols-3">
          <div>
            <div class="font-black text-[#181511] text-lg">01. 100% Population Analysis</div>
            <p class="mt-2 text-sm leading-7 text-[color:var(--text-secondary)]">Replacing the illusion of sampled comfort with full dataset interrogation. Identifying the anomalies and operational friction that traditional sampling always misses.</p>
          </div>
          <div>
            <div class="font-black text-[#181511] text-lg">02. AI-Enabled Automation</div>
            <p class="mt-2 text-sm leading-7 text-[color:var(--text-secondary)]">Integrating continuous monitoring algorithms into the audit posture. Filtering false flags and tracking evolving risks in real-time.</p>
          </div>
          <div>
            <div class="font-black text-[#181511] text-lg">03. Board-Grade Action</div>
            <p class="mt-2 text-sm leading-7 text-[color:var(--text-secondary)]">Converting complex forensic findings into clear, decisive reporting designed for immediate executive and Audit Committee decision-making.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="px-4 py-4 md:px-8">
    <div class="mx-auto max-w-7xl space-y-6">
      {advisoryTiers.map((tier, i) => (
        <div class="glass-card overflow-hidden rounded-[34px]" data-reveal data-reveal-delay={String(i + 1)}>
          <div class="grid lg:grid-cols-[0.9fr_1.1fr]">
            <div class="editorial-panel px-8 py-8 md:px-10">
              <div class="relative z-10 flex h-full flex-col justify-between">
                <div>
                  <div class="flex items-center gap-4 mb-8">
                    <div class="flex h-12 w-12 items-center justify-center rounded-full bg-white/10 text-white border border-white/10">
                      <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={tier.icon}/>
                      </svg>
                    </div>
                    <span class="meta-label text-[#f4c98b]">Tier 0{i + 1}</span>
                  </div>
                  <h2 class="text-3xl leading-tight text-white">{tier.name}</h2>
                  <p class="mt-3 text-[11px] font-black uppercase tracking-[0.24em] text-white/46">{tier.tagline}</p>
                </div>
                <div class="mt-10">
                  <a href={`${base}contact/`} class="btn-secondary-light">Discuss a Mandate</a>
                </div>
              </div>
            </div>

            <div class="soft-shell rounded-none px-8 py-8 md:px-10">
              <p class="body-luxe max-w-3xl">{tier.description}</p>
              <div class="mt-8 grid gap-5 md:grid-cols-[1.1fr_0.9fr]">
                <div class="stat-plinth p-6">
                  <div class="meta-label text-[#a33a21]">Core Deliverables</div>
                  <ul class="mt-4 space-y-3">
                    {tier.deliverables.map((item) => (
                      <li class="flex items-start gap-3 text-sm font-semibold leading-7 text-[#181511]">
                        <span class="mt-2 h-1.5 w-1.5 flex-shrink-0 rounded-full bg-[#c7964c]"></span>
                        {item}
                      </li>
                    ))}
                  </ul>
                </div>
                <div class="quote-panel p-6">
                  <div class="meta-label text-[#1d3557]">Ideal Engagement Context</div>
                  <p class="mt-4 text-sm leading-8 text-[#1b1a17]">{tier.idealFor}</p>
                </div>
              </div>
            </div>
          </div>
        </div>
      ))}
    </div>
  </section>

  <section class="px-4 py-4 md:px-8">
    <div class="soft-shell mx-auto max-w-7xl px-7 py-8 md:px-10 md:py-9" data-reveal>
      <div class="grid gap-8 lg:grid-cols-[1.2fr_0.8fr] lg:items-center">
        <div>
          <span class="eyebrow-label">How Engagements Work</span>
          <h2 class="mt-4 text-[clamp(1.8rem,3.5vw,3rem)] leading-[1.05] text-[#181511]">Structure before scope.</h2>
          <p class="body-luxe mt-5 max-w-2xl">
            Engagements typically run 3 to 6 months, structured around defined deliverables: completed audit plans, validated control environments, transaction diligence workstreams, or quarterly retained advisory cycles. All mandates are executed directly by senior leadership—never delegated to a junior layer.
          </p>
          <p class="body-luxe mt-4 max-w-2xl">
            Mandates commence with a rigorous scoping phase. Following alignment, a statement of work is issued within one week. Zero retainers accepted prior to scope lock.
          </p>
        </div>
        <div class="grid gap-4">
          {[['3–6 months', 'Typical engagement duration'], ['Direct execution', 'No delegation to juniors'], ['Defined deliverable', 'Scope agreed before engagement starts'], ['Board-grade output', 'Findings structured for executive and AC use']].map(([stat, label]) => (
            <div class="stat-plinth p-5 flex items-center gap-5">
              <div class="text-xl font-black text-[#a33a21] leading-none min-w-[100px]">{stat}</div>
              <div class="text-sm text-[color:var(--text-secondary)] leading-6">{label}</div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="px-4 py-4 md:px-8">
    <div class="editorial-panel mx-auto max-w-7xl px-7 py-8 md:px-10 md:py-9">
      <div class="grid gap-8 lg:grid-cols-[1fr_0.92fr]">
        <div data-reveal>
          <span class="meta-label text-[#f4c98b]">Why Independent</span>
          <h2 class="mt-4 text-[clamp(2rem,4.5vw,3.8rem)] leading-[1.02] text-white">Independent judgment, board-grade output.</h2>
          <p class="mt-6 max-w-2xl text-base leading-8 text-white/70">
            Large firms deploy bloated teams. This model delivers direct, senior-level judgment from an operator who has built functions from zero, scaled them, and navigated the structural realities that generic methodologies ignore.
          </p>
          <div class="mt-8 grid gap-4 sm:grid-cols-2">
            <div class="frame-panel p-6">
              <div class="meta-label text-[#f4c98b]">Direct Board Accountability</div>
              <p class="mt-4 text-sm leading-8 text-white/70">Eliminating the junior relay layer. Work directly with a senior operator fluent in audit committee expectations, executive tension, and high-stakes control design.</p>
            </div>
            <div class="frame-panel p-6">
              <div class="meta-label text-[#f4c98b]">Tech-Enabled Methodology</div>
              <p class="mt-4 text-sm leading-8 text-white/70">Deploying Python-driven tooling, analytics-first testing, and 100% population-based approaches designed for sustained utility post-engagement.</p>
            </div>
          </div>
        </div>

        <div class="frame-panel p-7 text-center" data-reveal data-reveal-delay="1">
          <div class="text-6xl font-black leading-none text-[#f4c98b]">20+</div>
          <div class="mt-3 meta-label text-white/40">Years Experience</div>
          <div class="mt-8 flex flex-wrap justify-center gap-2">
            {['CIA', 'ACA', 'FCCA', 'COSO ERM'].map((cert) => (
              <span class="hero-chip">{cert}</span>
            ))}
          </div>
          <div class="mt-10">
            <a href={`${base}contact/`} class="btn-primary">Discuss a Mandate</a>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
