---
import BaseLayout from '../layouts/BaseLayout.astro';
import NetworkCanvas from '../components/NetworkCanvas';
import { roleforgeStats, freeRoles } from '../data/roleforge.js';

const base = import.meta.env.BASE_URL;

const domainMeta = [
  { id: 'audit',     label: 'Audit',      count: 6, color: 'bg-[#3a1913] text-[#f1b5a2]', desc: 'Internal audit, IT audit, forensic, compliance, report writing, BI analysis' },
  { id: 'risk',      label: 'Risk',       count: 5, color: 'bg-[#40250f] text-[#f3cf9b]', desc: 'Enterprise risk, credit risk, market quant, operational risk, scenario modeling' },
  { id: 'governance',label: 'Governance', count: 4, color: 'bg-[#1f253a] text-[#c8d2f8]', desc: 'Board liaison, governance analysis, ethics, data governance' },
  { id: 'philosophy',label: 'Philosophy', count: 4, color: 'bg-[#2f223f] text-[#d7c3f4]', desc: 'Ethics, epistemology, logic, history of philosophy' },
  { id: 'creative',  label: 'Creative',   count: 4, color: 'bg-[#17302e] text-[#b7e2db]', desc: 'Narrative, character development, world-building, dialogue' },
  { id: 'book',      label: 'Book',       count: 3, color: 'bg-[#293038] text-[#d4dee8]', desc: 'Project management, copy editing, developmental editing' },
  { id: 'data',      label: 'Data',       count: 5, color: 'bg-[#181512] text-[#f4c98b]', desc: 'Data science, storytelling, ML engineering, statistical review, visualization' },
];
---

<BaseLayout
  title="RoleForge | AI Agent Role Library"
  description="Production-grade YAML agent roles for CrewAI, LangChain & LangGraph. 31 validated personas across audit, risk, governance, and creative domains."
>

  <!-- HERO -->
  <section class="relative overflow-hidden px-4 pt-24 md:px-8 md:pt-28">
    <div class="editorial-panel relative mx-auto max-w-7xl overflow-hidden px-6 py-10 md:px-10 md:py-12">
      <NetworkCanvas client:load nodeCount={40} />
      <div class="relative z-10 grid gap-8 lg:grid-cols-[1.35fr_0.85fr] lg:items-end lg:gap-10">
        <div data-reveal>
          <span class="hero-chip mb-6 sm:mb-8">AI Agent Role Library</span>
          <h1 class="headline-display max-w-4xl text-[clamp(3rem,7vw,6rem)] font-black text-white">
            RoleForge
          </h1>
          <p class="mt-6 max-w-3xl text-[15px] leading-7 text-white/74 md:mt-8 md:text-[1.12rem] md:leading-9">
            Role library. No checkout on this site.
          </p>
        </div>
        <div class="quote-panel p-6 md:p-8" data-reveal data-reveal-delay="1">
          <span class="eyebrow-label text-[#f4c98b]/80">What You Get</span>
          <div class="mt-4 space-y-4 text-sm leading-7 text-white/72 md:mt-5 md:space-y-5">
            <p><strong class="text-white">{roleforgeStats.roles}</strong> validated roles across <strong class="text-white">{roleforgeStats.domains}</strong> domains</p>
            <p><strong class="text-white">{roleforgeStats.overlays}</strong> framework-specific overlays</p>
            <p><strong class="text-white">{roleforgeStats.tests}</strong> tests, JSON Schema validation</p>
            <p>Core engine free under Elastic License 2.0</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- FREE CORE -->
  <section class="px-4 py-5 md:px-8">
    <div class="soft-shell mx-auto max-w-7xl px-6 py-8 md:px-10 md:py-10" data-reveal>
      <div class="mb-8 flex flex-col gap-6 lg:flex-row lg:items-start lg:justify-between">
        <div>
          <h2 class="text-[clamp(2rem,4vw,3.2rem)] leading-[1.05] text-[#181511]">Core engine + starter roles.</h2>
          <p class="body-luxe mt-4 max-w-2xl">
            The role loader, validators, and adapters are free and open-source.
          </p>
        </div>
        <div class="flex flex-col gap-3 lg:items-end">
          <a href="https://github.com/majidrajpar/roleforge" target="_blank" rel="noopener" class="btn-secondary inline-flex">
            <svg class="mr-2 h-4 w-4" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.084 8.199-11.386 0-6.627-5.373-12-12-12z"/>
            </svg>
            View on GitHub
          </a>
          <p class="text-xs text-[color:var(--text-secondary)]">Elastic License 2.0</p>
        </div>
      </div>

      <div class="grid gap-5 md:grid-cols-3">
        {freeRoles.map((role, i) => (
          <div class="stat-plinth" data-reveal data-reveal-delay={String(i + 1)}>
            <span class="meta-label text-[#a33a21]">{role.category}</span>
            <div class="mt-3 text-2xl font-black text-[#181511]">{role.name}</div>
            <p class="mt-2 text-sm leading-7 text-[color:var(--text-secondary)]">YAML definition + overlays + validation</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- DOMAIN GRID -->
  <section class="px-4 py-4 md:px-8">
    <div class="mx-auto max-w-7xl">
      <div class="mb-10 flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between" data-reveal>
        <div>
          <span class="eyebrow-label">Domains</span>
          <h2 class="mt-4 text-[clamp(2rem,4.6vw,3.8rem)] leading-[1.02] text-[#181511]">7 professional domains.</h2>
        </div>
        <p class="body-luxe max-w-2xl">Each domain includes validated roles with framework-specific overlays for CrewAI, LangChain, and LangGraph.</p>
      </div>
      <div class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
        {domainMeta.map((domain, i) => (
          <div 
            class="glass-card group flex h-full flex-col rounded-[30px] p-6 transition-all duration-300 md:p-8"
            data-reveal
            data-reveal-delay={String((i % 4) + 1)}
          >
            <div class="mb-5 flex items-start justify-between">
              <span class={`inline-flex px-3 py-1 text-[10px] font-black uppercase tracking-[0.2em] ${domain.color}`}>
                {domain.count} roles
              </span>
            </div>
            <h3 class="text-[1.28rem] leading-tight text-[#181511] transition-colors group-hover:text-[#8d6035] md:text-[1.45rem]">{domain.label}</h3>
            <p class="mt-4 flex-1 text-sm leading-7 text-[color:var(--text-secondary)] md:leading-8">{domain.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="px-4 py-4 pb-12 md:px-8">
    <div class="soft-shell mx-auto max-w-7xl px-6 py-8 md:px-10 md:py-10" data-reveal>
      <span class="eyebrow-label">FAQ</span>
      <h2 class="mt-4 text-[clamp(2rem,4.6vw,3.8rem)] leading-[1.02] text-[#181511]">Common questions.</h2>

      <div class="mt-8">
        <div class="glass-card max-w-3xl rounded-[24px] p-6">
          <h3 class="text-lg font-black leading-snug text-[#181511]">What frameworks are supported?</h3>
          <p class="mt-4 text-sm leading-7 text-[color:var(--text-secondary)]">CrewAI, LangChain, and LangGraph. Each role includes framework-specific overlays that optimize prompts and tool bindings for that runtime.</p>
        </div>
      </div>

      <p class="mt-8">
        <a href={`${base}software/`} class="text-sm font-semibold text-[#181511] underline underline-offset-4">Builds</a>
      </p>
    </div>
  </section>
</BaseLayout>
