---
import BaseLayout from '../../layouts/BaseLayout.astro';
import DeficiencyExposureCalculator from '../../components/DeficiencyExposureCalculator';
import NetworkCanvas from '../../components/NetworkCanvas';
const base = import.meta.env.BASE_URL;

const title = "Internal Control Deficiency Exposure Calculator | SOX & ICOFR | Majid Mumtaz";
const description = "Quantify dollar exposure from internal control deficiencies, significant deficiencies, and material weaknesses. Calculate balance sheet risk and detection delay multipliers.";

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "SoftwareApplication",
      "name": "Control Deficiency Exposure Calculator",
      "operatingSystem": "Web Browser",
      "applicationCategory": "BusinessApplication",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "USD"
      },
      "description": "Financial exposure quantification calculator translating internal control failures, design gaps, and operating deviations into balance sheet risk metrics."
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "How is financial exposure calculated from a control deficiency?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Exposure is calculated by multiplying the transaction volume flowing through the affected process by the observed control failure rate, adjusted by detection delay (duration the control remained compromised) and compensating control effectiveness."
          }
        },
        {
          "@type": "Question",
          "name": "Why do Audit Committees require quantified dollar exposure for audit findings?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Abstract audit ratings (e.g., 'High Risk' or 'Needs Improvement') often fail to trigger executive action. Translating control breakdowns into quantified cash leakage or balance sheet exposure enables Audit Committees to prioritize remediation and evaluate materiality thresholds under SOX 404 and ISA 265."
          }
        }
      ]
    }
  ]
};
---

<BaseLayout title={title} description={description}>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />

  <!-- Hero -->
  <section class="relative overflow-hidden px-4 pt-24 md:px-8 md:pt-28">
    <div class="editorial-panel relative mx-auto max-w-7xl overflow-hidden px-6 py-10 md:px-10 md:py-12">
      <NetworkCanvas client:load nodeCount={35} />
      <div class="relative z-10 max-w-4xl" data-reveal>
        <a href={`${base}tools/`} class="mb-7 inline-flex text-[11px] font-black uppercase tracking-[0.28em] text-white/58 transition-colors hover:text-white">
          &larr; Back to Tools
        </a>
        <span class="hero-chip mb-6 md:mb-7">Internal Controls &amp; Exposure Sizing</span>
        <h1 class="headline-display max-w-4xl text-[clamp(2.8rem,6vw,5rem)] font-black text-white">
          Control Deficiency
          <span class="block text-[#f4c98b]">Exposure Calculator.</span>
        </h1>
        <p class="mt-6 max-w-3xl text-[15px] leading-7 text-white/74 md:mt-8 md:text-[1.08rem] md:leading-9">
          Translate operational and financial control gaps into hard dollar figures. Calculate cascading balance-sheet exposure based on failure rates and detection delays.
        </p>
      </div>
    </div>
  </section>

  <!-- Privacy Banner -->
  <section class="px-4 py-5 md:px-8">
    <div class="soft-shell mx-auto flex max-w-7xl items-start gap-3 px-5 py-5 md:px-7" data-reveal>
      <svg class="mt-0.5 h-4 w-4 flex-shrink-0 text-[#c7964c]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
      </svg>
      <p class="text-sm leading-7 text-[color:var(--text-secondary)]">
        <span class="meta-label text-[#181511]">100% Client-Side Privacy</span>
        Revenue figures, domain parameters, and computed values at risk remain strictly on your local device. Zero data egress.
      </p>
    </div>
  </section>

  <section class="px-4 md:px-8">
    <p class="mx-auto max-w-7xl text-sm leading-7 text-[color:var(--text-secondary)]">
      Model potential dollar exposure from operational and financial control gaps using empirical failure rates and delayed remediation factors.
    </p>
  </section>

  <!-- Tool -->
  <section class="px-4 py-4 pb-20 md:px-8">
    <div class="mx-auto max-w-7xl" data-reveal data-reveal-delay="1">
      <div class="soft-shell p-6 md:p-10">
        <DeficiencyExposureCalculator client:load />
      </div>
    </div>
  </section>
</BaseLayout>
