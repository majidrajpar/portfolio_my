---
import BaseLayout from '../../layouts/BaseLayout.astro';
import FraudRiskCalculator from '../../components/FraudRiskCalculator.jsx';
import NetworkCanvas from '../../components/NetworkCanvas';
const base = import.meta.env.BASE_URL;
---

<BaseLayout
  title="Fraud Risk Calculator | Majid Mumtaz"
  description="A browser-based fraud risk assessment tool built on the Fraud Triangle and COSO framework. Score your organisation across Opportunity, Pressure, Rationalization, and Control Environment to receive an instant, ML-powered risk rating."
>

  <!-- Hero -->
  <section class="relative overflow-hidden px-4 pt-24 md:px-8 md:pt-28">
    <div class="editorial-panel relative mx-auto max-w-7xl overflow-hidden px-6 py-10 md:px-10 md:py-12">
      <NetworkCanvas client:load nodeCount={35} />
      <div class="relative z-10 max-w-4xl" data-reveal>
        <a href={`${base}tools/`} class="mb-7 inline-flex text-[11px] font-black uppercase tracking-[0.28em] text-white/58 transition-colors hover:text-white">
          &larr; Back to Tools
        </a>
        <span class="hero-chip mb-6 md:mb-7">Fraud & Forensics</span>
        <h1 class="headline-display max-w-4xl text-[clamp(2.8rem,6vw,5rem)] font-black text-white">
          Fraud Risk
          <span class="block text-[#f4c98b]">Calculator.</span>
        </h1>
        <p class="mt-6 max-w-3xl text-[15px] leading-7 text-white/74 md:mt-8 md:text-[1.08rem] md:leading-9">
          Answer 20 diagnostic questions across the four pillars of the Fraud Triangle and receive an instant, ML-scored fraud vulnerability rating — with domain scores, radar analysis, and prioritised recommendations.
        </p>
      </div>
    </div>
  </section>

  <!-- Privacy Banner -->
  <section class="px-4 py-5 md:px-8">
    <div class="soft-shell mx-auto flex max-w-7xl items-start gap-3 px-5 py-5 md:px-7" data-reveal>
      <svg class="mt-0.5 h-4 w-4 flex-shrink-0 text-[#c7964c]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
      </svg>
      <p class="text-sm leading-7 text-[color:var(--text-secondary)]">
        <span class="meta-label text-[#181511]">100% Client-Side Privacy</span>
        All evaluations and calculations run strictly inside your browser memory. No responses, scores, or company parameters are transmitted to any server or database.
      </p>
    </div>
  </section>

  <!-- Tool -->
  <section class="px-4 py-4 md:px-8">
    <div class="mx-auto max-w-7xl" data-reveal data-reveal-delay="1">
      <div class="soft-shell p-6 md:p-10">
        <div class="mb-10" data-reveal>
          <span class="eyebrow-label text-[#a33a21]">Step-by-Step Assessment</span>
          <h2 class="mt-2 text-2xl md:text-3xl font-black text-[#181511]">Rate your organisation across all four domains.</h2>
          <p class="mt-2 text-sm leading-relaxed text-slate-600 max-w-2xl">
            For each question, select how frequently the described condition applies in your organisation — from Never to Always. Work through all four tabs to generate your full fraud risk profile.
          </p>
        </div>

        <FraudRiskCalculator client:load />
      </div>
    </div>
  </section>

  <!-- Methodology -->
  <section class="px-4 py-8 md:px-8">
    <div class="mx-auto max-w-7xl">
      <div class="soft-shell p-6 md:p-10" data-reveal>
        <div class="max-w-3xl">
          <span class="eyebrow-label text-[#c7964c]">Methodology & Framework</span>
          <h2 class="mt-2 text-2xl md:text-3xl font-black text-[#181511] mb-4">How this assessment works.</h2>
          <p class="text-slate-600 text-sm leading-relaxed mb-4">
            This tool is grounded in two widely recognised frameworks: the <strong>Fraud Triangle</strong> (Cressey, 1953) — which identifies Opportunity, Pressure, and Rationalization as the three conditions enabling fraud — and the <strong>COSO Internal Control Framework</strong>, which adds Control Environment as a fourth dimension reflecting governance and oversight quality.
          </p>
          <p class="text-slate-500 text-xs leading-relaxed mb-10">
            Responses across all 20 questions are averaged into four domain scores (1–5 scale) and evaluated against trained classification thresholds. The model was calibrated on expert-labelled combinations of domain scores using polynomial feature expansion and softmax classification.
          </p>

          <!-- Framework pillars -->
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-10">
            <div class="bg-[#faf8f5] border border-[color:var(--line-soft)] border-t-2 border-t-[#a33a21] p-5 rounded-lg">
              <div class="text-[#a33a21] font-black text-xs uppercase tracking-widest mb-2">Opportunity</div>
              <div class="text-slate-600 text-xs leading-snug">Conditions that allow fraud to occur — weak access controls, poor segregation of duties, or limited oversight.</div>
            </div>
            <div class="bg-[#faf8f5] border border-[color:var(--line-soft)] border-t-2 border-t-[#a33a21] p-5 rounded-lg">
              <div class="text-[#a33a21] font-black text-xs uppercase tracking-widest mb-2">Pressure / Incentive</div>
              <div class="text-slate-600 text-xs leading-snug">Financial or organisational pressures that motivate individuals — aggressive targets, personal hardship, or fear of job loss.</div>
            </div>
            <div class="bg-[#faf8f5] border border-[color:var(--line-soft)] border-t-2 border-t-[#a33a21] p-5 rounded-lg">
              <div class="text-[#a33a21] font-black text-xs uppercase tracking-widest mb-2">Rationalization</div>
              <div class="text-slate-600 text-xs leading-snug">Cultural attitudes that allow individuals to justify dishonest behaviour — perceived unfairness, leniency on violations, or a "bending rules" culture.</div>
            </div>
            <div class="bg-[#faf8f5] border border-[color:var(--line-soft)] border-t-2 border-t-[#a33a21] p-5 rounded-lg">
              <div class="text-[#a33a21] font-black text-xs uppercase tracking-widest mb-2">Control Environment</div>
              <div class="text-slate-600 text-xs leading-snug">Anti-fraud governance strength — tone from the top, whistleblowing channels, fraud training, and detection programmes.</div>
            </div>
          </div>

          <!-- Risk level legend -->
          <h3 class="text-xs font-black text-[#181511] uppercase tracking-widest mb-4">Risk Level Definitions</h3>
          <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-10">
            <div class="bg-[#faf8f5] border border-[color:var(--line-soft)] border-t-2 border-t-emerald-600 p-5 rounded-lg">
              <div class="text-emerald-700 font-black text-xs uppercase tracking-widest mb-2">Low</div>
              <div class="text-slate-600 text-xs leading-snug">Fraud risk is well-controlled. Maintain current controls and monitor on a regular cycle.</div>
            </div>
            <div class="bg-[#faf8f5] border border-[color:var(--line-soft)] border-t-2 border-t-amber-500 p-5 rounded-lg">
              <div class="text-amber-700 font-black text-xs uppercase tracking-widest mb-2">Medium</div>
              <div class="text-slate-600 text-xs leading-snug">Elevated risk in one or more areas. A targeted remediation plan with agreed timelines is warranted.</div>
            </div>
            <div class="bg-[#faf8f5] border border-[color:var(--line-soft)] border-t-2 border-t-orange-600 p-5 rounded-lg">
              <div class="text-orange-700 font-black text-xs uppercase tracking-widest mb-2">High</div>
              <div class="text-slate-600 text-xs leading-snug">Significant fraud risk exposure. Escalate to senior management and initiate root cause remediation.</div>
            </div>
            <div class="bg-[#faf8f5] border border-[color:var(--line-soft)] border-t-2 border-t-rose-700 p-5 rounded-lg">
              <div class="text-rose-700 font-black text-xs uppercase tracking-widest mb-2">Critical</div>
              <div class="text-slate-600 text-xs leading-snug">Severe, systemic fraud risk. Immediate Board or Audit Committee notification and intervention required.</div>
            </div>
          </div>

          <!-- Scoring guide -->
          <div class="border border-[color:var(--line-soft)] rounded-lg overflow-hidden mb-8">
            <table class="w-full text-xs">
              <thead>
                <tr class="bg-[#181511] text-white">
                  <th class="text-left px-5 py-3.5 font-black uppercase tracking-widest text-[10px]">Rating</th>
                  <th class="text-left px-5 py-3.5 font-black uppercase tracking-widest text-[10px]">Meaning</th>
                  <th class="text-left px-5 py-3.5 font-black uppercase tracking-widest text-[10px]">Domain Score Implication</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-slate-200 bg-white">
                {[
                  ['Never (1)', 'The condition does not exist in your organisation.', 'Contributes to a Low domain score'],
                  ['Rarely (2)', 'Occurs only in exceptional circumstances.', 'Contributes to a Low–Medium score'],
                  ['Sometimes (3)', 'Occurs periodically and is not consistently managed.', 'Contributes to a Medium score'],
                  ['Often (4)', 'A recurring condition without reliable mitigation.', 'Contributes to a High score'],
                  ['Always (5)', 'A persistent, unmitigated condition.', 'Contributes to a Critical score'],
                ].map(([rating, meaning, implication]) => (
                  <tr class="hover:bg-slate-50 transition-colors">
                    <td class="px-5 py-3.5 font-black text-slate-900">{rating}</td>
                    <td class="px-5 py-3.5 text-slate-600">{meaning}</td>
                    <td class="px-5 py-3.5 text-slate-500">{implication}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Next Steps CTA -->
  <section class="px-4 py-8 pb-20 md:px-8">
    <div class="editorial-panel mx-auto max-w-7xl px-6 py-12 text-center" data-reveal>
      <h2 class="text-3xl font-black text-white mb-4">Scored High or Critical?</h2>
      <p class="text-white/70 mb-8 max-w-2xl mx-auto text-sm leading-relaxed">
        An elevated score indicates structural vulnerabilities that standard sampling easily overlooks. Let's discuss an independent forensic review before exposure crystallizes into cash leakage.
      </p>
      <a href={`${base}contact/`} class="btn-primary">
        Discuss a Remediation Mandate
      </a>
    </div>
  </section>

</BaseLayout>
