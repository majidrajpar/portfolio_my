---
import BaseLayout from '../../layouts/BaseLayout.astro';
import FraudRiskCalculator from '../../components/FraudRiskCalculator.jsx';
const base = import.meta.env.BASE_URL;

const title = "Fraud Risk Calculator & Assessment Tool | COSO & Fraud Triangle | Majid Mumtaz";
const description = "Interactive fraud risk assessment calculator based on Cressey's Fraud Triangle and COSO internal control framework. Score Opportunity, Pressure, Rationalization, and Control Environment.";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": "Fraud Risk Assessment Calculator",
  "operatingSystem": "Web Browser",
  "applicationCategory": "BusinessApplication",
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  },
  "description": "Interactive fraud risk assessment calculator based on Cressey's Fraud Triangle and the COSO internal control framework."
};
---

<BaseLayout title={title} description={description}>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />

  <section class="border-b border-slate-200 bg-white px-4 pt-28 pb-10 md:px-8">
    <div class="mx-auto max-w-6xl">
      <a href={`${base}tools/`} class="text-sm font-semibold text-slate-900 underline underline-offset-4">All tools</a>
      <h1 class="mt-4 max-w-3xl text-4xl font-semibold tracking-tight text-slate-900 sm:text-5xl">Fraud Risk Calculator</h1>
      <p class="mt-5 max-w-2xl text-base leading-relaxed text-slate-600">Answer 20 questions across the four fraud-risk domains.</p>
    </div>
  </section>

  <section class="bg-white px-4 py-10 md:px-8">
    <div class="mx-auto max-w-6xl rounded-lg border border-slate-200 p-6 md:p-10">
      <FraudRiskCalculator client:load />
    </div>
  </section>
</BaseLayout>
