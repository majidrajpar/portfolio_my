---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AuditSampleSizeCalculator from '../../components/AuditSampleSizeCalculator';
const base = import.meta.env.BASE_URL;

const title = "Audit Sample Size Calculator | AICPA Attribute Sampling & FPC | Majid Mumtaz";
const description = "Statistically defensible audit sample size calculator for internal auditors, SOX 404, and external audit teams. Uses AICPA AU-C 530 attribute sampling with Finite Population Correction (FPC).";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": "Audit Sample Size & Precision Sizer",
  "operatingSystem": "Web Browser",
  "applicationCategory": "BusinessApplication",
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  },
  "description": "Interactive AICPA AU-C 530 and IIA attribute sampling calculator with Finite Population Correction (FPC) for testing internal controls over financial reporting (ICOFR/SOX)."
};
---

<BaseLayout title={title} description={description}>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />

  <section class="border-b border-slate-200 bg-white px-4 pt-28 pb-10 md:px-8">
    <div class="mx-auto max-w-6xl">
      <a href={`${base}tools/`} class="text-sm font-semibold text-slate-900 underline underline-offset-4">All tools</a>
      <h1 class="mt-4 max-w-3xl text-4xl font-semibold tracking-tight text-slate-900 sm:text-5xl">Audit Sample Size & Precision Sizer</h1>
      <p class="mt-5 max-w-2xl text-base leading-relaxed text-slate-600">Calculate an attribute sample size with finite population correction.</p>
    </div>
  </section>

  <section class="bg-white px-4 py-10 md:px-8">
    <div class="mx-auto max-w-6xl rounded-lg border border-slate-200 p-6 md:p-10">
      <AuditSampleSizeCalculator client:load />
    </div>
  </section>
</BaseLayout>
