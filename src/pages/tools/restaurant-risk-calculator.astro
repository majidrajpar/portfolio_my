---
import BaseLayout from '../../layouts/BaseLayout.astro';
import GCCRestaurantExposureCalculator from '../../components/GCCRestaurantExposureCalculator';
import NetworkCanvas from '../../components/NetworkCanvas';
const base = import.meta.env.BASE_URL;

const title = "GCC Restaurant Risk & Working Capital Exposure Calculator | Majid Mumtaz";
const description = "Quantitative tail-risk engine modeling correlated operational shocks, Gaussian copula VaR-95/CVaR-95 EBITDA loss, aggregator deduction leakage, and 52-week liquidity PDC default runway.";
---

<BaseLayout title={title} description={description}>
  <!-- Hero -->
  <section class="relative overflow-hidden px-4 pt-24 md:px-8 md:pt-28">
    <div class="editorial-panel relative mx-auto max-w-7xl overflow-hidden px-6 py-10 md:px-10 md:py-12">
      <NetworkCanvas client:load nodeCount={35} />
      <div class="relative z-10 max-w-4xl" data-reveal>
        <a href={`${base}tools/`} class="mb-7 inline-flex text-[11px] font-black uppercase tracking-[0.28em] text-white/58 transition-colors hover:text-white">
          &larr; Back to Tools
        </a>
        <span class="hero-chip mb-6 md:mb-7">Enterprise Risk & Operational Resilience</span>
        <h1 class="headline-display max-w-4xl text-[clamp(2.6rem,5.5vw,4.8rem)] font-black text-white">
          GCC Restaurant Risk &
          <span class="block text-[#f4c98b]">Working Capital Calculator.</span>
        </h1>
        <p class="mt-6 max-w-3xl text-[15px] leading-7 text-white/74 md:mt-8 md:text-[1.08rem] md:leading-9">
          Model non-linear tail-risk across multi-unit food service portfolios. Quantify joint exposures from municipal cold-chain sweeps, delivery platform take-rate creep, Red Sea customs shelf-life rejections, and 52-week post-dated cheque (PDC) default liquidity collisions.
        </p>
      </div>
    </div>
  </section>

  <!-- Privacy & On-Device Engine Banner -->
  <section class="px-4 py-5 md:px-8">
    <div class="soft-shell mx-auto flex max-w-7xl items-start gap-3 px-5 py-5 md:px-7" data-reveal>
      <svg class="mt-0.5 h-4 w-4 flex-shrink-0 text-[#c7964c]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
      </svg>
      <p class="text-sm leading-7 text-[color:var(--text-secondary)]">
        <span class="meta-label text-[#181511]">100% Client-Side Computation</span>
        The Multivariate Gaussian Copula and 52-week cash-flow simulation run entirely inside your browser sandbox using Cholesky decomposition. Zero operational numbers, revenues, or cash balances leave your device.
      </p>
    </div>
  </section>

  <section class="px-4 md:px-8">
    <p class="mx-auto max-w-7xl text-sm leading-7 text-[color:var(--text-secondary)]">
      Multi-unit food service risk quantification architecture modeling 5 correlated operational shocks (Balady / ADAFSA municipal sweeps, extreme summer chiller lockouts, port customs shelf-life rejections, aggregator deduction creep, and Qiwa supervisory localization) paired with a 52-week post-dated cheque liquidity stress test.
    </p>
  </section>

  <!-- Interactive Quantitative Tool -->
  <section class="px-4 py-6 pb-20 md:px-8">
    <div class="mx-auto max-w-7xl" data-reveal data-reveal-delay="1">
      <div class="soft-shell p-6 md:p-10">
        <GCCRestaurantExposureCalculator client:load />
      </div>
    </div>
  </section>
</BaseLayout>
