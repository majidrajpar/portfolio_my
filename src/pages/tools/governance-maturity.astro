---
import BaseLayout from '../../layouts/BaseLayout.astro';
import GovernanceMaturity from '../../components/GovernanceMaturity.jsx';
const base = import.meta.env.BASE_URL;
---

<BaseLayout
  title="Governance Maturity Assessment | Majid Mumtaz"
  description="Assess your organisation's governance maturity across six domains — Board & Leadership, Risk Management, Internal Controls, Ethics, Compliance, and Reporting — using a COSO and King IV aligned five-level model."
>
  <section class="border-b border-slate-200 bg-white px-4 pt-28 pb-10 md:px-8">
    <div class="mx-auto max-w-6xl">
      <a href={`${base}tools/`} class="text-sm font-semibold text-slate-900 underline underline-offset-4">All tools</a>
      <h1 class="mt-4 max-w-3xl text-4xl font-semibold tracking-tight text-slate-900 sm:text-5xl">Governance Maturity</h1>
      <p class="mt-5 max-w-2xl text-base leading-relaxed text-slate-600">Score 30 statements across six governance domains.</p>
    </div>
  </section>

  <section class="bg-white px-4 py-10 md:px-8">
    <div class="mx-auto max-w-6xl rounded-lg border border-slate-200 p-6 md:p-10">
      <GovernanceMaturity client:load />
    </div>
  </section>
</BaseLayout>
