---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AgenticAuditSimulator from '../../components/AgenticAuditSimulator';

const title = "Agentic Audit Simulator | Majid Mumtaz";
const description = "Autonomous multi-agent risk detection simulation. See how AI swarms analyze and escalate audit findings.";
---

<BaseLayout title={title} description={description}>
  <div class="pt-24 pb-16 px-4 md:px-8 max-w-7xl mx-auto">
    <div class="mb-10" data-reveal>
      <a href="/portfolio_my/tools/" class="text-[10px] font-black uppercase tracking-[0.2em] text-white/50 hover:text-white transition-colors flex items-center gap-2 mb-6">
        &larr; Back to Tools
      </a>
      <h1 class="text-4xl md:text-5xl font-black text-white tracking-tight mb-4">Agentic Audit Simulator</h1>
      <p class="text-slate-400 max-w-2xl text-lg">Watch a simulated swarm of specialized AI agents (Risk Assessor, Forensic Analyst, and Chief Audit Executive) autonomously triage and investigate risk scenarios in real-time.</p>
    </div>
    
    <div class="mt-12" data-reveal data-reveal-delay="1">
      <AgenticAuditSimulator client:load />
    </div>
  </div>
</BaseLayout>
