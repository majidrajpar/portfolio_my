---
import BaseLayout from '../../layouts/BaseLayout.astro';
import RiskMatrix from '../../components/RiskMatrix.jsx';
import NetworkCanvas from '../../components/NetworkCanvas';
const base = import.meta.env.BASE_URL;
---

<BaseLayout
  title="Risk Assessment Matrix Builder | Majid Mumtaz"
  description="Build and visualise a risk matrix by plotting organisational risks on a colour-coded likelihood × impact grid. Free, browser-based — no data stored."
>
  <section class="relative overflow-hidden px-4 pt-24 md:px-8 md:pt-28">
    <div class="editorial-panel relative mx-auto max-w-7xl overflow-hidden px-6 py-10 md:px-10 md:py-12">
      <NetworkCanvas client:load nodeCount={35} />
      <div class="relative z-10 max-w-4xl" data-reveal>
        <a href={`${base}tools/`} class="mb-7 inline-flex text-[11px] font-black uppercase tracking-[0.28em] text-white/58 transition-colors hover:text-white">
          &larr; Back to Tools
        </a>
        <span class="hero-chip mb-6 md:mb-7">Enterprise Risk Management</span>
        <h1 class="headline-display max-w-4xl text-[clamp(2.8rem,6vw,5rem)] font-black text-white">
          Risk Assessment
          <span class="block text-[#f4c98b]">Matrix Builder.</span>
        </h1>
        <p class="mt-6 max-w-3xl text-[15px] leading-7 text-white/74 md:mt-8 md:text-[1.08rem] md:leading-9">
          Plot organisational exposures on a calibrated 5&times;5 Likelihood &times; Impact matrix. Export formatted risk registers structured for executive risk committees and board audit oversight.
        </p>
      </div>
    </div>
  </section>

  <section class="px-4 py-5 md:px-8">
    <div class="soft-shell mx-auto flex max-w-7xl items-start gap-3 px-5 py-5 md:px-7" data-reveal>
      <svg class="mt-0.5 h-4 w-4 flex-shrink-0 text-[#c7964c]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
      </svg>
      <p class="text-sm leading-7 text-[color:var(--text-secondary)]">
        <span class="meta-label text-[#181511]">100% In-Memory Privacy</span>
        Risk names, ratings, and matrix plots exist solely in your local browser runtime. Zero data is transmitted or retained.
      </p>
    </div>
  </section>

  <section class="px-4 py-4 pb-16 md:px-8">
    <div class="mx-auto max-w-7xl" data-reveal data-reveal-delay="1">
      <div class="soft-shell p-6 md:p-10 mb-8">
        <div class="mb-8">
          <span class="eyebrow-label">Interactive Matrix</span>
          <h2 class="mt-3 text-2xl md:text-3xl font-black text-[#181511]">Plot and rank risks.</h2>
          <p class="mt-2 text-sm text-[color:var(--text-secondary)]">Assign likelihood (1–5) and impact (1–5) to visualize enterprise risk density in real time.</p>
        </div>
        <RiskMatrix client:load />
      </div>

      <div class="soft-shell p-6 md:p-10">
        <span class="eyebrow-label">Methodology & Severity Bands</span>
        <h3 class="mt-3 text-2xl font-black text-[#181511] mb-6">5&times;5 Composite scoring scale.</h3>
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
          {[
            { label: 'Low', range: '1–4', color: 'border-t-emerald-600', text: 'text-emerald-700', desc: 'Managed within routine line operational controls.' },
            { label: 'Medium', range: '5–9', color: 'border-t-amber-500', text: 'text-amber-700', desc: 'Formal action plan with defined remediation ownership.' },
            { label: 'High', range: '10–16', color: 'border-t-orange-500', text: 'text-orange-700', desc: 'Immediate executive escalation and dedicated controls.' },
            { label: 'Critical', range: '17–25', color: 'border-t-rose-600', text: 'text-rose-700', desc: 'Board & Audit Committee priority intervention.' },
          ].map(({ label, range, color, text, desc }) => (
            <div class={`stat-plinth p-5 border-t-2 ${color}`}>
              <div class={`font-black text-xs uppercase tracking-widest mb-1 ${text}`}>{label}</div>
              <div class="text-[10px] font-bold text-slate-400 mb-2">Score {range}</div>
              <div class="text-xs leading-snug text-[color:var(--text-secondary)]">{desc}</div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
