---
import BaseLayout from '../../layouts/BaseLayout.astro';
import InternalControlEvaluator from '../../components/InternalControlEvaluator.jsx';
const base = import.meta.env.BASE_URL;

const title = "COSO 2013 Internal Control Evaluator & ICOFR Assessment | Majid Mumtaz";
const description = "Interactive internal controls evaluator based on COSO 2013 17 principles. Assess Control Environment, Risk Assessment, Control Activities, Information & Communication, and Monitoring.";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": "COSO 2013 Internal Control Evaluator",
  "operatingSystem": "Web Browser",
  "applicationCategory": "BusinessApplication",
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  },
  "description": "Interactive internal control diagnostic assessing organizations against the 5 components and 17 principles of the COSO 2013 Internal Control - Integrated Framework."
};
---

<BaseLayout title={title} description={description}>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />

  <section class="border-b border-slate-200 bg-white px-4 pt-28 pb-10 md:px-8">
    <div class="mx-auto max-w-6xl">
      <a href={`${base}tools/`} class="text-sm font-semibold text-slate-900 underline underline-offset-4">All tools</a>
      <h1 class="mt-4 max-w-3xl text-4xl font-semibold tracking-tight text-slate-900 sm:text-5xl">Internal Control Evaluator</h1>
      <p class="mt-5 max-w-2xl text-base leading-relaxed text-slate-600">Rate each COSO principle on a 1–5 scale.</p>
    </div>
  </section>

  <section class="bg-white px-4 py-10 md:px-8">
    <div class="mx-auto max-w-6xl rounded-lg border border-slate-200 p-6 md:p-10">
      <InternalControlEvaluator client:load />
    </div>
  </section>
</BaseLayout>
