---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ComplianceDashboard from '../../components/ComplianceDashboard.jsx';
import NetworkCanvas from '../../components/NetworkCanvas';
const base = import.meta.env.BASE_URL;
---

<BaseLayout
  title="Compliance Dashboard | Majid Mumtaz"
  description="Monitor adherence across SOX, PDPL, ISO 27001, UAE SCA, and COSO ERM frameworks. Weighted scoring and radar chart give instant compliance posture visibility."
>
  <section class="relative overflow-hidden px-4 pt-24 md:px-8 md:pt-28">
    <div class="editorial-panel relative mx-auto max-w-7xl overflow-hidden px-6 py-10 md:px-10 md:py-12">
      <NetworkCanvas client:load nodeCount={35} />
      <div class="relative z-10 max-w-4xl" data-reveal>
        <a href={`${base}tools/`} class="mb-7 inline-flex text-[11px] font-black uppercase tracking-[0.28em] text-white/58 transition-colors hover:text-white">
          &larr; Back to Tools
        </a>
        <span class="hero-chip mb-6 md:mb-7">Regulatory Compliance</span>
        <h1 class="headline-display max-w-4xl text-[clamp(2.8rem,6vw,5rem)] font-black text-white">
          Multi-Framework
          <span class="block text-[#f4c98b]">Compliance Posture.</span>
        </h1>
        <p class="mt-6 max-w-3xl text-[15px] leading-7 text-white/74 md:mt-8 md:text-[1.08rem] md:leading-9">
          Select the regulatory frameworks relevant to your organization, rate control adherence across operational domains, and generate a board-ready compliance posture review.
        </p>
      </div>
    </div>
  </section>

  <section class="px-4 py-5 md:px-8">
    <div class="soft-shell mx-auto flex max-w-7xl items-start gap-3 px-5 py-5 md:px-7" data-reveal>
      <svg class="mt-0.5 h-4 w-4 flex-shrink-0 text-[#c7964c]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
      </svg>
      <p class="text-sm leading-7 text-[color:var(--text-secondary)]">
        <span class="meta-label text-[#181511]">Confidential Self-Assessment</span>
        Operates entirely inside your browser. No framework selections, control ratings, or scores are transmitted to external servers.
      </p>
    </div>
  </section>

  <section class="px-4 py-4 pb-16 md:px-8">
    <div class="mx-auto max-w-7xl" data-reveal data-reveal-delay="1">
      <div class="soft-shell p-6 md:p-10 mb-8">
        <div class="mb-8">
          <span class="eyebrow-label">Framework Assessment</span>
          <h2 class="mt-3 text-2xl md:text-3xl font-black text-[#181511]">Score each control area.</h2>
          <p class="mt-2 text-sm text-[color:var(--text-secondary)]">Rate adherence on a 0–100% scale to pinpoint compliance deficits across active frameworks.</p>
        </div>
        <ComplianceDashboard client:load />
      </div>

      <div class="soft-shell p-6 md:p-10">
        <span class="eyebrow-label">Methodology & Frameworks</span>
        <h3 class="mt-3 text-2xl font-black text-[#181511] mb-6">Coverage standards.</h3>
        <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
          {[
            { name: 'SOX / ICFR', scope: 'US-listed entities & subsidiaries. Section 302 & 404 management assessments.' },
            { name: 'UAE / KSA PDPL', scope: 'Personal Data Protection Law across UAE and Saudi Arabia.' },
            { name: 'ISO 27001', scope: 'Information security management systems and data access governance.' },
            { name: 'UAE SCA Governance', scope: 'Securities and Commodities Authority corporate governance code.' },
            { name: 'COSO ERM 2017', scope: 'Enterprise Risk Management integrating with strategy and execution.' },
          ].map(({ name, scope }) => (
            <div class="stat-plinth p-5">
              <div class="meta-label text-[#a33a21]">{name}</div>
              <p class="mt-2 text-xs leading-relaxed text-[color:var(--text-secondary)]">{scope}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
