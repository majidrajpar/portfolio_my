---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ChartCreator from '../../components/ChartCreator.jsx';
import NetworkCanvas from '../../components/NetworkCanvas';
const base = import.meta.env.BASE_URL;
---

<BaseLayout
  title="Chart & Visual Reporting Tool | Majid Mumtaz"
  description="Design bar, line, pie, and radar charts for audit reports and governance presentations. Live preview and themes designed for boardroom communication."
>
  <section class="relative overflow-hidden px-4 pt-24 md:px-8 md:pt-28">
    <div class="editorial-panel relative mx-auto max-w-7xl overflow-hidden px-6 py-10 md:px-10 md:py-12">
      <NetworkCanvas client:load nodeCount={35} />
      <div class="relative z-10 max-w-4xl" data-reveal>
        <a href={`${base}tools/`} class="mb-7 inline-flex text-[11px] font-black uppercase tracking-[0.28em] text-white/58 transition-colors hover:text-white">
          &larr; Back to Tools
        </a>
        <span class="hero-chip mb-6 md:mb-7">Executive Reporting</span>
        <h1 class="headline-display max-w-4xl text-[clamp(2.8rem,6vw,5rem)] font-black text-white">
          Audit Visual
          <span class="block text-[#f4c98b]">Reporting Builder.</span>
        </h1>
        <p class="mt-6 max-w-3xl text-[15px] leading-7 text-white/74 md:mt-8 md:text-[1.08rem] md:leading-9">
          Construct calibrated data visualizations for audit committees and executive packs. Generates bar, line, pie, and radar profiles formatted for executive clarity.
        </p>
      </div>
    </div>
  </section>

  <section class="px-4 py-5 md:px-8">
    <div class="soft-shell mx-auto flex max-w-7xl items-start gap-3 px-5 py-5 md:px-7" data-reveal>
      <svg class="mt-0.5 h-4 w-4 flex-shrink-0 text-[#c7964c]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
      </svg>
      <p class="text-sm leading-7 text-[color:var(--text-secondary)]">
        <span class="meta-label text-[#181511]">Client-Side Confidentiality</span>
        Chart parameters and data tables render in local memory. No figures are stored or sent externally.
      </p>
    </div>
  </section>

  <section class="px-4 py-4 pb-16 md:px-8">
    <div class="mx-auto max-w-7xl" data-reveal data-reveal-delay="1">
      <div class="soft-shell p-6 md:p-10 mb-8">
        <div class="mb-8">
          <span class="eyebrow-label">Chart Generator</span>
          <h2 class="mt-3 text-2xl md:text-3xl font-black text-[#181511]">Configure and preview.</h2>
          <p class="mt-2 text-sm text-[color:var(--text-secondary)]">Enter metrics and labels to preview charts with boardroom-grade contrast.</p>
        </div>
        <ChartCreator client:load />
      </div>

      <div class="soft-shell p-6 md:p-10">
        <span class="eyebrow-label">Visual Guidance</span>
        <h3 class="mt-3 text-2xl font-black text-[#181511] mb-6">Chart selection standard.</h3>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          {[
            { type: 'Bar Chart', best: 'Discrete departmental finding counts, compliance score comparisons.', avoid: 'Long multi-year time series.' },
            { type: 'Line Chart', best: 'Multi-quarter trendlines, fraud incident velocity.', avoid: 'Unordered category comparisons.' },
            { type: 'Pie / Donut', best: 'Proportional budget allocations and finding severity share.', avoid: 'More than 5-6 segments.' },
            { type: 'Radar Chart', best: 'Multi-dimensional COSO component or governance maturity comparison.', avoid: 'Audiences requiring exact axis point readings.' },
          ].map(({ type, best, avoid }) => (
            <div class="stat-plinth p-5">
              <div class="meta-label text-[#a33a21]">{type}</div>
              <p class="mt-2 text-xs text-[color:var(--text-secondary)]"><strong class="text-[#181511]">Best for:</strong> {best}</p>
              <p class="mt-1 text-xs text-[color:var(--text-secondary)]"><strong class="text-rose-700">Avoid when:</strong> {avoid}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
