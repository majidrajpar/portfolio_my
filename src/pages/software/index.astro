---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { software } from '../../data/software.js';
import NetworkCanvas from '../../components/NetworkCanvas';
import GrammarBackground from '../../components/GrammarBackground';
const base = import.meta.env.BASE_URL;

const categoryColors: Record<string, string> = {
  'Fieldwork Workbench': 'bg-[#181512] text-[#f4c98b]',
  'Forensic Analytics':  'bg-[#3a1913] text-[#f1b5a2]',
  'Compliance & Ethics': 'bg-[#17302e] text-[#b7e2db]',
  'Agentic Frameworks':  'bg-[#1f253a] text-[#c8d2f8]',
  'Audit Intelligence':  'bg-[#40250f] text-[#f3cf9b]',
};
---

<BaseLayout
  title="Audit Software & Open Source Workbenches | Majid Mumtaz"
  description="Production-grade open-source audit software, algorithmic triage workbenches, and agentic governance frameworks. Privacy-first, zero-dependency tools built for modern internal audit operations."
>
  <section class="relative overflow-hidden px-4 pt-24 md:px-8 md:pt-28">
    <div class="editorial-panel relative mx-auto max-w-7xl overflow-hidden px-6 py-10 md:px-10 md:py-12">
      <NetworkCanvas client:load nodeCount={35} />
      <div class="relative z-10 grid gap-8 lg:grid-cols-[1.35fr_0.85fr] lg:items-end lg:gap-10">
        <div data-reveal>
          <span class="hero-chip mb-6 sm:mb-8">Engineering & Open-Source</span>
          <h1 class="headline-display max-w-4xl text-[clamp(2.8rem,6vw,5.5rem)] font-black text-white">
            Audit Software
            <span class="block text-[#f4c98b]">& Technical</span>
            <span class="block">Workbenches.</span>
          </h1>
          <p class="mt-6 max-w-3xl text-[15px] leading-7 text-white/74 md:mt-8 md:text-[1.08rem] md:leading-9">
            Production-grade open-source software, automated scanners, and agentic governance architectures. Built with a zero-cloud-egress philosophy to solve structural audit limitations without multi-tenant SaaS security risks.
          </p>
        </div>
        <div class="quote-panel p-6 md:p-8" data-reveal data-reveal-delay="1">
          <span class="eyebrow-label text-[#f4c98b]/80">Engineering Standard</span>
          <div class="mt-4 space-y-4 text-sm leading-7 text-white/72 md:mt-5 md:space-y-5">
            <p>Every codebase is built for institutional sovereignty: self-hosted, modular, and designed to run entirely on-premise or locally on-device.</p>
            <p>No recurring SaaS licenses, zero customer data leakage, and full adherence to global professional standards (IIA, AICPA, COSO).</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="px-4 py-5 md:px-8">
    <div class="soft-shell mx-auto grid max-w-7xl gap-4 px-5 py-5 md:grid-cols-[1.3fr_0.7fr] md:px-7" data-reveal>
      <div class="flex items-start gap-3">
        <svg class="mt-0.5 h-4 w-4 flex-shrink-0 text-[#c7964c]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"/>
        </svg>
        <p class="text-sm leading-7 text-[color:var(--text-secondary)]">
          <span class="meta-label text-[#181511]">Data Sovereignty</span>
          All tools prioritize local execution and zero external telemetry. Confidential ERP data, accounts payable ledgers, and whistleblower disclosures remain strictly within the client enterprise perimeter.
        </p>
      </div>
      <div class="grid gap-3 sm:grid-cols-3 md:gap-4">
        <div class="stat-plinth">
          <span class="meta-label">Codebases</span>
          <strong class="mt-3 block text-3xl leading-none text-[#181511]">{software.length}</strong>
        </div>
        <div class="stat-plinth">
          <span class="meta-label">Open Source</span>
          <strong class="mt-3 block text-3xl leading-none text-[#181511]">{software.filter(s => s.isPublic).length}</strong>
        </div>
        <div class="stat-plinth">
          <span class="meta-label">Data Egress</span>
          <strong class="mt-3 block text-3xl leading-none text-[#059669]">Zero</strong>
        </div>
      </div>
    </div>
  </section>

  <section class="px-4 py-6 md:px-8">
    <div class="mx-auto max-w-7xl">
      <div class="mb-10 flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between" data-reveal>
        <div>
          <span class="eyebrow-label">Systems & Repositories</span>
          <h2 class="mt-4 text-[clamp(2rem,4.6vw,3.8rem)] leading-[1.02] text-[#181511]">Software built for audit operations.</h2>
        </div>
        <p class="body-luxe max-w-2xl">From full-population CAATs engines to self-hosted ethics intake pipelines, these platforms operationalize modern assurance.</p>
      </div>

      <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
        {software.map((item, i) => (
          <div
            key={item.id}
            class={`glass-card flex h-full flex-col rounded-[32px] p-7 md:p-9 transition-all duration-300 ${!item.isPublic ? 'border-dashed bg-slate-50/60' : ''}`}
            data-reveal
            data-reveal-delay={String((i % 2) + 1)}
          >
            {/* Header: Category + Status Badge */}
            <div class="mb-5 flex flex-wrap items-center justify-between gap-3">
              <span class={`inline-flex px-3 py-1 text-[10px] font-black uppercase tracking-[0.2em] rounded-sm ${categoryColors[item.category] ?? 'bg-slate-700 text-white'}`}>
                {item.category}
              </span>
              <span className={`inline-flex rounded-full border px-2.5 py-0.5 text-[9px] font-mono uppercase tracking-wider ${
                item.isPublic
                  ? 'border-[#059669]/30 bg-[#059669]/10 text-[#059669]'
                  : 'border-[#c7964c]/40 bg-[#c7964c]/10 text-[#a66c1c]'
              }`}>
                {item.status}
              </span>
            </div>

            {/* Title & Tagline */}
            <h3 class="text-2xl font-black text-[#181511] tracking-tight">
              {item.name}
            </h3>
            <p class="mt-2 text-sm font-semibold text-[#a33a21] leading-relaxed">
              {item.tagline}
            </p>

            {/* Main Description */}
            <p class="mt-4 text-sm leading-7 text-[color:var(--text-secondary)]">
              {item.description}
            </p>

            {/* Key Features List */}
            <div class="mt-6 border-t border-[color:var(--line-soft)] pt-5 flex-1">
              <span class="meta-label block text-slate-400 mb-3">Key Technical Capabilities</span>
              <ul class="space-y-2.5">
                {item.keyFeatures.map((feat) => (
                  <li key={feat} class="flex items-start gap-2.5 text-xs text-slate-700 leading-relaxed">
                    <span class="mt-1 h-1.5 w-1.5 rounded-full bg-[#c7964c] flex-shrink-0" />
                    <span>{feat}</span>
                  </li>
                ))}
              </ul>
            </div>

            {/* Tech Stack Tags */}
            <div class="mt-6 pt-5 border-t border-[color:var(--line-soft)]">
              <div class="flex flex-wrap gap-1.5 mb-5">
                {item.techStack.map((tech) => (
                  <span key={tech} class="rounded-md border border-slate-200 bg-white/80 px-2 py-0.5 text-[10px] font-mono text-slate-600">
                    {tech}
                  </span>
                ))}
              </div>

              {/* Action Buttons */}
              <div class="flex flex-wrap items-center gap-3">
                {item.isPublic ? (
                  <>
                    <a
                      href={item.githubUrl}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="btn-primary py-2.5 px-5 text-[10px] font-black uppercase tracking-wider inline-flex items-center gap-2"
                    >
                      <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24">
                        <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
                      </svg>
                      View on GitHub
                    </a>
                    {item.internalUrl && (
                      <a
                        href={`${base}${item.internalUrl.replace(/^\//, '')}`}
                        class="rounded-xl border border-slate-300 bg-white px-4 py-2 text-[10px] font-black uppercase tracking-wider text-slate-800 hover:border-[#181511] transition-colors inline-flex items-center gap-1.5"
                      >
                        Explore Platform →
                      </a>
                    )}
                  </>
                ) : (
                  <span class="inline-flex items-center gap-2 rounded-xl border border-slate-200 bg-slate-100 px-4 py-2.5 text-[10px] font-mono text-slate-500 uppercase tracking-wider">
                    <svg class="w-3.5 h-3.5 text-[#c7964c]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
                    </svg>
                    Private Repository · Confidential Client Access
                  </span>
                )}
              </div>
            </div>
          </div>
        ))}
      </div>

      {/* Reciprocal Banner connecting back to interactive browser tools */}
      <div class="soft-shell mt-12 p-8 md:p-10 flex flex-col md:flex-row md:items-center md:justify-between gap-6" data-reveal>
        <div class="max-w-2xl">
          <span class="eyebrow-label text-[#a33a21]">Executive Decision Support</span>
          <h3 class="mt-2 text-2xl md:text-3xl font-black text-[#181511] tracking-tight">
            Browser-Native Calculators & Diagnostics
          </h3>
          <p class="mt-3 text-sm md:text-[15px] leading-relaxed text-[color:var(--text-secondary)]">
            Looking for instant executive evaluation tools? Access our 15 client-side instruments including the <strong>Tadawul Nomu Pre-IPO Readiness Diagnostic</strong>, <strong>Fraud Risk Calculator</strong>, and <strong>Deficiency Exposure Calculator</strong>.
          </p>
        </div>
        <a href={`${base}tools/`} class="btn-primary flex-shrink-0 px-6 py-3 text-[11px] font-black uppercase tracking-wider inline-flex items-center gap-2">
          Launch Browser Tools
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </a>
      </div>
    </div>
  </section>

  <section class="relative overflow-hidden px-4 py-8 pb-12 md:px-8">
    <div class="editorial-panel relative mx-auto max-w-7xl overflow-hidden px-6 py-10 text-center md:px-10 md:py-14">
      <GrammarBackground client:visible variant="dark-grid" />
      <div class="relative z-10" data-reveal>
        <span class="hero-chip mb-5 md:mb-6">Bespoke Engineering</span>
        <h2 class="mx-auto max-w-3xl text-[clamp(2rem,4.4vw,3.8rem)] leading-[1.03] text-white">
          Need custom audit automation or private workbench deployment?
        </h2>
        <p class="mx-auto mt-5 max-w-2xl text-[15px] leading-7 text-white/72 md:mt-6 md:text-base md:leading-8">
          We architect self-hosted audit data pipelines, continuous monitoring engines, and specialized forensic tooling tailored to regional enterprise infrastructure.
        </p>
        <a href={`${base}contact/`} class="btn-primary mt-8 inline-flex">Discuss an Engineering Mandate</a>
      </div>
    </div>
  </section>
</BaseLayout>
