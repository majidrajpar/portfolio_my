---
import BaseLayout from '../../layouts/BaseLayout.astro';
import NetworkCanvas from '../../components/NetworkCanvas';
import EditorialGallery from '../../components/EditorialGallery';
import { infographics } from '../../data/infographics';

const base = import.meta.env.BASE_URL;

const pageTitle = "The Trench Series: Editorial Satire & Operational Telemetry | Majid Mumtaz";
const pageDescription = "Frontline telemetry blueprints, store-level unit economics models, forensic corporate autopsies, and institutional governance satire from The Audit Signal.";
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  activePath={`${base}trench-series/`}
>
  {/* Hero Section */}
  <section class="relative overflow-hidden pt-12 pb-10 md:pt-20 md:pb-16 px-4 md:px-8">
    <div class="absolute inset-0 pointer-events-none opacity-40">
      <NetworkCanvas client:load nodeCount={32} />
    </div>

    <div class="relative mx-auto max-w-7xl">
      <div class="max-w-4xl" data-reveal>
        <span class="eyebrow-label">Visual Fieldwork &amp; Editorial Commentary</span>
        <h1 class="mt-4 text-[clamp(2.4rem,5vw,4.2rem)] font-black leading-[1.02] tracking-tight text-[#181511]">
          The Trench Series: Editorial Satire &amp; Operational Telemetry
        </h1>
        <p class="mt-6 text-base md:text-lg leading-relaxed text-[color:var(--text-secondary)] font-normal max-w-3xl">
          Frontline telemetry blueprints, store-level unit economics models, forensic autopsies, and institutional audit satire from <span class="font-semibold text-[#181511]">The Audit Signal</span>. Testing trench-level transaction reality directly against boardroom compliance fiction.
        </p>

        {/* Executive Meta Bar */}
        <div class="mt-8 flex flex-wrap items-center gap-4 text-xs text-[color:var(--text-secondary)]">
          <div class="inline-flex items-center gap-2 rounded-full border border-[color:var(--line-soft)] bg-white/80 px-4 py-1.5 shadow-sm">
            <span class="h-2 w-2 rounded-full bg-[#10b981]"></span>
            <span class="font-semibold text-[#181511]">{infographics.length} Visual Analyses</span>
          </div>
          <div class="inline-flex items-center gap-2 rounded-full border border-[color:var(--line-soft)] bg-white/80 px-4 py-1.5 shadow-sm">
            <span class="font-medium">Full-Population Telemetry</span>
          </div>
          <div class="inline-flex items-center gap-2 rounded-full border border-[color:var(--line-soft)] bg-white/80 px-4 py-1.5 shadow-sm">
            <span class="font-medium">100% Unlocked Visual Inspection</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* Main Gallery Section */}
  <section class="px-4 py-6 md:px-8 pb-16">
    <div class="soft-shell mx-auto max-w-7xl px-6 py-8 md:px-10 md:py-12">
      <EditorialGallery client:load base={base} />
    </div>
  </section>

  {/* Cross-Link Discovery Panel */}
  <section class="px-4 py-8 md:px-8">
    <div class="mx-auto max-w-7xl grid grid-cols-1 md:grid-cols-3 gap-6">
      <a
        href={`${base}projects/`}
        class="group p-6 rounded-2xl border border-[color:var(--line-soft)] bg-white/70 hover:bg-white hover:shadow-lg transition-all"
      >
        <span class="text-[10px] font-black uppercase tracking-[0.2em] text-[#a66c1c] block mb-2">Ground Truth</span>
        <h3 class="text-base font-bold text-[#181511] group-hover:text-[#8d6035] transition-colors">Case Studies</h3>
        <p class="mt-2 text-xs text-[color:var(--text-secondary)] leading-relaxed">
          Full engagement retrospectives across GCC pre-IPO readiness, F&amp;B post-merger integrations, and continuous audit transformations.
        </p>
      </a>

      <a
        href={`${base}tools/`}
        class="group p-6 rounded-2xl border border-[color:var(--line-soft)] bg-white/70 hover:bg-white hover:shadow-lg transition-all"
      >
        <span class="text-[10px] font-black uppercase tracking-[0.2em] text-[#a66c1c] block mb-2">Execution Layer</span>
        <h3 class="text-base font-bold text-[#181511] group-hover:text-[#8d6035] transition-colors">Interactive Audit Tools</h3>
        <p class="mt-2 text-xs text-[color:var(--text-secondary)] leading-relaxed">
          Browser-based calculators for POS till fraud, cafe inventory costing, deficiency exposures, and sample size verification.
        </p>
      </a>

      <a
        href={`${base}resources/`}
        class="group p-6 rounded-2xl border border-[color:var(--line-soft)] bg-white/70 hover:bg-white hover:shadow-lg transition-all"
      >
        <span class="text-[10px] font-black uppercase tracking-[0.2em] text-[#a66c1c] block mb-2">Documentation</span>
        <h3 class="text-base font-bold text-[#181511] group-hover:text-[#8d6035] transition-colors">Governance Downloads</h3>
        <p class="mt-2 text-xs text-[color:var(--text-secondary)] leading-relaxed">
          35+ unlocked workbooks, Risk Control Matrices (RCMs), GIAS 2024 compliance kits, and commercial suites.
        </p>
      </a>
    </div>
  </section>

  {/* Executive Profile CTA */}
  <section class="px-4 py-6 pb-12 md:px-8">
    <div class="editorial-panel mx-auto flex max-w-7xl flex-col items-start justify-between gap-8 px-7 py-10 md:flex-row md:items-center md:px-10" data-reveal>
      <div>
        <div class="meta-label text-[#f4c98b]">Executive Engagement</div>
        <h2 class="mt-3 text-3xl text-white">Bring continuous telemetry to your board.</h2>
        <p class="mt-3 text-sm leading-8 text-white/68">Advisory briefs, board committee presentations, and continuous controls audits.</p>
      </div>
      <div class="flex flex-wrap items-center gap-4">
        <a href={`${base}contact/`} class="btn-primary">Initiate Confidential Briefing</a>
        <a href={`${base}cv/Majid_Mumtaz_Internal_Audit_GRC.pdf`} download class="btn-secondary-light">Download CV</a>
      </div>
    </div>
  </section>
</BaseLayout>
