---
import BaseLayout from '../layouts/BaseLayout.astro';
import documents from '../data/documents.json';
import NetworkCanvas from '../components/NetworkCanvas';
import RiskAppetiteInfographic from '../components/RiskAppetiteInfographic.astro';
const base = import.meta.env.BASE_URL;

const categories = ['All', ...new Set((documents as any[]).map((d: any) => d.category))];

function fileMeta(filename: string) {
  const name = filename ? filename.toUpperCase() : '';
  if (name.endsWith('.DOCX')) return { unit: 'page', kind: 'WORD' };
  if (name.endsWith('.XLSX')) return { unit: 'sheet', kind: 'EXCEL' };
  if (name.endsWith('.ZIP') || name.endsWith('.EXE')) return { unit: 'bundle', kind: 'WINDOWS APP' };
  return { unit: 'page', kind: 'PDF' };
}
---

<BaseLayout
  title="Resources | Professional Internal Audit Downloads — Majid Mumtaz"
  description="Professional internal audit frameworks, checklists, guides, and tools. Download risk control matrices, fraud prevention guides, SOX implementation guides, and more."
>
  <section class="relative overflow-hidden px-4 pt-24 md:px-8 md:pt-28">
    <div class="editorial-panel relative mx-auto max-w-7xl overflow-hidden px-6 py-10 md:px-10 md:py-12">
      <NetworkCanvas client:load nodeCount={35} />
      <div class="relative z-10 max-w-4xl" data-reveal>
        <span class="hero-chip mb-8">Professional Downloads</span>
        <h1 class="headline-display max-w-4xl text-[clamp(3rem,7vw,6rem)] font-black text-white">
          Resources
          <span class="block text-[#f4c98b]">for practitioners</span>
          <span class="block">demanding usable tools.</span>
        </h1>
        <p class="mt-8 max-w-3xl text-base leading-8 text-white/74 md:text-[1.1rem] md:leading-9">
          Complimentary frameworks, checklists, and execution guides for internal audit professionals. Built for direct deployment, eliminating content padding.
        </p>
      </div>
    </div>
  </section>

  <section class="px-4 py-4 md:px-8">
    <div class="soft-shell mx-auto max-w-7xl overflow-hidden px-7 py-8 md:px-10 md:py-10">
      <RiskAppetiteInfographic />
    </div>
  </section>

  <section class="px-4 py-4 md:px-8">
    <div class="editorial-panel relative mx-auto max-w-7xl overflow-hidden px-7 py-8 md:px-10 md:py-10" data-reveal>
      <div class="relative z-10 flex flex-col gap-6 lg:flex-row lg:items-center lg:justify-between">
        <div class="max-w-3xl">
          <div class="flex items-center gap-3 mb-4">
            <span class="rounded-full bg-[#f4c98b]/20 px-3 py-1 text-[10px] font-black uppercase tracking-[0.2em] text-[#f4c98b]">
              Featured Software Tool
            </span>
            <span class="text-[10px] font-mono uppercase tracking-wider text-white/60">
              v1.0.0 Standalone Executable
            </span>
          </div>
          <h2 class="text-2xl md:text-3xl font-black text-white tracking-tight">
            Invoice Audit Engine
          </h2>
          <p class="mt-2 text-sm font-semibold text-[#f4c98b]">
            Air-gapped 100% continuous controls monitoring & invoice document audit telemetry.
          </p>
          <p class="mt-4 text-sm leading-relaxed text-white/80">
            A standalone on-premise audit utility for accounts payable and procurement teams. Runs 100% locally with zero cloud API dependencies to protect confidential vendor pricing. Extracts printed invoices and thermal till receipts via local OCR, reconciles 3-way line item math, flags VAT billed without a valid TRN, and generates a 5-tab Excel audit register.
          </p>
          <div class="mt-5 flex flex-wrap gap-2 text-[10px] font-mono text-white/70">
            <span class="rounded bg-white/10 px-2.5 py-1">Zero Cloud Egress</span>
            <span class="rounded bg-white/10 px-2.5 py-1">3-Way Math Verification</span>
            <span class="rounded bg-white/10 px-2.5 py-1">TRN Tax Compliance</span>
            <span class="rounded bg-white/10 px-2.5 py-1">No Python Required</span>
          </div>
        </div>
        <div class="flex flex-col sm:flex-row lg:flex-col gap-3 shrink-0">
          <a
            href="https://github.com/majidrajpar/invoice-audit-engine/releases/tag/v1.0.0"
            target="_blank"
            rel="noopener noreferrer"
            class="btn-primary py-3 px-6 text-[11px] font-black uppercase tracking-wider inline-flex items-center justify-center gap-2"
          >
            <svg class="w-4 h-4 fill-current" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M3 17a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zm3.293-7.707a1 1 0 011.414 0L9 10.586V3a1 1 0 112 0v7.586l1.293-1.293a1 1 0 111.414 1.414l-3 3a1 1 0 01-1.414 0l-3-3a1 1 0 010-1.414z" clip-rule="evenodd" />
            </svg>
            Download Windows App (.exe)
          </a>
          <a
            href="https://github.com/majidrajpar/invoice-audit-engine"
            target="_blank"
            rel="noopener noreferrer"
            class="rounded-xl border border-white/20 bg-white/10 px-6 py-3 text-center text-[11px] font-black uppercase tracking-wider text-white hover:bg-white/20 transition-colors inline-flex items-center justify-center gap-2"
          >
            <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
              <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
            </svg>
            Source Code (GitHub)
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="px-4 py-4 md:px-8">
    <div class="mx-auto max-w-7xl">
      <div class="mb-10" data-reveal>
        <span class="eyebrow-label">Resource Library</span>
        <h2 class="mt-4 text-[clamp(2rem,4.5vw,3.8rem)] leading-[1.02] text-[#181511]">Downloadable frameworks and working tools.</h2>
      </div>

      <div class="mb-8 flex flex-wrap gap-2" id="filter-bar">
        {categories.map((cat, idx) => (
          <button
            data-filter={cat}
            class={`filter-btn rounded-full px-4 py-2 text-[10px] font-black uppercase tracking-[0.24em] border transition-all duration-150 ${idx === 0 ? 'bg-[#1d3557] border-[#1d3557] text-white' : 'border-[rgba(29,53,87,0.10)] text-[color:var(--text-secondary)] bg-white/60 hover:border-[#1d3557]/40 hover:text-[#181511]'}`}
          >
            {cat}
          </button>
        ))}
      </div>

      <div class="grid grid-cols-1 gap-5 md:grid-cols-2 lg:grid-cols-3" id="docs-grid">
        {(documents as any[]).map((doc: any, i: number) => (
          <div
            class="glass-card flex flex-col rounded-[30px] p-7"
            data-category={doc.category}
            data-reveal
            data-reveal-delay={String((i % 3) + 1)}
          >
            <div class="flex items-center justify-between gap-4 mb-5">
              <span class="rounded-full bg-[#a33a21]/8 px-3 py-1 text-[10px] font-black uppercase tracking-[0.24em] text-[#a33a21]">
                {doc.category}
              </span>
              <span class="meta-label text-slate-400">{doc.size}</span>
            </div>

            <h3 class="text-xl leading-tight text-[#181511] flex-1">
              {doc.title}
            </h3>

            <p class="mt-4 text-sm leading-8 text-[color:var(--text-secondary)]">
              {doc.description}
            </p>

            <div class="mt-5 flex items-center gap-4 text-[10px] font-black uppercase tracking-[0.22em] text-slate-400">
              <span>{doc.pages} {doc.pages === 1 ? fileMeta(doc.filename).unit : `${fileMeta(doc.filename).unit}s`}</span>
              <span>{fileMeta(doc.filename).kind}</span>
            </div>

            <div class="mt-6 flex flex-wrap items-center gap-3">
              {doc.downloadUrl ? (
                <a
                  href={doc.downloadUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="btn-primary self-start text-[11px] font-black uppercase tracking-wider inline-flex items-center gap-1.5"
                >
                  <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M3 17a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zm3.293-7.707a1 1 0 011.414 0L9 10.586V3a1 1 0 112 0v7.586l1.293-1.293a1 1 0 111.414 1.414l-3 3a1 1 0 01-1.414 0l-3-3a1 1 0 010-1.414z" clip-rule="evenodd" />
                  </svg>
                  Download App (.exe)
                </a>
              ) : (
                <a
                  href={`${base}downloads/${doc.filename}`}
                  download
                  class="btn-secondary self-start"
                >
                  Download
                </a>
              )}
              {doc.link && (
                <a
                  href={doc.link}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="btn-secondary self-start"
                >
                  {doc.linkLabel ?? 'View Original'}
                </a>
              )}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <script is:inline>
    (function () {
      const bar = document.getElementById('filter-bar');
      const grid = document.getElementById('docs-grid');
      if (!bar || !grid) return;

      const cards = Array.from(grid.querySelectorAll('[data-category]'));

      bar.addEventListener('click', function (e) {
        const btn = e.target.closest('.filter-btn');
        if (!btn) return;

        const selected = btn.dataset.filter;

        bar.querySelectorAll('.filter-btn').forEach(function (b) {
          if (b === btn) {
            b.classList.add('bg-[#1d3557]', 'border-[#1d3557]', 'text-white');
            b.classList.remove('text-[color:var(--text-secondary)]', 'bg-white/60');
          } else {
            b.classList.remove('bg-[#1d3557]', 'border-[#1d3557]', 'text-white');
            b.classList.add('text-[color:var(--text-secondary)]', 'bg-white/60');
          }
        });

        cards.forEach(function (card) {
          if (selected === 'All' || card.dataset.category === selected) {
            card.style.display = '';
          } else {
            card.style.display = 'none';
          }
        });
      });
    })();
  </script>

  <section class="px-4 py-4 pb-10 md:px-8">
    <div class="editorial-panel mx-auto flex max-w-7xl flex-col items-start justify-between gap-8 px-7 py-10 md:flex-row md:items-center md:px-10" data-reveal>
      <div>
        <div class="meta-label text-[#f4c98b]">Executive CV</div>
        <h2 class="mt-3 text-3xl text-white">Download the executive profile.</h2>
        <p class="mt-3 text-sm leading-8 text-white/68">Comprehensive credentials, experience, and engagement history.</p>
      </div>
      <a href={`${base}cv/Majid_Mumtaz_Internal_Audit_GRC.pdf`} download class="btn-secondary-light">Download CV</a>
    </div>
  </section>
</BaseLayout>
