---
interface Props {
  badge?: string;
  title: string;
  description: string;
  primaryUrl: string;
  primaryLabel: string;
  secondaryUrl?: string;
  secondaryLabel?: string;
}

const {
  badge = 'Enterprise Production Architecture',
  title,
  description,
  primaryUrl,
  primaryLabel,
  secondaryUrl,
  secondaryLabel,
} = Astro.props;
---

<div class="mt-12 rounded-[28px] border-2 border-[#c7964c] bg-[#181512] p-7 text-white shadow-xl md:p-9" data-reveal>
  <div class="grid gap-6 lg:grid-cols-[1.5fr_0.8fr] lg:items-center">
    <div>
      <div class="flex flex-wrap items-center gap-3">
        <span class="rounded-full bg-[#c7964c]/20 px-3 py-1 text-[10px] font-black uppercase tracking-[0.22em] text-[#f4c98b]">
          {badge}
        </span>
        <span class="font-mono text-xs text-white/60">Unlocked Working Files &middot; Production Governance</span>
      </div>
      <h3 class="mt-4 text-2xl font-black text-white md:text-3xl">
        {title}
      </h3>
      <p class="mt-3 text-sm leading-7 text-white/76">
        {description}
      </p>
    </div>

    <div class="flex flex-col items-start justify-between gap-4 border-t border-white/10 pt-5 lg:items-end lg:border-l lg:border-t-0 lg:pl-8 lg:pt-0">
      <div>
        <div class="text-[10px] font-mono uppercase tracking-widest text-white/55">Commercial License</div>
        <div class="mt-1 text-xs text-white/60">Standard Practitioner &middot; Institutional Advisory</div>
      </div>
      <div class="flex flex-wrap items-center gap-3">
        <a
          href={primaryUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="btn-primary text-xs font-black uppercase tracking-wider"
        >
          {primaryLabel}
        </a>
        {secondaryUrl && (
          <a
            href={secondaryUrl}
            class="btn-secondary-light text-xs font-black uppercase tracking-wider"
          >
            {secondaryLabel ?? 'Full Inventory'}
          </a>
        )}
      </div>
    </div>
  </div>
</div>
